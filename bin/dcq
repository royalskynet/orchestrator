#!/usr/bin/env bash
{ # 整檔包成一個複合指令：bash 先讀完整段才執行，執行中被改寫（git pull、dc 改自己）不會用舊偏移讀到碎片（fix 9499）
# dcq — dc 的並發佇列跑者。工單進，成敗總表出。
#
# 為什麼不是 HTTP 客戶端：Go 的 /zen/go/v1 給的是推理，不是 agent。要改檔案的派工
# 仍得跑 opencode 的 agentic loop，所以並發＝開 N 個 dc 進程，不是開 N 條 HTTP 連線。
# Go 的價值在模型那一側（∞ 免費額度、不吃 free-tier 閘、更穩），設 DCQ_MODELS 即可用。
#
# 不自造的部分（照抄本機既有前案，避免雙抄漂移）：
#   佇列骨架  = wo-runner 的 pending/→running/→done|failed/ 檔案系統狀態機
#   准入閘    = dc 自己的 deep-lint + wo-verify --dry（dcq add 只是提前跑一次）
#   成敗判定  = dc 的 exit code，不另發明狀態機
#
# 自造的三件（並發才需要，既有前案都沒有）：
#   1. slot 分配（wo-runner 是全域單鎖，一次只跑一張）
#   2. per-job cwd 互斥 —— 唯一會讓並發出「錯誤結果」而非只是變慢的項目：
#      opencode 會對工作目錄做 snapshot，wo-verify 的斷言又是相對路徑，
#      兩張工單共用 cwd 會互相汙染（A 的產物讓 B 假過、B 的改動讓 A 假失敗）
#   3. 模型池 + per-model 冷卻／併發槽（借鏡 LiteLLM Router）
#   4. watchdog：.out 停滯與總時限（opencode 的 chunkTimeout 不可靠，見 issue #43519）
set -u
# I5：runner 啟動時記下自己這份檔的 mtime 與原始 argv；worker 每次 claim 前比對，變了就不再收新單，
# 跑完手上的 job 後由 cmd_run exec 自己（新碼）。dc 每張工單由 PATH 重新執行，本來就是新碼，不在此列。
ORIG_ARGS=("$@")
SELF_REAL="$(readlink -f "$0")"
SELF_M0="$(stat -c %Y "$SELF_REAL" 2>/dev/null || stat -f %m "$SELF_REAL" 2>/dev/null || echo 0)"

Q="${DCQ_HOME:-$HOME/.dcq}"
# 2026-10-19 起各層預設名單一律從清冊 catalog/models.tsv 組（第 7 欄 dc_id、第 8 欄 fit），不再寫死在這裡；
# 下面歷史註解裡的名單只是當時的實測紀錄。DCQ_POOL_* 有設的照舊整條覆寫。
CAT="${DCQ_CATALOG:-$(dirname "$(readlink -f "$0")")/../catalog}"
# $1=billing（free／sub／api）$2=zen（dc_id 無斜線）／slash（有斜線）；依清冊列序印 dc_id
cat_pool() {
  [ -r "$CAT/models.tsv" ] || return 0
  awk -F'\t' -v b="$1" -v k="$2" '!/^#/ && $1==b && $7!="" { z=(index($7,"/")==0); if ((k=="zen")==z) printf "%s%s", (n++ ? " " : ""), $7 }' "$CAT/models.tsv"
}
# fit=easy＝hard 工單不派（改錯、假扮工具、無限迴圈、隨機分配的前科）
EASY_ONLY="${DCQ_EASY_ONLY-$( [ -r "$CAT/models.tsv" ] && awk -F'\t' '!/^#/ && $7!="" && $8=="easy" { printf "%s%s", (n++ ? " " : ""), $7 }' "$CAT/models.tsv")}"
# fit=easy-only＝只派 easy 工單，mid／hard 都不派（2026-10-22：or-free 23 跑 1 過、失敗白等 11262s，mid 工單照樣派到它）
EASY_STRICT="${DCQ_EASY_STRICT-$( [ -r "$CAT/models.tsv" ] && awk -F'\t' '!/^#/ && $7!="" && $8=="easy-only" { printf "%s%s", (n++ ? " " : ""), $7 }' "$CAT/models.tsv")}"
EASY_ONLY="${EASY_ONLY}${EASY_STRICT:+${EASY_ONLY:+ }$EASY_STRICT}"
# 模型池：Go 的兩隻限時無限免費（CLI 走 opencode/ 前綴，2026-09-30 實測可用）為主，
# Zen 免費池殿後。訂閱沒了就清空 DCQ_POOL_GO。兩池只是依序串接——「池」的意義在
# 於冷卻與併發上限是 per-model 的，一隻忙或掛不會拖住同池其他隻、更不會停全隊。
# DCQ_MODELS 有設就整條覆寫（舊介面相容）。
# ponytail: 2026-10-03 對調成 space-bunny 先（扣掉本機錯誤與壞驗收後 space-bunny 2/2、無停滯；
# longcat 4/5、1 次 300s 停滯原因未查）。樣本各 <6，累積 20 筆再依通過率與停滯數重排。
POOL_GO="${DCQ_POOL_GO-}"  # 2026-10-19 起 longcat 併進清冊免費層；舊介面保留，有設才串在 ZEN 後
# 2026-10-07 同一張修 bug 工單重測：longcat 30s → nemotron-3-ultra 45s → nemotron-3.5-lightning 151s 過；
# muse-spark-1.3-contributor／mimo-v2.6-flash／big-pickle／space-bunny-free 420s 無產出，移出池。
# （2026-10-14 更正：opencode.db 顯示 10-07 12:00～10-08 02:00 這 4 隻全部 0 輸出 token、同時段 nemotron／longcat 正常，
#   是上游不回（額度／排隊）不是模型壞，移出屬誤判；現在由 zero_output 記 why=upstream 不記模型的帳。）
# ponytail: 移出的幾隻沒有自動回測，要恢復得手動重跑同一張工單再加回來。
# 2026-10-09 同一張 slugify 工單 7 隻並跑（每隻 1 樣本）：space-bunny 20s → longcat 28s → mimo 44s
# → step-5 55s → nemotron-3-ultra 71s → ling-3.1-flash 77s 過；nemotron-3.5-lightning 100s 自稱過但驗收 FAIL。
# step-5／ling 過程中有 "Endpoint is unavailable" 重試。space-bunny／mimo 10-07 的 420s 無產出今天沒重現，加回。
# 排序：真實工單 0 停滯的 nemotron-3-ultra 打頭，其餘依今天秒數；會謊報的 lightning 墊底。
# ponytail: 每隻累積 10 筆真實工單（gaps.tsv）就依停滯率與通過率重排；樣本少，排序只當暫定。
# nemotron-3.5-lightning-free 留在手排裡，但 2026-10-09 起由 RANK_ZERO_N 短路自動墊底
# （5 跑 0 PASS、1 停滯，且有一次自稱完成而驗收 FAIL）。先前是直接從這行移出，改回來的理由：
# 寫死移出的不會自動回測，而短路只是降到懲罰層（免費層之後）——它仍會被試到，7 天沒新樣本還會假釋回免費層。
POOL_ZEN="${DCQ_POOL_ZEN-$(cat_pool free zen)}"
# 2026-10-09 依 gaps.tsv＋runner.log 重排：longcat 20 跑 8 停滯（40%）、PASS 3；nemotron-3-ultra
# 11 跑 0 停滯、PASS 4，最大靜默 153s。longcat 移到整個免費層最後，仍排在付費層之前（免費優先）。
MODELS="${DCQ_MODELS:-$POOL_ZEN${POOL_GO:+ $POOL_GO}}"
# 自動重排免費層（每次 dcq 啟動都算，零 token）：讀 gaps.tsv 每隻最近 RANK_WIN 筆，扣掉 rc=2 與 why=upstream
# （工單契約錯，不算模型的帳）。樣本 ≥RANK_MIN 的才算「合格」：
#   - 停滯率 ≥RANK_STALL_PCT% → 降到懲罰層 POOL_PEN（免費層之後、兜底層之前；2026-10-09 起，原本在免費層最後）
#   - 其餘合格的在「合格者原本占的位置」裡依「每 PASS 一張平均花幾秒」重排（越少越前）：
#     分子＝這些嘗試的總秒數（含卡住、失敗白等的時間），分母＝PASS 數。等待時間和通過率一起算。
#     舊紀錄沒有秒數欄（第 6 欄），用最大靜默秒數代替（偏低，但卡住那筆≈STALL_S，白等的時間有算到）
#   - 樣本不夠的留在手排的位置不動
# 短路（2026-10-09 加）：樣本 ≥RANK_ZERO_N 但 PASS 數為 0 的，不等 RANK_MIN 就直接降級。
# 起因是 nemotron-3.5-lightning 5 跑 0 PASS 還賴在手排第 6 位白等 337s：RANK_MIN=10 的本意是
# 避免小樣本亂排順序，但「連一張都沒過」不需要排序精度就能判定，兩者不衝突。3 是最小的
# 「不像巧合」樣本數；全 0 PASS 的 s/pass 是無限大，所以在 demoted 組內自動墊底。
# DCQ_MODELS 有設、或 DCQ_AUTORANK=0 就不排。
# ponytail: 不分工單難易；簡單工單多的模型會被高估。要更準得記工單大小再加權。
RANK_MIN="${DCQ_RANK_MIN:-10}"; RANK_WIN="${DCQ_RANK_WIN:-30}"; RANK_STALL_PCT="${DCQ_RANK_STALL_PCT:-30}"
RANK_ZERO_N="${DCQ_RANK_ZERO_N:-3}"   # 設 0＝停用短路
RANK_PRIOR_K="${DCQ_RANK_PRIOR_K:-2}"   # 貝氏平滑的虛擬嘗試數；0＝原始 s/pass
# 週探測（oc-probe/：launchd 06:00 的 oc-probe daily 每 7 天跑一次 oc-free-check --tsv）：只用最新一批、且 ≤PROBE_MAX_H 小時。
#   - 探測非 OK → 移到免費層最後（比 zero/demoted 更後；明天探測回 OK 就自己回來）
#   - 樣本不足（manual）的位置裡依探測秒數排序，沒探測資料的排在有資料的後面
# 真實工單的每 PASS 秒數仍是主排序：探測只送「回 ok」，量得到活著與反應快慢，量不到寫碼能力。
PROBE_MAX_H="${DCQ_PROBE_MAX_H:-192}"  # 2026-10-21：探測 10-20 起每 7 天一次，原 36h 讓一週 5 天不採用；改 8 天
# 累犯（zero／demoted）不留在免費層尾巴，而是放進懲罰層 POOL_PEN，排在免費層之後、兜底層之前（2026-10-13 起訂閱層墊底）：
# 免費層有 FREE_ROUNDS 輪重試，累犯留在免費層等於每張工單白等它卡兩次（longcat 471 s/pass）。
# 假釋：最近一筆樣本超過 RANK_PAROLE_D 天就回免費層 manual 位置重給機會——放到訂閱層後面
# 幾乎不會被試到，不假釋就永遠累積不到新樣本翻身。
RANK_PAROLE_D="${DCQ_RANK_PAROLE_D:-7}"
rank_free() {  # $1=手排順序（空白分隔）；$2 mode=table 時印統計表；$3=tier（空＝不分難度）
  local f="$Q/logs/gaps.tsv"; [ -s "$f" ] || f=/dev/null
  local pf="$Q/logs/probe.tsv"; [ -s "$pf" ] || pf=/dev/null
  local cut; cut="$(date -v-"${PROBE_MAX_H}"H +%F_%T 2>/dev/null || date -d "-${PROBE_MAX_H} hours" +%F_%T)"
  local pc; pc="$(date -v-"${RANK_PAROLE_D}"d +%F_%T 2>/dev/null || date -d "-${RANK_PAROLE_D} days" +%F_%T)"
  awk -F'\t' -v order="$1" -v min="$RANK_MIN" -v win="$RANK_WIN" -v sp="$RANK_STALL_PCT" \
      -v zn="$RANK_ZERO_N" -v mode="${2:-order}" -v pf="$pf" -v cut="$cut" -v pc="$pc" -v stall="${STALL_S:-200}" -v tier="${3:-}" -v pk="$RANK_PRIOR_K" '
    # QUOTA＝額度用完（08:00 重置），不是壞，當沒資料
    FILENAME==pf { if ($1>=cut && $4!="QUOTA") { if ($1>pl) pl=$1; PT[$1,$3]=PT[$1,$3] (PT[$1,$3]=="" ? "" : ",") $4 ":" $5 } next }
    # 第 7 欄＝工單難度（2026-10-19 起）：別的難度的紀錄不算；舊紀錄沒有這欄，算進每個難度
    tier!="" && $7!="" && $7!=tier { next }
    $4==0 && $3+0>pgmax { pgmax=$3+0; pgm=$2 }
    { m=$2; LT[m]=$1; k=++cnt[m]; R[m,k]=$4; W[m,k]=$5; D[m,k]=($6!="" ? $6 : $3); if ($4==0) LP[m]=$1 }
    END {
      nm=split(order, L, " ")
      for (i=1; i<=nm; i++) {
        m=L[i]; n=0; p=0; s=0; d=0; st=cnt[m]-win+1; if (st<1) st=1
        for (k=st; k<=cnt[m]; k++) { if (R[m,k]==2 || W[m,k]=="upstream" || W[m,k]=="quota") continue; n++; d+=D[m,k]; if (R[m,k]==0) p++; if (W[m,k]=="stall" || W[m,k]=="slow" || W[m,k]=="spin") s++ }
        N[i]=n; P[i]=p; S[i]=s; DS[i]=d; pr[i]=(n ? p/n : 0); tn+=n; tp+=p; td+=d
      }
      # 貝氏平滑（2026-10-22）：每隻先加 pk 次「全池平均」的虛擬嘗試（平均秒數 mu_d、平均通過率 mu_p），
      # 估計值＝(總秒數＋pk×mu_d)／(PASS 數＋pk×mu_p)。樣本多的幾乎不變，樣本少的往全池平均拉，
      # 12 跑 8 過、71s 的模型才比得過 30 跑 17 過的。全池沒有 PASS 時退回原始 s/pass。
      # 借鏡 LiteLLM latency-based routing 的移動平均＋Beta 先驗；Thompson sampling 仍照 ponytail 延後。
      mu_d=(tn ? td/tn : 0); mu_p=(tn ? tp/tn : 0)
      for (i=1; i<=nm; i++) {
        m=L[i]; n=N[i]; p=P[i]; s=S[i]; d=DS[i]
        if (pk>0 && mu_p>0) sp_[i]=(d+pk*mu_d)/(p+pk*mu_p); else sp_[i]=(p ? d/p : 1e9)
        sc[i]=-sp_[i]   # 分數越大越前：每 PASS 秒數取負
        st_="manual"
        if (zn>0 && n>=zn && p==0) st_="zero"   # 短路：一張都沒過，不等 RANK_MIN
        else if (n>=min) { if (s*100>=sp*n) st_="demoted"; else st_="ranked" }
        if ((st_=="zero" || st_=="demoted") && LT[m]<pc) st_="manual"   # 假釋
        # zero 另放冷宮（兜底層之後、訂閱層之前，2026-10-22 使用者定）：0 PASS 的不該排在會過的免費模型前面
        if (st_=="demoted") dm[++nd]=i; else if (st_=="zero") zz[++nz]=i
        # 探測：同一 model 多 provider 時任一 OK 就算活著，秒數取最小
        ps[i]=""; pok[i]=1e8
        if (pl!="" && (pl,m) in PT) { ps[i]="down"; np=split(PT[pl,m], pp, ",")
          for (z=1; z<=np; z++) { split(pp[z], kv, ":"); if (kv[1]=="OK") { ps[i]="ok"; if (kv[2]+0<pok[i]) pok[i]=kv[2]+0 } } }
        # 探測之後真實工單又 PASS 過＝探測過時（10-19 06:00 整池 403 那批，三天後仍把會過的標 down），以工單為準
        if (ps[i]=="down" && LP[m]>pl) ps[i]="stale"
        # ranked 要等探測判完才進 q：先進 q 再改 probe-down 的話，它會在輸出時佔掉別隻合格者的位置
        #（2026-10-13：nemotron 出現兩次、93% 的 space-bunny 整隻消失）
        if (ps[i]=="down" && st_!="zero" && st_!="demoted") { st_="probe-down"; pd[++npd]=i }
        else if (st_=="manual") mq[++nmq]=i
        else if (st_=="ranked") q[++nq]=i
        tag[i]=st_
      }
      # manual 位置依探測秒數升冪（無資料＝1e8，同分維持手排順序）
      for (a=2; a<=nmq; a++) { x=mq[a]; b2=a-1; while (b2>=1 && pok[mq[b2]]>pok[x]) { mq[b2+1]=mq[b2]; b2-- } mq[b2+1]=x }
      # 平滑開著時（pk>0 且全池有 PASS）：manual 與 ranked 合成一組，一律依 est 升冪。小樣本已被先驗拉回全池平均，
      # 不必再靠手排保護；0 樣本的 est＝全池平均，排在中間＝自然的探索位。同分時維持上面探測秒數排好的順序。
      # 2026-10-22 實例：mid 工單的 deepseek-free（mid 樣本不足、2/10 過）靠手排位置排在 go/beam-free（8/10 過）前面。
      if (pk>0 && mu_p>0) { for (a=1; a<=nmq; a++) q[++nq]=mq[a]; nmq=0; for (i=1; i<=nm; i++) if (tag[i]=="manual") tag[i]="ranked" }
      # 合格者依每 PASS 秒數升冪（同分維持手排順序；插入排序，n 很小）
      for (a=2; a<=nq; a++) { x=q[a]; b=a-1; while (b>=1 && sc[q[b]]<sc[x]) { q[b+1]=q[b]; b-- } q[b+1]=x }
      for (a=2; a<=nd; a++) { x=dm[a]; b=a-1; while (b>=1 && sc[dm[b]]<sc[x]) { dm[b+1]=dm[b]; b-- } dm[b+1]=x }
      out=""; j=0; jm=0
      for (i=1; i<=nm; i++) {
        if (tag[i]=="demoted" || tag[i]=="zero" || tag[i]=="probe-down") continue
        out=out (out?" ":"") (tag[i]=="ranked" ? L[q[++j]] : L[mq[++jm]])
      }
      for (a=1; a<=npd; a++) out=out (out?" ":"") L[pd[a]]
      for (a=2; a<=nz; a++) { x=zz[a]; b=a-1; while (b>=1 && N[zz[b]]>N[x]) { zz[b+1]=zz[b]; b-- } zz[b+1]=x }   # 冷宮裡樣本少的先試
      pen=""; for (a=1; a<=nd; a++) pen=pen (pen?" ":"") L[dm[a]]
      zero=""; for (a=1; a<=nz; a++) zero=zero (zero?" ":"") L[zz[a]]
      if (mode=="table") {
        printf "%-34s %4s %4s %4s %6s %8s %7s  %s\n", "model", "n", "pass", "stall", "pass%", "est", "probe", "狀態"
        for (i=1; i<=nm; i++) printf "%-34s %4d %4d %4d %5.0f%% %8s %7s  %s\n", L[i], N[i], P[i], S[i], pr[i]*100, (sp_[i]<1e9 ? sprintf("%.0f", sp_[i]) : "-"), (ps[i]=="ok" ? sprintf("%.0fs", pok[i]) : (ps[i]=="" ? "-" : ps[i])), tag[i]
        if (pl!="") print "探測批次：" pl
        printf "est＝平滑後每 PASS 秒數（先驗 %s 次，全池平均 %.0fs／次、通過率 %.0f%%）\n", pk, mu_d, mu_p*100
        print "順序：" out
        print "懲罰層（免費層之後）：" pen
        print "冷宮（兜底層之後、訂閱層之前）：" zero
        if (pgmax >= 0.9*stall) printf "⚠ 成功工單最大靜默 %ds（%s）已逼近 STALL_S=%d，門檻可能太緊會誤殺\n", pgmax, pgm, stall
      } else print out "|" pen "|" zero
    }' "$pf" "$f"
}
# 名單同步（每次啟動算，零 token）：官方改名／下架／新上架時免改上面寫死的清單。
# 依據＝probe.tsv 最新一批（≤PROBE_MAX_H）provider=opencode 的列：GONE 移出；OK 但不在清單的接到尾巴，
# 當 manual 進 autorank（探測秒數排位置，0 PASS 短路自動進懲罰層）。改名＝舊名 GONE＋新名 OK，兩條規則一起處理。
# POOL_SKIP：刻意不收的免費模型（預設空）。big-pickle／muse-spark 10-07 曾 420s 無產出移出，
# 2026-10-14 CLI 實打 4s／3s 回 ok，依使用者裁決收回；寫碼品質交給 autorank 的 0 PASS 短路判。
# DCQ_MODELS 有設或 DCQ_POOLSYNC=0 不同步；`dcq rank` 印這次增刪。
POOL_SKIP="${DCQ_POOL_SKIP-}"
pool_sync_zen() {  # $1=清單；印「新清單|新增|移出」
  local pf="$Q/logs/probe.tsv"; [ -s "$pf" ] || { echo "$1||"; return; }
  local cut; cut="$(date -v-"${PROBE_MAX_H}"H +%F_%T 2>/dev/null || date -d "-${PROBE_MAX_H} hours" +%F_%T)"
  # x-pool.tsv（oc-probe x 從 @opencode 推文讀出的改名／上下架）：比最新探測批次新的列蓋過探測結果。
  # Zen 閘鎖住時探測整輪跳過，官方公告的改名只能靠這份進名單（10-20 space-bunny 事件）。
  local xf="$Q/logs/x-pool.tsv"; [ -s "$xf" ] || xf=/dev/null
  awk -F'\t' -v order="$1" -v skip="$POOL_SKIP" -v cut="$cut" -v xf="$xf" '
    FILENAME==xf { if ($1>pl) XA[++nx]=$3 "\t" $4; next }
    $1>=cut && $2=="opencode" { if ($1>pl) { pl=$1; nk=0; split("", S) } if ($1==pl) { if (!($3 in S)) K[++nk]=$3; S[$3]=$4 } }
    END {
      for (j=1; j<=nx; j++) { split(XA[j], xa, "\t"); if (xa[1]=="GONE") S[xa[2]]="GONE"; else { if (!(xa[2] in S)) K[++nk]=xa[2]; S[xa[2]]="OK" } }
      n=split(order, L, " "); split(skip, X, " "); for (i in X) sk[X[i]]=1
      for (i=1; i<=n; i++) { in_[L[i]]=1; if (S[L[i]]=="GONE") rm=rm (rm?" ":"") L[i]; else out=out (out?" ":"") L[i] }
      for (k=1; k<=nk; k++) { m=K[k]; if (S[m]=="OK" && !(m in in_) && !(m in sk)) { out=out (out?" ":"") m; add=add (add?" ":"") m } }
      print out "|" add "|" rm
    }' "$pf" "$xf"
}
SYNC_NOTE="" SYNC_ADD_ZEN="" SYNC_ADD_SUB="" SYNC_ADD_GOFREE="" SYNC_RM=""   # 後四個給 sync-catalog 回寫清冊
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_POOLSYNC:-1}" != 0 ]; then
  _s="$(pool_sync_zen "$MODELS")"; [ -z "${_s%%|*}" ] || MODELS="${_s%%|*}"; _s="${_s#*|}"   # 全移光就維持原清單
  [ -z "${_s%%|*}" ] || SYNC_NOTE="新增 ${_s%%|*}；"; [ -z "${_s#*|}" ] || SYNC_NOTE="${SYNC_NOTE}移出 ${_s#*|}；"
  [ -z "${_s%%|*}" ] || SYNC_ADD_ZEN="${_s%%|*}"; [ -z "${_s#*|}" ] || SYNC_RM="${_s#*|}"
fi
# 權重：免費層優先。只有免費模型整輪試過 FREE_ROUNDS 次都失敗，或免費模型全部在冷卻
# （＝免費掛了），才往下走懲罰層 → 兜底層 → 訂閱層（2026-10-13 起訂閱墊底）。訂閱層只准 opencode-go/（扣 Go 訂閱額度）——
# 走到這層 dc 會發 TG 警示。設空字串＝永不動用訂閱。
# 收錄：Go 額度 per-model 各自計（opencode.ai/docs/go），多放幾隻＝容量相加；跳過與 Zen
# 免費池同底模的（免費版掛了它多半也掛）、額度 <1k/月的（kimi-k3、qwen3.8-max、grok）與慢的
# （gpt-6-luna 114s、hy4 222s）。
# 排序（各組通用）：能正確寫對＞反應快。依 2026-10-03 同一張修 bug 工單實測秒數：
# Zen nemotron-3-ultra 12s → muse 17s → big-pickle（4 次中卡住 1、假扮工具 1）
# → nemotron-3.5-lightning（94s 且改錯）→ mimo → free-tools 兜底；
# mimo 實測 28s 過，但社群報真實工單會無限重複 Glob/Read（opencode#50678），有輸出不觸發 stall，只能撞 JOB_MAX，故殿後。
# 付費 glm-5.3-flash 12s → deepseek-v4.1-flash 20s → v4-pro 24s → minimax-m3 27s
# → qwen3.8-flash 28s → kimi-k2.7-code／glm-5.3（未計時，原有的放最後）。
# deepseek-v4-flash 已移除：上游退役只剩轉址（hermes-agent#131254），長 session 必 400（opencode#48093）。
# ponytail: 單一簡單工單、每隻 1 樣本，只分得出快慢和明顯壞的；真實工單累積後再依通過率重排。
# 額度用完的模型會連敗進冷卻，自動跳下一隻，所以排序不必顧額度。
# Claude 層（2026-10-25）：清冊 sub 列裡 dc_id 為 claude/* 的（bin/claude-exec 走 claude -p，Claude 訂閱額度、與主 session 共用）。
# 只在 ORDER=sub（派os）時用，墊在冷宮之後、API 之前；default（派o）與 free（派of）都不派。不進 POOL_PAID：
# go-sync 會把 upstream 沒有的移出訂閱層，且 default 順序也會用到訂閱層。PATH 上沒有 claude 就清空。
_sub="$(cat_pool sub slash)"; POOL_CLAUDE=""; _ps=""
for _m in $_sub; do case "$_m" in claude/*) POOL_CLAUDE="$POOL_CLAUDE${POOL_CLAUDE:+ }$_m" ;; *) _ps="$_ps${_ps:+ }$_m" ;; esac; done
POOL_CLAUDE="${DCQ_POOL_CLAUDE-$POOL_CLAUDE}"; command -v claude >/dev/null || POOL_CLAUDE=""
POOL_PAID="${DCQ_POOL_PAID-$_ps}"
# 訂閱層名單同步：讀 oc-probe/bin/go-sync 每 7 天寫一次的 state（≤8 天才採用；2026-10-21 起週掃，原為每日 ≤48h）。upstream 沒有的移出；
# first_seen 不是 base（＝同步上線後才出現）的非 -free 新模型接到尾巴。上線前就有、刻意沒收的不會被加回。
GO_STATE="${DCQ_GO_STATE:-$HOME/.dcq/logs/go-models.json}"
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_POOLSYNC:-1}" != 0 ] && [ -s "$GO_STATE" ] && command -v jq >/dev/null; then
  _cut="$(date -v-192H +%FT%T 2>/dev/null || date -d '-192 hours' +%FT%T)"
  _s="$(jq -r --arg pool "$POOL_PAID" --arg cut "$_cut" '
    select((.at // "") >= $cut and (.upstream | length) > 0)
    | (.upstream) as $up | (.first_seen // {}) as $fs
    | ($pool | split(" ") | map(select(length > 0))) as $p
    | ($p | map(ltrimstr("opencode-go/") as $m | select(any($up[]; . == $m)) | "opencode-go/" + $m)) as $keep
    | ($p - $keep) as $rm
    | ([$up[] | select(($fs[.] // "base") != "base" and (endswith("-free") | not)) | "opencode-go/" + .] - $p) as $add
    | "\(($keep + $add) | join(" "))|\($add | join(" "))|\($rm | join(" "))"' "$GO_STATE" 2>/dev/null)"
  if [ -n "${_s%%|*}" ]; then
    POOL_PAID="${_s%%|*}"; _s="${_s#*|}"
    [ -z "${_s%%|*}" ] || SYNC_NOTE="${SYNC_NOTE}訂閱新增 ${_s%%|*}；"; [ -z "${_s#*|}" ] || SYNC_NOTE="${SYNC_NOTE}訂閱移出 ${_s#*|}；"
    [ -z "${_s%%|*}" ] || SYNC_ADD_SUB="${_s%%|*}"; [ -z "${_s#*|}" ] || SYNC_RM="${SYNC_RM:+$SYNC_RM }${_s#*|}"
  fi
fi
# 兜底層：免費層與懲罰層用盡才用，排在訂閱層之前（2026-10-13 使用者定：免費的先用完）。免費但品質不穩（or-free 隨機分配 OpenRouter 免費模型；
# agnes 免費帳號常 429，2026-10-07 實測 225s 過），所以排在訂閱之後——使用者定的順序。
# 走 OmniRoute（dc 從 ~/.creds/kv 帶 OMNIROUTE_API_KEY）。設空字串＝不用。
# 2026-10-19：Agnes 7 天 0/801 成功（429 免費限額、503 no available channel），清冊 dc_id 留空移出。
POOL_TAIL="${DCQ_POOL_TAIL-$(cat_pool free slash)}"
# Go 免費層同步（2026-10-21）：同一份 go-sync state（≤8 天）。兜底層裡 upstream 沒有的 opencode-go/*-free 移出；
# first_seen 非 base 的新 -free 接在 opencode-go 段尾（omniroute/* 之前）。omniroute/* 不動；全移光就維持原清單。
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_POOLSYNC:-1}" != 0 ] && [ -s "$GO_STATE" ] && command -v jq >/dev/null; then
  _cut="$(date -v-192H +%FT%T 2>/dev/null || date -d '-192 hours' +%FT%T)"
  _s="$(jq -r --arg pool "$POOL_TAIL" --arg cut "$_cut" '
    select((.at // "") >= $cut and (.upstream | length) > 0)
    | (.upstream) as $up | (.first_seen // {}) as $fs
    | ($pool | split(" ") | map(select(length > 0))) as $p
    | ($p | map(select(startswith("opencode-go/") and (ltrimstr("opencode-go/") as $m | any($up[]; . == $m) | not)))) as $rm
    | ([$up[] | select(endswith("-free") and ($fs[.] // "base") != "base") | "opencode-go/" + .] - $p) as $add
    | ($p - $rm) as $k
    | ([$k | to_entries[] | select(.value | startswith("opencode-go/")) | .key] | max // -1) as $i
    | "\(($k[:$i+1] + $add + $k[$i+1:]) | join(" "))|\($add | join(" "))|\($rm | join(" "))"' "$GO_STATE" 2>/dev/null)"
  if [ -n "${_s%%|*}" ]; then
    POOL_TAIL="${_s%%|*}"; _s="${_s#*|}"
    [ -z "${_s%%|*}" ] || SYNC_NOTE="${SYNC_NOTE}Go 免費新增 ${_s%%|*}；"; [ -z "${_s#*|}" ] || SYNC_NOTE="${SYNC_NOTE}Go 免費移出 ${_s#*|}；"
    [ -z "${_s%%|*}" ] || SYNC_ADD_GOFREE="${_s%%|*}"; [ -z "${_s#*|}" ] || SYNC_RM="${SYNC_RM:+$SYNC_RM }${_s#*|}"
  fi
fi
# omniroute/<m> 必須同時宣告在 opencode.json 的 provider.omniroute.models，否則 opencode 2 秒 ProviderModelNotFoundError，
# 兜底首棒形同不存在（fixindex 11136）。沒宣告的在組池時剔除並提示，不派。
# openrouter/*、nvidia/*、groq/* 是 opencode 直連：要有 key（env 或 opencode auth.json）、opencode.json 的 enabled_providers
# 沒把它排除，且模型宣告在 provider.<p>.models（:free 與 NIM 的 id models.dev 多半沒收，沒宣告 opencode 會 ProviderModelNotFoundError）。
# google/*（AI Studio 免費層）同一套：key 可在 env、auth.json，或 opencode.json 的 provider.google.options.apiKey（{file:} 引用）。
# kilo/*（Kilo Gateway 免 key）不看 key，只看 provider.kilo.models 有沒有宣告＋enabled_providers。
oc_direct_ok() {
  local p="$1" ocj="$2" var
  case "$p" in openrouter) var=OPENROUTER_API_KEY ;; nvidia) var=NVIDIA_API_KEY ;; groq) var=GROQ_API_KEY ;; google) var=GEMINI_API_KEY ;; kilo) var="" ;; *) return 1 ;; esac
  if [ -n "$var" ] && [ -z "${!var:-}" ] && ! { [ "$p" = google ] && [ -n "${GOOGLE_GENERATIVE_AI_API_KEY:-}" ]; }; then
    jq -e --arg p "$p" 'has($p)' "${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json" >/dev/null 2>&1 \
      || { [ -r "$ocj" ] && jq -e --arg p "$p" '(.provider[$p].options.apiKey // "") != ""' "$ocj" >/dev/null 2>&1; } || return 1
  fi
  [ -r "$ocj" ] || [ "$p" != kilo ] || return 1
  [ -r "$ocj" ] || return 0
  jq -e --arg p "$p" '(.enabled_providers // null) as $e | ($e == null or ($e | index($p) != null)) and ((.disabled_providers // []) | index($p) == null)' "$ocj" >/dev/null 2>&1
}
# OmniRoute 在遠端（Tailscale 另一台）離線時，兜底整層只能等 timeout（issue #12）：組池先打一次 /models，
# 2 秒內沒有任何 HTTP 回應（401 也算活著）就整個 provider 剔出。結果快取 OR_HC_S 秒，dcq status／plan 不必每次都等。
# userspace Tailscale 沒有 TUN，要經 proxy：curl 吃 ALL_PROXY／HTTPS_PROXY，opencode（Bun fetch）吃 HTTP(S)_PROXY，兩邊設同一組即可。
OR_HC_S="${DCQ_OR_HC_S:-120}"
or_alive() {  # $1=opencode.json
  local c="$Q/.health/@omniroute.hc" u code t
  [ "${DCQ_OR_HC:-1}" = 0 ] && return 0
  # 組池在 now()／mtime() 定義之前跑，這裡內聯
  t=$(stat -c %Y "$c" 2>/dev/null || stat -f %m "$c" 2>/dev/null || echo 0)
  if [ -f "$c" ] && [ $(( $(date +%s) - t )) -lt "$OR_HC_S" ]; then [ "$(cat "$c")" = ok ]; return; fi
  u="$(jq -r '.provider.omniroute.options.baseURL // empty' "$1" 2>/dev/null)"; [ -n "$u" ] || return 0
  code="$(curl -s -o /dev/null -m 2 -w '%{http_code}' "${u%/}/models" 2>/dev/null)"
  mkdir -p "$Q/.health"; if [ "${code:-000}" != 000 ]; then echo ok > "$c"; return 0; fi
  echo down > "$c"; return 1
}
oc_declared() {
  local ocj="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" m out="" miss="" orhc=""
  command -v jq >/dev/null || { echo "$1"; return; }
  for m in $1; do
    case "$m" in
      omniroute/*) if [ -r "$ocj" ] && jq -e --arg k "${m#omniroute/}" '.provider.omniroute.models[$k]' "$ocj" >/dev/null 2>&1; then
           [ -n "$orhc" ] || { or_alive "$ocj" && orhc=ok || { orhc=down; echo "dcq: OmniRoute（$(jq -r '.provider.omniroute.options.baseURL' "$ocj")）2 秒內無回應，omniroute/* 這次不派" >&2; }; }
           if [ "$orhc" = ok ]; then out="$out $m"; else miss="$miss $m"; fi
         else miss="$miss $m"; fi ;;
      google/*) if oc_direct_ok google "$ocj"; then out="$out $m"; else miss="$miss $m"; fi ;;
      openrouter/*|nvidia/*|groq/*|kilo/*) if oc_direct_ok "${m%%/*}" "$ocj" && jq -e --arg p "${m%%/*}" --arg k "${m#*/}" '.provider[$p].models[$k]' "$ocj" >/dev/null 2>&1; then out="$out $m"; else miss="$miss $m"; fi ;;
      *) out="$out $m" ;;
    esac
  done
  [ -z "$miss" ] || echo "dcq: opencode.json 未宣告，剔出池：${miss# }" >&2
  echo "${out# }"
}
_in="$POOL_TAIL"; POOL_TAIL="$(oc_declared "$POOL_TAIL")"
# 剔出名單留在父殼：plan 摘要、doctor、告警要用（issue #9：只印一行 stderr 常被呼叫端濾掉）
POOL_MISS=""; for _m in $_in; do case " $POOL_TAIL " in *" $_m "*) ;; *) POOL_MISS="$POOL_MISS${POOL_MISS:+ }$_m" ;; esac; done
# Go 免費併進主免費層（2026-10-22）：opencode-go/*-free 一樣免費（docs/go：額度用完仍可用免費模型），
# 以前只因 dc_id 有斜線就落到兜底層，排在 0 PASS 的 Zen 累犯後面——兜底的 opencode-go/beam-free 12 跑 8 過、中位 71s，
# 是實測最好的免費模型，卻常輪不到（10-21 wo-r1／r8／r9 撞 JOB_MAX 前都沒試到）。
# 併進來後與 Zen 免費同一套排名（每 PASS 秒數＋貝氏平滑）；Zen 走 per-IP 的免費閘，Go 走 Go key，
# 兩條閘分開，免費層併發容量從 zen=2 變成 zen=2＋opencode-go=4。兜底層只剩 omniroute/*。DCQ_GOFREE_MAIN=0 關；
# DCQ_POOL_ZEN／DCQ_POOL_TAIL 有設（整條覆寫）時照設定的分層，不搬。
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_GOFREE_MAIN:-1}" != 0 ] && [ -z "${DCQ_POOL_ZEN+x}" ] && [ -z "${DCQ_POOL_TAIL+x}" ]; then
  _g=""; _t=""
  # google/*、kilo/*（2026-10-24）、openrouter :free／nvidia／groq（10-25）同理併進主層：免費、各走自己的 key／IP 閘，不該排在兜底層
  for _m in $POOL_TAIL; do case "$_m" in opencode-go/*-free|google/*|kilo/*|openrouter/*|nvidia/*|groq/*) _g="$_g${_g:+ }$_m" ;; *) _t="$_t${_t:+ }$_m" ;; esac; done
  [ -z "$_g" ] || { MODELS="$MODELS${MODELS:+ }$_g"; POOL_TAIL="$_t"; }
fi
POOL_PEN="${DCQ_POOL_PEN-}"   # 手動指定只在不自動排名時有效（測試用）；自動排名會覆寫
POOL_ZERO="${DCQ_POOL_ZERO-}" # 冷宮：0 PASS 的免費模型，兜底層之後、訂閱層之前；手動指定同 POOL_PEN（測試用），自動排名會覆寫
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_AUTORANK:-1}" != 0 ]; then
  MODELS_MANUAL="$MODELS"; _r="$(rank_free "$MODELS")"; MODELS="${_r%%|*}"; _r="${_r#*|}"; POOL_PEN="${_r%%|*}"; POOL_ZERO="${_r#*|}"
fi
# 依難度各排一份（只用同難度＋舊紀錄）：某隻只在 hard 卡住，不該連 easy 工單都把它降級。
# ponytail: Thompson sampling（LiteLLM complexity_router adaptive 那種）延後：2026-10-19 gaps.tsv 118 筆分散 18 隻、
# 只有 3 隻 ≥10 筆，拆三個難度後幾乎每格 <10。任一難度有 ≥5 隻各 ≥20 筆時再換掉 s/pass 排序。
MODELS_easy="$MODELS" PEN_easy="$POOL_PEN" ZERO_easy="$POOL_ZERO" MODELS_mid="$MODELS" PEN_mid="$POOL_PEN" ZERO_mid="$POOL_ZERO" MODELS_hard="$MODELS" PEN_hard="$POOL_PEN" ZERO_hard="$POOL_ZERO"
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_AUTORANK:-1}" != 0 ]; then
  _r="$(rank_free "$MODELS_MANUAL" order easy)"; MODELS_easy="${_r%%|*}"; _r="${_r#*|}"; PEN_easy="${_r%%|*}" ZERO_easy="${_r#*|}"
  _r="$(rank_free "$MODELS_MANUAL" order mid)";  MODELS_mid="${_r%%|*}";  _r="${_r#*|}"; PEN_mid="${_r%%|*}" ZERO_mid="${_r#*|}"
  _r="$(rank_free "$MODELS_MANUAL" order hard)"; MODELS_hard="${_r%%|*}"; _r="${_r#*|}"; PEN_hard="${_r%%|*}" ZERO_hard="${_r#*|}"
fi
# 2026-10-21：兜底層與訂閱層也做層內排序，規則與免費層相同（依「每 PASS 一張平均花幾秒」升冪排，
# 停滯率過高或 0 PASS 的降到該層最後；樣本不足的留原位）。
# 為什麼：這兩層以前照清冊固定順序，永遠先派第一隻。實例：兜底層 opencode-go/longcat 12 跑 2 過，
# 排在 11 跑 8 過的 opencode-go/beam 前面 —— 比較慢的那隻先跑，每張工單都在替它白等。
# 只在層內排：不跨層搬移（不把免費層的模型搬進兜底層、也不把兜底層的搬去訂閱層），也不分難度（層內用全部紀錄）。
# DCQ_MODELS 有設、或 DCQ_AUTORANK=0 就不排（跟免費層同一個開關）。
rank_layer() {  # $1=該層手排順序（空白分隔）；印接回來的完整順序：懲罰、0 PASS 依序墊該層最後
  local r o p z
  r="$(rank_free "$1")"; o="${r%%|*}"; r="${r#*|}"; p="${r%%|*}"; z="${r#*|}"
  echo $o $p $z   # 不加引號：順便收掉空段造成的多餘空白
}
if [ -z "${DCQ_MODELS:-}" ] && [ "${DCQ_AUTORANK:-1}" != 0 ]; then
  POOL_TAIL="$(rank_layer "$POOL_TAIL")"; POOL_PAID="$(rank_layer "$POOL_PAID")"
fi
# API 層（按量扣錢）：訂閱層之後，DCQ_ALLOW_API=1 才用；清冊 billing=api 且有 dc_id 的列。預設不開。
POOL_API=""; [ "${DCQ_ALLOW_API:-0}" = 1 ] && POOL_API="${DCQ_POOL_API-$(cat_pool api slash) $(cat_pool api zen)}"
POOL_API="${POOL_API# }"; POOL_API="${POOL_API% }"
# per-provider 併發上限（借鏡 oh-my-opencode providerConcurrency）：provider＝dc_id 第一個斜線前，無斜線＝zen。
PROV_MAX="${DCQ_PROV_MAX-$( [ -r "$CAT/providers.tsv" ] && awk -F'\t' '!/^#/ && NF>=2 { printf "%s%s=%s", (n++ ? " " : ""), $1, $2 }' "$CAT/providers.tsv")}"
FREE_ROUNDS="${DCQ_FREE_ROUNDS:-2}"
JOBS="${DCQ_JOBS:-4}"
JOBS_MAX=8
# 借鏡 LiteLLM Router 的 allowed_fails / cooldown_time 語意（舊名 DCQ_BREAK_* 相容）
ALLOW="${DCQ_ALLOWED_FAILS:-${DCQ_BREAK_N:-2}}"
COOL_S="${DCQ_COOLDOWN_S:-${DCQ_BREAK_S:-120}}"
MODEL_MAX="${DCQ_MODEL_MAX:-3}"      # 單一模型同時最多幾張；滿了就分給下一隻，不在忙的模型上排隊
# watchdog：opencode 的 chunkTimeout 有洞（#43519 keepalive 歸零、#48675 零 chunk 卡住不報錯），
# 所以外面再看一層「.out 多久沒長」。事件是 step 級不是 token 級（2026-10-02 實測），
# 長推理的正常 step 本來就會靜默數分鐘 —— 門檻太緊會誤殺。2026-10-04 用 opencode.db 量過 longcat
# 376 個正常 step：靜默 >300s 約 1%、>180s 3.5%，降門檻誤殺重跑比省下的等待貴，維持 300。
# 2026-10-09 改 200（≈PASS 最大靜默 162×1.25，留 25% 餘量）：gaps.tsv 工單層級 39 張 PASS 最大靜默 p95=159、max=162，沒有一張落在
# 163–299；13 次停滯全部撞滿 300 才殺（合計 65 分白等）。分布是兩群，200 切在中間。10-04 的
# step 數據主要來自 longcat，它已進懲罰層。每次停滯省 100s。180 試過：162 只差 18s，近邊警告會一直亮，餘量太薄。
# ponytail: 全域單一門檻；dcq rank 會在 PASS 最大靜默 ≥ 0.9×STALL_S 時警告——出現就是門檻太緊，
# 再改 per-model 門檻（該模型 PASS 最大靜默 ×1.3）。
STALL_S="${DCQ_STALL_S:-200}"
JOB_MAX="${DCQ_JOB_MAX:-2700}"; JOB_MAX_G="$JOB_MAX"       # 整張工單（含所有模型）的總時限，防失控迴圈燒 Go 額度（#52092）
# 單隻模型一次嘗試的上限。一直有輸出（無限 Glob/Read，opencode#50678）不會觸發 STALL_S，
# 沒有這道就一路吃到 JOB_MAX、整張判 jobmax 不換模型——fallback 鏈形同沒有。
# 600 ≈ gaps.tsv PASS 單次最長 294s ×2（2026-10-13，n=11）。撞到＝why=slow，罰冷卻、換下一隻。
# 看進度（2026-10-21）：cwd 最近 PROGRESS_S 秒內有改檔就不判 slow，繼續跑到沒進度或 JOB_MAX。
# 研究類工單（逐頁抓原文存檔）單次常超過 600s，硬切會丟掉模型已讀的上下文、換下一隻重讀。
ATTEMPT_MAX="${DCQ_ATTEMPT_MAX:-600}"
PROGRESS_S="${DCQ_PROGRESS_S:-300}"
# 防空轉：模型一直講話卻不改檔（讀檔繞圈、反覆重試同一招）不觸發 STALL_S，要等 ATTEMPT_MAX。
# cwd 是 git 工作樹時，這次嘗試 SPIN_S 秒內 HEAD＋改動＋未追蹤檔都沒變 → why=spin，跟 stall 一樣罰冷卻換手。
# 進驗收（.out 出現「dc: 驗收 →」）就不再看，慢驗收不會被誤殺。0＝關；入列時 DCQ_SPIN_S 會記進工單，可逐張關。
# ponytail: 唯讀工單（只產報告到 cwd 外）在 git cwd 裡跑超過 SPIN_S 會被誤殺；這類工單入列帶 DCQ_SPIN_S=0。
SPIN_S="${DCQ_SPIN_S:-420}"
POLL_S="${DCQ_POLL_S:-5}"
# .out 是模型 transcript 原文，可能有憑證：先建 600 空檔、跑完遮罩、過期刪除（issue #5）
# 遮罩器隨 repo 走（2026-10-24）：原本指 ~/.claude/tools，雲端 clone 沒有那支，遮罩每次失敗、.out 留原文。
# M4 的 ~/.claude/tools/fi-mask-transcript.mjs 是指向這支的 symlink（/fi 也用），正本只有這一份。
MASK="${DCQ_MASK-$(dirname "$(readlink -f "$0")")/mask-transcript.mjs}"
# 沒有 node 改用同目錄的 perl 版（Grok 雲端 opencode 是獨立執行檔、不帶 node，10-24 遮罩仍失敗）。
# 失敗時印原因，不只說「失敗」。
mask_file() {
  local f="$1" pl="${MASK%.mjs}.pl" e
  [ -r "$MASK" ] || { echo "遮罩器不在（${MASK}）"; return 1; }
  local nb="${DCQ_NODE_BIN:-node}"   # 測試用：設成不存在的名字＝模擬沒有 node
  if command -v "$nb" >/dev/null; then e="$("$nb" "$MASK" "$f" "$f" 2>&1 >/dev/null)" || { echo "node 遮罩出錯：${e:0:200}"; return 1; }
  elif command -v perl >/dev/null && [ -r "$pl" ]; then e="$(perl "$pl" "$f" "$f" 2>&1 >/dev/null)" || { echo "perl 遮罩出錯：${e:0:200}"; return 1; }
  else echo "node 和 perl 都沒有"; return 1; fi
}
LOG_DAYS="${DCQ_LOG_DAYS:-14}"

die() { echo "dcq: $*" >&2; exit 2; }
init() { mkdir -p "$Q"/{pending,running,done,failed,logs} "$Q/.cwdlock" "$Q/.cancel" "$Q/.health" "$Q/.inuse" "$Q/.preflight" "$Q/.wt"; }
# git-bash 只有 sha1sum，macOS/Linux 只有 shasum；兩者同為 SHA-1，鎖 key 跨平台一致
_sha1() { if command -v shasum >/dev/null 2>&1; then shasum; else sha1sum; fi; }
hash12() { printf '%s' "$1" | _sha1 | cut -c1-12; }
now() { date +%s; }
fk() { printf '%s' "${1//\//_}"; }   # 模型名當檔名用：opencode-go/x 的斜線會被當成子目錄

# --- per-model 健康：連續 ALLOW 次上游失敗就冷卻 COOL_S 秒 ------------------------
# 跨進程共享計數但不用鎖：計數＝目錄裡的檔案數，bump 是 touch、reset 是 rm，
# 沒有 read-modify-write 就沒有 critical section 可搶。
# （更早一版用 mkdir 當全域鎖包住讀寫，worker 之間互相卡死——多餘的同步本身才是 bug。）
bump_fail() {
  local m="$1" d="$Q/.health/$(fk "$1").fails" n
  mkdir -p "$d"; : > "$d/$$.$RANDOM"
  n=$(ls -1 "$d" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$n" -ge "$ALLOW" ]; then
    echo $(( $(now) + COOL_S )) > "$Q/.health/$(fk "$m").cool"
    rm -f "$d"/* 2>/dev/null
    echo "dcq: 冷卻 $m —— 連續 ${ALLOW} 次上游失敗，${COOL_S}s 內不派" >&2
  fi
}
reset_fail() { rm -rf "$Q/.health/$(fk "$1").fails" "$Q/.health/$(fk "$1").cool" "$Q/.health/$(fk "$1").gone"; case "$1" in */*) ;; *) rm -f "$Q/.health/@zen.cool" ;; esac; }
# 上游不回（why=upstream）直接冷卻 UPSTREAM_COOL_S，不等 ALLOW 次：額度用完或排隊時同一隻再試只會再白等
# STALL_S（10-07 實例 4 隻×2 輪×200s）。冷卻檔是跨工單共用的，併發中的其他工單也會跳過它。
UPSTREAM_COOL_S="${DCQ_UPSTREAM_COOL_S:-900}"
cool_upstream() {
  echo $(( $(now) + UPSTREAM_COOL_S )) > "$Q/.health/$(fk "$1").cool"; rm -rf "$Q/.health/$(fk "$1").fails"
  echo "dcq: 冷卻 $1 —— 上游不回，${UPSTREAM_COOL_S}s 內不派" >&2
}
# 到某時區下一個 00:00 還有幾秒（BSD／GNU date 都吃 TZ=）
to_midnight() { local h m s; IFS=: read -r h m s <<<"$(TZ="$1" date +%H:%M:%S)"; echo $(( 86400 - (10#$h * 3600 + 10#$m * 60 + 10#$s) )); }
# 額度用完（issue #8／#10／#11）：冷卻到額度重置，不是固定 15 分鐘——白試只會再撞一次。
# Zen 免費額度按出口 IP＋UTC 日（台北 08:00 重置），一隻撞到＝整個 Zen 免費池都沒了 → provider 級冷卻 .health/@zen.cool。
# Google AI Studio 免費層 RPD 按模型、太平洋時間午夜重置 → 該模型冷卻到那時；每分鐘窗口（RPM）只冷 QUOTA_RPM_COOL_S。
# Go usage limit 只擋付費 Go 模型，*-free 照用（docs/go）→ 只冷該模型 QUOTA_GO_COOL_S。
# ponytail: 冷卻狀態只在本機 ${Q}；多機共用同一出口 IP 時別台不知道（issue #10），要共用再把 @zen.cool 換成同步檔或 HTTP。
QUOTA_GO_COOL_S="${DCQ_QUOTA_GO_COOL_S:-3600}"
QUOTA_RPM_COOL_S="${DCQ_QUOTA_RPM_COOL_S:-120}"
cool_quota() {  # $1=model $2=該次 .out
  local m="$1" k s
  if grep -q '^dc: 額度窗口＝每分鐘' "$2" 2>/dev/null; then k="$(fk "$m")"; s=$QUOTA_RPM_COOL_S
  else case "$m" in
    */*) k="$(fk "$m")"
         case "$m" in google/*) s=$(to_midnight America/Los_Angeles) ;; opencode-go/*) s=$QUOTA_GO_COOL_S ;; *) s=$UPSTREAM_COOL_S ;; esac ;;
    *) k=@zen; s=$(to_midnight UTC) ;;
  esac; fi
  echo $(( $(now) + s )) > "$Q/.health/$k.cool"; rm -rf "$Q/.health/$(fk "$m").fails"
  echo "dcq: 冷卻 $([ "$k" = @zen ] && echo 'Zen 免費池（整個 provider）' || echo "$m") —— 額度用完，${s}s 內不派" >&2
}
# 報錯加掃（10-23）：go-sync 每 7 天才掃一次，下架的 opencode-go 模型會在名單裡留到下次週掃，
# 每張工單都撞一次（10-23 02:00 r7／r13 撞 minimax-m3.1-flash-free、longcat-2.5-preview-free）。
# 撞到下架錯誤：冷卻 GONE_COOL_S（1 小時）並記 .gone；冷卻到期、要再派之前先查清單（gone_recheck），
# 清單有它就恢復，沒有就再停 1 小時。不長冷卻：免費模型會下架又回來（quadseven/loom#1295：
# minimax-m3.1-flash-free 10-20 not found、10-21 又可用，停一天白停 11 小時；LiteLLM 404 也只短冷卻）。
# 清單來源：opencode-go/* 用 go-sync 強制掃 Go /models（RESYNC_MIN_S 內只掃一次，併發 worker 共用；順帶更新清冊）；
# Zen（無前綴）用 `opencode models opencode`（讀 models.dev 快取，不打 Zen 閘道，避開 IP 濫用判定）；
# 其他（omniroute/*）或清單查不到 → 不擋，照常派（loom：清單查詢失敗不停用）。
# ponytail: models.dev 比 Zen 實際上架慢（10-23 jev-1.13-free 在 Zen /models 有、models.dev 沒有），只拿來判「還在不在」。
GONE_RE='[P]roviderModelNotFoundError|has been [d]eprecated'
GONE_COOL_S="${DCQ_GONE_COOL_S:-3600}"
RESYNC_MIN_S="${DCQ_RESYNC_MIN_S:-1800}"
GO_SYNC="${DCQ_GO_SYNC:-$(dirname "$(readlink -f "$0")")/../oc-probe/bin/go-sync}"
go_resync() {
  local lk="$Q/.health/.resync.lock" i=0 last
  until mkdir "$lk" 2>/dev/null; do i=$((i + 1)); [ "$i" -ge 60 ] && break; sleep 1; done
  last=$(cat "$Q/.health/.resync.at" 2>/dev/null || echo 0)
  if [ $(( $(now) - last )) -ge "$RESYNC_MIN_S" ]; then
    now > "$Q/.health/.resync.at"
    echo "dcq: 加掃 go-sync（$1）" >&2
    "$GO_SYNC" --scan >> "$Q/logs/resync.log" 2>&1 || echo "dcq: go-sync 加掃失敗（見 $Q/logs/resync.log）" >&2
  fi
  rmdir "$lk" 2>/dev/null
}
# Zen 上游清單：GET /zen/v1/models（公開、不帶 key、不推論），節流同 go_resync，寫 ZEN_STATE；抓失敗保留舊檔。
# fix 10194：可用性以上游 /models 為準，CLI 的 models.dev 清單只是公開目錄，上游抓不到才退回它。
ZEN_STATE="${DCQ_ZEN_STATE:-$Q/logs/zen-models.json}"
ZEN_MODELS_URL="${DCQ_ZEN_MODELS_URL:-https://opencode.ai/zen/v1/models}"
zen_resync() {
  local lk="$Q/.health/.zenresync.lock" i=0 last tmp
  until mkdir "$lk" 2>/dev/null; do i=$((i + 1)); [ "$i" -ge 60 ] && break; sleep 1; done
  last=$(cat "$Q/.health/.zenresync.at" 2>/dev/null || echo 0)
  if [ $(( $(now) - last )) -ge "$RESYNC_MIN_S" ]; then
    now > "$Q/.health/.zenresync.at"; tmp="$ZEN_STATE.$$"
    echo "dcq: 加掃 Zen /models（$1）" >&2
    if curl -s -m 20 "$ZEN_MODELS_URL" | jq -e --arg at "$(date +%FT%T)" '{at: $at, upstream: [.data[].id]} | select(.upstream | length > 0)' > "$tmp" 2>/dev/null; then
      mv "$tmp" "$ZEN_STATE"; zen_pool_feed
    else rm -f "$tmp"; echo "dcq: Zen /models 加掃失敗，沿用舊清單" >&2; fi
  fi
  rmdir "$lk" 2>/dev/null
}
# 加掃結果回灌名單：池內 Zen 模型上游已無 → GONE、上游新的 *-free 不在池 → NEW，追加進 x-pool.tsv
# （與 @opencode 推文同一條路：下次 dcq 啟動 pool_sync_zen 套用，NEW 當 manual 進 autorank、0 PASS 自動進懲罰層），
# 再叫 sync-catalog 回寫清冊。同一模型最新一列已是同動作就不重記。
# ponytail: NEW 只認 -free 結尾；big-pickle／muse-* 這類不帶 -free 的免費模型仍靠週探測收。
zen_pool_feed() {
  local xf="$Q/logs/x-pool.tsv" pool="$MODELS ${POOL_PEN:-} ${POOL_ZERO:-}" rows
  rows="$(jq -r --arg pool "$pool" --arg t "$(date +%F_%T)" '
      ($pool | split(" ") | map(select(length > 0 and (contains("/") | not)))) as $p | .upstream as $u
      | ([$p[] | . as $m | select(($u | index($m)) == null) | [$t, "zen-models", "GONE", $m]]
       + [$u[] | . as $m | select(($m | endswith("-free")) and (($p | index($m)) == null)) | [$t, "zen-models", "NEW", $m]])[] | @tsv' "$ZEN_STATE" 2>/dev/null |
    awk -F'\t' -v xf="$xf" 'BEGIN { while ((getline l < xf) > 0) { split(l, a, "\t"); last[a[4]] = a[3] } } last[$4] != $3')"
  [ -n "$rows" ] || return 0
  printf '%s\n' "$rows" >> "$xf"
  echo "dcq: Zen /models 加掃改名單 → $(printf '%s\n' "$rows" | awk -F'\t' '{printf "%s%s %s", (NR>1?"；":""), $3, $4}')" >&2
  [ "${DCQ_FEED_CATALOG:-1}" = 0 ] || env -u DCQ_MODELS "$0" sync-catalog --source "Zen /models 加掃" >> "$Q/logs/resync.log" 2>&1 ||
    echo "dcq: sync-catalog 失敗（見 $Q/logs/resync.log）" >&2
}
# 0＝清單有、1＝清單沒有、2＝查不到（不擋）
model_listed() {
  local m="$1" out
  case "$m" in
    opencode-go/*) go_resync "$m"; [ -s "$GO_STATE" ] || return 2
      jq -e '(.upstream | length) > 0' "$GO_STATE" >/dev/null 2>&1 || return 2
      jq -e --arg m "${m#opencode-go/}" '.upstream | index($m) != null' "$GO_STATE" >/dev/null 2>&1 && return 0; return 1 ;;
    */*) return 2 ;;
    *) zen_resync "$m"
      if [ -s "$ZEN_STATE" ] && jq -e '(.upstream | length) > 0' "$ZEN_STATE" >/dev/null 2>&1; then
        jq -e --arg m "$m" '.upstream | index($m) != null' "$ZEN_STATE" >/dev/null 2>&1 && return 0; return 1
      fi
      out="$(opencode models opencode 2>/dev/null)" && [ -n "$out" ] || return 2
      printf '%s\n' "$out" | grep -qxF "opencode/$m" && return 0; return 1 ;;
  esac
}
gone_mark() {
  echo $(( $(now) + GONE_COOL_S )) > "$Q/.health/$(fk "$1").cool"; rm -rf "$Q/.health/$(fk "$1").fails"
  : > "$Q/.health/$(fk "$1").gone"
  case "$1" in opencode-go/*) go_resync "$1" ;; */*) ;; *) zen_resync "$1" ;; esac
  echo "dcq: 下架 $1 —— ${GONE_COOL_S}s 後查清單再決定" >&2
}
# 冷卻到期的 .gone 模型：清單有 → 恢復（回 0）；沒有 → 再停 GONE_COOL_S（回 1）
gone_recheck() {
  model_listed "$1"
  case $? in
    1) echo $(( $(now) + GONE_COOL_S )) > "$Q/.health/$(fk "$1").cool"
       echo "dcq: $1 清單仍無，再停 ${GONE_COOL_S}s" >&2; return 1 ;;
    *) rm -f "$Q/.health/$(fk "$1").gone"; echo "dcq: $1 清單已列回（或查不到），恢復派工" >&2; return 0 ;;
  esac
}
# 錯誤簽章：.out 去掉 dc:/dcq 開頭的行後取最後 3 行。真 dc 每次都印
# "dc: opencode run rc=1"，不排除的話任何上游失敗都會撞成同簽章。
# dc 因上游（限流／不可用／濫用閘）提早結束時，.out 末尾是 bash 殺子程序的 Terminated 回顯＝
# 同一段 prompt，換哪隻模型都一樣，不是本機確定性錯誤 → 簽章給空（10-22 cabinet R4 兩次誤停）。
err_sig() {
  grep -qE '^dc: .*(上游|提早結束)' "$1" 2>/dev/null && return 0
  grep -v -e '^dc:' -e '^dcq' "$1" 2>/dev/null | tail -3
}
# 總時限到＝工單的問題不是模型的；但模型可能已交件、只差 dc 來不及驗收（10-22 cabinet R1／R8
# 做完仍記 FAIL rc=124）。殺掉後用同一份 pin 自己跑一次驗收，過就 PASS。$1 task $2 cwd $3 preflight dir
jobmax_verify() {
  local wv="${DC_BIN:-$(dirname "$(readlink -f "$0")")}/wo-verify"
  [ -x "$wv" ] || return 1
  if [ -f "$3/pin" ]; then ( cd "$2" && "$wv" "$1" --pinned "$3/pin" ) >/dev/null 2>&1
  else ( cd "$2" && "$wv" "$1" ) >/dev/null 2>&1; fi
}
# Zen 免費閘道判濫用時 dc 寫全域閘檔（見 dc 的 ABUSE_RE）：沒有 provider 前綴的模型（Zen／Go 免費）一律視同冷卻，
# 直接落到兜底層，不再逐隻換 Zen 模型連打。
ZEN_GATE="${DC_ZEN_GATE:-$HOME/.dcq/.zen-gate}"
# 10-19：dc 閘與 Jev 閘取聯集（zen-gate until），任一份封鎖就整池跳過
ZG="$(dirname "$(readlink -f "$0")")/zen-gate"
cool_left() {
  local u g; u=$(cat "$Q/.health/$(fk "$1").cool" 2>/dev/null || echo 0)
  case "$1" in */*) ;; *) g=$("$ZG" until 2>/dev/null || cat "$ZEN_GATE" 2>/dev/null || echo 0); [ "${g:-0}" -gt "$u" ] && u=$g
    g=$(cat "$Q/.health/@zen.cool" 2>/dev/null || echo 0); [ "${g:-0}" -gt "$u" ] && u=$g ;; esac
  echo $(( u > $(now) ? u - $(now) : 0 ))
}

# per-model 併發槽：mkdir 原子搶 .inuse/<model>.<k>，k=1..MODEL_MAX
# 再加一層 per-provider 槽 .inuse/@<provider>.<k>（上限見 PROV_MAX；沒列到的 provider 不設限）。
# 先搶 provider 再搶 model，model 槽搶不到就把 provider 槽還回去。印「model槽 [provider槽]」。
prov_of() { case "$1" in */*) echo "${1%%/*}" ;; *) echo zen ;; esac; }
take_slot() {
  local k p pm="" ps="" kv
  p="$(prov_of "$1")"
  for kv in $PROV_MAX; do [ "${kv%%=*}" = "$p" ] && pm="${kv#*=}"; done
  # 10-21：半開只放 1 個探測（借鏡 OmniRoute circuitBreaker 的 halfOpenRequests=1）。
  # Zen 閘已到期但還有被封的紀錄 → zen 這個 provider 的上限壓到 1，
  # 避免整池同時探測、探測完又被判濫用，退避輪數白長。
  if [ "$p" = zen ] && "$ZG" halfopen >/dev/null 2>&1; then pm=1; fi
  if [ -n "$pm" ]; then
    for k in $(seq 1 "$pm"); do mkdir "$Q/.inuse/@$p.$k" 2>/dev/null && { ps="$Q/.inuse/@$p.$k"; break; }; done
    [ -n "$ps" ] || return 1
  fi
  for k in $(seq 1 "$MODEL_MAX"); do
    mkdir "$Q/.inuse/$(fk "$1").$k" 2>/dev/null && { echo "$Q/.inuse/$(fk "$1").$k${ps:+ $ps}"; return 0; }
  done
  [ -z "$ps" ] || rmdir "$ps" 2>/dev/null
  return 1
}

# $2 裡不在 $1 的模型（保持 $2 順序）；不碰槽位，給「還有沒有可重試的」這類判斷用
not_in() {
  local m o=""
  for m in $2; do case " $1 " in *" $m "*) ;; *) o="$o${o:+ }$m" ;; esac; done
  echo "$o"
}
# hard 工單濾掉 EASY_ONLY（清冊 fit=easy／easy-only），mid 工單濾掉 EASY_STRICT（fit=easy-only）；easy 原樣
fit_pool() {
  case "${JOB_TIER:-}" in hard) not_in "$EASY_ONLY" "$1" ;; mid) not_in "$EASY_STRICT" "$1" ;; *) echo "$1" ;; esac
}
# 從 $2 這個池挑下一隻：依序跳過「本單試過的」「冷卻中的」「槽滿的」。印：
#   PICK <model> <slot>
#   BUSY        有沒試過的但槽滿 —— 只是忙，等它讓出來
#   COOL <秒>   沒試過的全在冷卻 —— 這個池現在是掛的
#   NONE        全試過了
pick_model() {
  local tried=" $1 " m left soonest=0 any=0 busy=0 slot
  for m in $2; do
    case "$tried" in *" $m "*) continue ;; esac
    any=1
    left=$(cool_left "$m")
    if [ "$left" = 0 ] && [ -e "$Q/.health/$(fk "$m").gone" ] && ! gone_recheck "$m"; then left=$(cool_left "$m"); fi
    if [ "$left" -gt 0 ]; then
      { [ "$soonest" -eq 0 ] || [ "$left" -lt "$soonest" ]; } && soonest=$left
      continue
    fi
    slot=$(take_slot "$m") && { echo "PICK $m $slot"; return 0; }
    busy=1
  done
  if [ "$busy" = 1 ]; then echo BUSY
  elif [ "$any" = 1 ]; then echo "COOL $soonest"
  else echo NONE; fi
}

# 派工前預覽（派o 先給使用者看這份再問要不要派）：每張的難度與會走的層，不入列、不打上游。
# ponytail: 層級順序與 run_job 各寫一份；改 run_job 的階梯要同步改這裡（dcq_tier_test 5b 會抓順序不一致）。
hm() { date -r "$1" +%H:%M 2>/dev/null || date -d "@$1" +%H:%M; }
# 免費池體檢（issue #9／#10）：一行 provider 組成＋剔出名單＋Zen 冷卻到幾點。plan／doctor 開頭印。
pool_summary() {
  local m s z
  s="$(for m in ${MODELS_MANUAL:-$MODELS}; do prov_of "$m"; done | sort | uniq -c | awk '{printf "%s%s×%s", (n++ ? " " : ""), $2, $1}')"
  echo "免費池 provider：${s:-（空）}${POOL_MISS:+（剔出 $(set -- $POOL_MISS; echo $#) 個：${POOL_MISS}）}"
  z=$(cool_left zen-probe); [ "$z" -gt 0 ] && echo "Zen 免費池冷卻到 $(hm $(( $(now) + z )))（額度／濫用閘），免費層跳過 Zen"
  return 0
}
# 清冊有、本機沒宣告（不是刻意關掉）≥ DCQ_MISS_ALERT 隻（預設 1）、或免費主層只剩一家 provider：stderr 警告＋TG。
# 預設 1 隻就報（M2 追加建議，issue #9）：清冊同步帶進新 provider 時，各機 opencode.json 不會跟著同步，要當場提示。
# TG 每天一則；同一天剔出名單變了（又帶進新 provider）再推一則。
pool_alert() {
  # 戳記放 logs/ 不放 .health/：.health 是冷卻目錄，測試與 status 以「.health 為空」判沒冷卻（10-25 門檻降到 1 隻後誤判）
  local np st="$Q/logs/pool-alert.$(date +%F)" msg
  np="$(for m in ${MODELS_MANUAL:-$MODELS}; do prov_of "$m"; done | sort -u | wc -l | tr -d ' ')"
  local bad; bad="$(miss_split)"
  { [ -n "$bad" ] && [ "$(set -- $bad; echo $#)" -ge "${DCQ_MISS_ALERT:-1}" ]; } || [ "$np" -le 1 ] || return 0
  msg="⚠️ dcq 免費池縮水：$(pool_summary | head -1)。清冊有、本機 opencode.json 沒宣告的，dcq doctor --fix 印補丁"
  echo "dcq: WARN ${msg}" >&2
  [ "$(cat "$st" 2>/dev/null)" = "${bad:-single}" ] && return 0
  mkdir -p "$Q/logs"; echo "${bad:-single}" > "$st"
  { [ "${DC_PUSH:-}" = 1 ] || [ "$Q" = "$HOME/.dcq" ]; } && command -v hpush >/dev/null && { hpush "$msg" >/dev/null 2>&1 & }
  return 0
}
# enabled_providers／disabled_providers 明確排除的 provider＝這台刻意不用（例：M4 不開 openrouter／nvidia 直連），不算壞。
# 設定被清空時這兩欄通常也跟著沒了，剔出的就會落到「壞」。$1=off 印刻意關掉的，否則印壞的。
miss_split() {
  local ocj="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" m off="" bad=""
  for m in $POOL_MISS; do
    if [ "$(prov_of "$m")" != omniroute ] && jq -e --arg p "$(prov_of "$m")" '((.enabled_providers // null) as $e | $e != null and ($e | index($p)) == null) or ((.disabled_providers // []) | index($p) != null)' "$ocj" >/dev/null 2>&1
    then off="$off${off:+ }$m"; else bad="$bad${bad:+ }$m"; fi
  done
  if [ "${1:-}" = off ]; then echo "$off"; else echo "$bad"; fi
}
# doctor --fix：依剔出名單印 opencode.json 補丁（只印不寫；key 一律 {env:} 引用，不碰值）。
# 套用：jq -s '.[0] * .[1]' opencode.json patch.json。OmniRoute 的 baseURL 每台不同，沒有就留佔位字串。
oc_patch() {
  local m p k v; for m in $1; do
    p="$(prov_of "$m")"; k="${m#*/}"
    case "$p" in
      kilo) jq -n --arg k "$k" '{provider:{kilo:{npm:"@ai-sdk/openai-compatible",name:"Kilo Gateway",options:{baseURL:"https://api.kilo.ai/api/gateway/v1"},models:{($k):{}}}}}' ;;
      omniroute) jq -n --arg k "$k" '{provider:{omniroute:{npm:"@ai-sdk/openai-compatible",name:"OmniRoute",options:{baseURL:"http://<OmniRoute 主機>:20128/v1",apiKey:"{env:OMNIROUTE_API_KEY}"},models:{($k):{}}}}}' ;;
      nvidia) jq -n --arg k "$k" '{provider:{nvidia:{npm:"@ai-sdk/openai-compatible",name:"NVIDIA NIM",options:{baseURL:"https://integrate.api.nvidia.com/v1",apiKey:"{env:NVIDIA_API_KEY}",chunkTimeout:120000},models:{($k):{}}}}}' ;;
      # openrouter／groq 是 opencode 內建 provider，只缺 key 與 models 宣告（oc_declared 要求 models 有列）
      openrouter|groq)
        case "$p" in openrouter) v=OPENROUTER_API_KEY ;; *) v=GROQ_API_KEY ;; esac
        jq -n --arg p "$p" --arg k "$k" --arg v "{env:$v}" '{provider:{($p):{options:{apiKey:$v},models:{($k):{}}}}}' ;;
      google) jq -n '{provider:{google:{options:{apiKey:"{env:GEMINI_API_KEY}"}}}}' ;;
    esac
  done | jq -s 'reduce .[] as $x ({}; . * $x)'
}
cmd_doctor() {
  local off bad ocj="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  pool_summary; off="$(miss_split off)"; bad="$(miss_split)"
  [ -z "$off" ] || echo "略過 enabled／disabled_providers 刻意關掉的：$off"
  if [ -n "$bad" ] && [ "${1:-}" = --fix ]; then
    echo "補丁（併入 ${ocj}：jq -s '.[0] * .[1]' 原檔 補丁；已宣告但連不到的 omniroute 照樣列出，先查連線）："
    oc_patch "$bad"
  fi
  [ -z "$bad" ] || { echo "FAIL 清冊有、但本機 opencode.json 沒宣告／沒 key／連不到：$bad"; return 1; }
  echo "OK 清冊的模型都在池裡"
}
cmd_plan() {
  local order="${DCQ_ORDER:-default}" task tier ocbin="${DC_BIN:-$(dirname "$(readlink -f "$0")")}" n=0
  pool_summary; pool_alert
  case "$order" in default|free|sub) ;; *) die "DCQ_ORDER 只能是 default／free／sub：$order" ;; esac
  [ $# -gt 0 ] || die "用法：dcq plan <task.md>...（DCQ_ORDER=free|sub 換順序；預設 default）"
  for task in "$@"; do
    n=$((n + 1)); tier="${DCQ_TIER:-}"
    [ -n "$tier" ] || { [ "${DCQ_TRIAGE:-0}" = 1 ] && [ -x "$ocbin/triage" ] && tier="$("$ocbin/triage" "$task")"; }; tier="${tier:-mid}"
    JOB_TIER="$tier"
    local f p pe t z s a c
    case "$tier" in easy) f="$MODELS_easy" pe="$PEN_easy" z="$ZERO_easy" ;; hard) f="$MODELS_hard" pe="$PEN_hard" z="$ZERO_hard" ;; *) f="$MODELS_mid" pe="$PEN_mid" z="$ZERO_mid" ;; esac
    f="$(fit_pool "$f")"; pe="$(fit_pool "$pe")"; z="$(fit_pool "$z")"; t="$(fit_pool "$POOL_TAIL")"; s="$(fit_pool "$POOL_PAID")"; a="$(fit_pool "$POOL_API")"; c=""
    [ "$order" = free ] && { s=""; a=""; }
    [ "$order" = sub ] && c="$(fit_pool "$POOL_CLAUDE")"
    echo "[$n] $(basename "$task")　難度 $tier"
    if [ "$order" = sub ] && [ -n "$s" ]; then echo "  1 訂閱：$s"; echo "  2 免費：$f"; else echo "  1 免費：$f"; fi
    [ "$tier" = hard ] && [ "$BON_N" -ge 2 ] && echo "  · 強模型全冷卻時：best-of-N 同派 ≤${BON_N} 隻 fit=easy（$(not_in "$EASY_STRICT" "$EASY_ONLY")）"
    [ -z "$pe" ] || echo "  · 懲罰：$pe"
    [ -z "$t" ] || echo "  · 兜底：$t"
    [ -z "$z" ] || echo "  · 冷宮（0 PASS）：$z"
    [ "$order" = sub ] || [ -z "$s" ] || echo "  · 訂閱（付費）：$s"
    [ -z "$c" ] || echo "  · Claude（訂閱額度）：$c"
    [ -z "$a" ] || echo "  · API（按量扣錢）：$a"
  done
  echo "順序 ${order}；併發 全域 ${JOBS}、每模型 ${MODEL_MAX}、provider ${PROV_MAX:-不限}"
}

# --- add ---------------------------------------------------------------------
cmd_add() {
  local task="${1:-}" cwd="${2:-$PWD}" tier="${3:-${DCQ_TIER:-}}" order="${DCQ_ORDER:-default}"
  [ -n "$task" ] || die "用法：dcq add <task.md 絕對路徑> [cwd] [easy|mid|hard]"
  case "$task" in /*) ;; *) die "task 路徑必須是絕對路徑：$task" ;; esac
  [ -f "$task" ] || die "task 檔不存在：$task"
  [ -d "$cwd" ] || die "cwd 不存在：$cwd"
  cwd="$(cd "$cwd" && pwd)"
  pool_alert

  # 准入閘：沒有可跑的驗收區塊的工單不該佔 slot。用 dc 自己的閘，不另寫一套。
  # 跟 dc 同一份 repo 自帶閘（bin/ 同目錄），不走 PATH 上 deepclaude 的那份
  local ocbin="${DC_BIN:-$(dirname "$(readlink -f "$0")")}" dl wv
  dl="$ocbin/deep-lint"; wv="$ocbin/wo-verify"
  # lint 訊息走 stderr：stdout 只留 job id，id=$(dcq add …) 才拿得到單行 id（fix 10521）
  [ -x "$dl" ] && { "$dl" "$task" >&2 || die "deep-lint 未過，拒絕入列：$task"; }
  [ -x "$wv" ] && { "$wv" "$task" --dry >/dev/null 2>&1 || die "驗收區塊語法錯，拒絕入列：$task"; }

  # 難度：呼叫端給的優先；沒給一律 mid。Laya 判難度（bin/triage）2026-10-24 起預設關（使用者：Laya 沒產能），DCQ_TRIAGE=1 才開
  [ -n "$tier" ] || { [ "${DCQ_TRIAGE:-0}" = 1 ] && [ -x "$ocbin/triage" ] && tier="$("$ocbin/triage" "$task")"; }
  case "$tier" in easy|mid|hard) ;; "") tier=mid ;; *) die "難度只能是 easy／mid／hard：$tier" ;; esac
  # 層級順序（觸發詞對應：派o＝default、派of＝free、派os＝sub）；沒給一律 default（預設＝派o，10-21 使用者定）：
  # 免費全敗會升到 opencode-go 訂閱層；只要免費的呼叫端自己帶 DCQ_ORDER=free
  case "$order" in default|free|sub) ;; *) die "DCQ_ORDER 只能是 default／free／sub：$order" ;; esac
  local id="$(date +%s)-$$-$(basename "${task%.md}")"
  printf 'TASK=%s\nCWD=%s\nTIER=%s\nORDER=%s\n' "$task" "$cwd" "$tier" "$order" > "$Q/pending/$id.job"
  [ -n "${DCQ_SPIN_S:-}" ] && echo "SPIN=$DCQ_SPIN_S" >> "$Q/pending/$id.job"   # 逐張關防空轉（唯讀工單帶 0）
  # 逐張預算（研究類長工單用，2026-10-21）：JOBMAX＝這張的總時限；SAT＝連續幾次嘗試 cwd 沒有新產出就停
  [ -n "${DCQ_JOB_MAX:-}" ] && echo "JOBMAX=$DCQ_JOB_MAX" >> "$Q/pending/$id.job"
  [ -n "${DCQ_SAT_N:-}" ] && echo "SAT=$DCQ_SAT_N" >> "$Q/pending/$id.job"
  echo "dcq: 難度 ${tier}，順序 $order" >&2
  echo "$id"
}

# --- 單一 job 執行：挑模型 + 盯梢 + exit code 分流 ----------------------------------
# dc 的 exit code 契約（不另發明）：
#   0   驗收全過
#   1   deep-lint 未過（add 時已擋）／上游掛 —— 執行期視為上游，可換模型重試
#   2   參數或契約錯 —— 工單本身壞掉，重試無意義
#   124 逾時 —— 可換模型重試
#   其他 驗收失敗行的 rc —— 模型做錯了，換模型再給一次機會
# GNU 在前：GNU `stat -f` 是查檔案系統，失敗前會先把 fs 資訊印到 stdout（BSD `stat -c` 失敗則 stdout 乾淨）
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || now; }
# $1（dc）底下的 opencode 有子程序＝工具正在跑（多半是測試），rc 0。
# 2026-10-21 實測：bash 工具是 opencode→/bin/zsh→指令；--pure 閒置時 opencode 沒有任何子程序。
# comm 可能是完整路徑（macOS），取 basename 比對。
oc_busy() {
  ps -Ao pid=,ppid=,comm= 2>/dev/null | awk -v root="$1" '
    { p[$1] = $2; n = $3; sub(/.*\//, "", n); c[$1] = n }
    END { for (x in p) { if (c[p[x]] != "opencode" && c[p[x]] != "opencode.exe") continue
            y = p[x]; while (y != root && (y in p) && y > 1) y = p[y]
            if (y == root) exit 0 }
          exit 1 }'
}
# 工作樹指紋：HEAD（模型自己 commit 也算有動）＋追蹤檔改動＋未追蹤檔內容
if stat -f %m / >/dev/null 2>&1; then STATFMT=(-f '%m %z %N'); else STATFMT=(-c '%Y %s %n'); fi
# 非 git cwd 用檔案 mtime＋大小當指紋，只給 slow 的進度判定用，spin 仍只看 git cwd。
# ponytail: 每 POLL_S 掃整個 cwd；cwd 很大（上萬檔）會吃 IO，屆時改成只掃 maxdepth 或改 fswatch。
tree_sig() {
  if git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    { git -C "$1" rev-parse HEAD; git -C "$1" diff HEAD
      (cd "$1" && git ls-files -o --exclude-standard -z | xargs -0 cat); } 2>/dev/null | _sha1 | cut -c1-16
  else
    find "$1" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -print0 2>/dev/null \
      | xargs -0 stat "${STATFMT[@]}" 2>/dev/null | sort | _sha1 | cut -c1-16
  fi
}

# 停滯時殺之前先匯出 opencode session（只診斷，不改判定）。STALL_S 調門檻只是止血（fix 10309）：
# 停滯都停在連續數個 Read 之後、log 無 ERROR、chunkTimeout=120s 也沒觸發，兩個假設待分辨——
# ① 隱藏 reasoning 持續送 chunk（最後一則 assistant 有 reasoning part、沒有 running 的 tool）
# ② 多工具呼叫漏派發（opencode#36804 變體：tool part 停在 running/pending）。
# 上游不回（2026-10-14）：整個 session 的 assistant 訊息全是 0 輸出 token、沒有任何 part＝模型一個字都沒收到。
# 成因多是免費額度用完時 opencode 每 3 秒靜默重試、不寫 log（anomalyco/opencode#45989，dc 的 429 log 攔截抓不到），
# 或上游排隊。10-07 big-pickle／muse／mimo／space-bunny 同時段全 0 輸出被當模型壞掉移出池，事後證實是誤判。
# watch_oc 記 why=upstream：照樣冷卻換模型，但 rank_free 不算進模型樣本。
zero_output() {  # $1=opencode export JSON；是＝rc 0
  jq -e '[.messages[] | select(.info.role == "assistant")] as $a
    | ($a | length) > 0 and all($a[]; (.info.tokens.output // 0) == 0 and ((.parts // []) | map(select(.type != "step-start")) | length) == 0)' "$1" >/dev/null 2>&1
}
# 存 <out 去掉 .out>.stall.json（遮罩、600）並把一行摘要印到 stderr 與 stalls.tsv。
# 找不到 session、opencode 失敗都只略過：診斷不能拖累派工。
stall_dump() {
  local out="$1" cwd="$2" ta="$3" model="$4" sid js sum
  [ "${DCQ_STALL_DUMP:-1}" = 1 ] || return 0
  js="${out%.out}.stall.json"
  sid=$(cd "$cwd" 2>/dev/null && timeout 20 opencode session list --format json -n 10 2>/dev/null \
    | jq -r --arg d "$(cd "$cwd" && pwd)" --argjson t "$(( ta * 1000 ))" \
      '[.[] | select(.directory == $d and .created >= $t)] | sort_by(.created) | last | .id // empty' 2>/dev/null)
  [ -n "$sid" ] || { echo "dcq: stall_dump 找不到 session（${model}）" >&2; return 0; }
  ( umask 077; cd "$cwd" && timeout 30 opencode export "$sid" > "$js" 2>/dev/null ) || { rm -f "$js"; return 0; }
  zero_output "$js" && STALL_UPSTREAM=1
  sum=$(jq -r '.messages[-1] as $m | [
      $m.info.role, ($m.info.time.completed != null),
      ([$m.parts[] | select(.type == "tool") | "\(.tool):\(.state.status)"] | join(",")),
      ([$m.parts[] | select(.type == "reasoning") | (.text // "" | length)] | add // 0)
    ] | @tsv' "$js" 2>/dev/null) || sum="unparsable"
  mask_file "$js" >/dev/null || true
  printf '%s\t%s\t%s\t%s\n' "$(date +%F_%T)" "$model" "$sid" "$sum" >> "$Q/logs/stalls.tsv"
  echo "dcq: stall_dump $model $sid 最後一則[role done tools reasoning字數]=${sum}" >&2
}

# 跑一隻模型並盯著它。印 "<rc> <why>"，why ∈ exit|stall|slow|spin|jobmax。
# 判活看 .out 的 mtime：opencode 每完成一個 part 就寫一行。dc 收尾的 wo-verify 期間
# 也算在內——驗收指令本身若靜默超過 STALL_S 會被誤判，STALL_S 要比最慢的驗收寬。
watch_oc() {
  local id="$1" model="$2" task="$3" cwd="$4" t0="$5" paid="$6" out pid rc why=exit gap maxgap=0 t ta
  local spin_s="${JOB_SPIN_S:-$SPIN_S}" sig="" sig_t s alive=0 tp chg_t=0
  ta=$(now)  # 這次嘗試的起點（t0 是整張工單的起點），算每隻模型實際花的秒數
  sig_t=$ta; tp=$ta
  git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 || spin_s=0
  sig="$(tree_sig "$cwd")"
  out="$Q/logs/$id.$(fk "$model").out"
  # 先建 600 空檔：底下的 `> "$out"` 只截斷不改權限，沒先建的話 .out 會吃預設 umask（644）
  ( umask 077; : > "$out" )
  # 鎖已由 claim_one 持有，告訴 dc 不要再拿一次。
  DC_FREE_MODEL="$model" DC_LOCK_HELD=1 dc "$task" "$cwd" > "$out" 2>&1 &
  pid=$!
  echo "$pid" > "$Q/running/$id.pid"
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$POLL_S"
    t=$(now)
    # 工具還在跑：算活著，stall 從工具結束起算、spin 不計這段，只剩 JOB_MAX／ATTEMPT_MAX。
    # 10-21 前模型自跑 164s 的測試沒輸出也沒改檔，被判 spin／slow（WO-1/2 二十個嘗試）。
    # 暫停上限＝opencode bash 逾時（dc 注入 300s），卡死的工具不會無限暫停。maxgap 也不計這段，免得墊高 STALL_S 校準。
    if oc_busy "$pid"; then alive=$t; sig_t=$(( sig_t + t - tp )); fi
    tp=$t
    gap=$(mtime "$out"); [ "$alive" -gt "$gap" ] && gap=$alive; gap=$(( t - gap ))
    [ "$gap" -gt "$maxgap" ] && maxgap=$gap
    s="$(tree_sig "$cwd")"
    [ "$s" != "$sig" ] && { sig=$s; sig_t=$t; chg_t=$t; }
    if [ "$gap" -ge "$STALL_S" ]; then why=stall
    elif [ $(( t - t0 )) -ge "$JOB_MAX" ]; then why=jobmax
    elif [ $(( t - ta )) -ge "$ATTEMPT_MAX" ] && { [ "$chg_t" = 0 ] || [ $(( t - chg_t )) -ge "$PROGRESS_S" ]; }; then why=slow
    elif [ "$spin_s" -gt 0 ]; then
      if grep -q '^dc: 驗收 → ' "$out" 2>/dev/null; then spin_s=0; continue; fi
      [ $(( t - sig_t )) -ge "$spin_s" ] || continue
      why=spin
      echo "dcq[$id] watchdog: $model 空轉（$(( t - sig_t ))s 沒改任何檔，cwd=${cwd}）" >&2
    else continue; fi
    echo "dcq[$id] watchdog: $model ${why}（${gap}s 無輸出／本次已跑 $(( t - ta ))s，整張 $(( t - t0 ))s），殺掉" >&2
    STALL_UPSTREAM=0; [ "$why" = stall ] && stall_dump "$out" "$cwd" "$ta" "$model"
    [ "$STALL_UPSTREAM" = 1 ] && { why=upstream; echo "dcq[$id] $model 整段 0 輸出，判上游不回（額度／排隊），不記模型的帳" >&2; }
    killtree "$pid"; break
  done
  wait "$pid" 2>/dev/null; rc=$?
  rm -f "$Q/running/$id.pid"
  # dc 提早結束的上游錯誤不是模型的錯（issue #8：10-24 起 ~240 筆額度錯誤記成 rc=1，Zen 免費全掉冷宮）。
  # quota＝額度用完，冷卻到重置；upstream＝限流／不可用／濫用閘，照舊短冷卻。兩者 rank_free 都不算樣本。
  if [ "$why" = exit ] && [ "$rc" = 1 ]; then
    if grep -q '^dc: 上游額度用完' "$out" 2>/dev/null; then why=quota
    elif grep -qE '^dc: (上游限流|上游不可用|Zen 免費閘道判濫用)' "$out" 2>/dev/null; then why=upstream; fi
  fi
  # 每次都記最大靜默間隔（STALL_S 的唯一校準依據）與這次嘗試的總秒數（自動重排的時間成本）
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%F_%T)" "$model" "$maxgap" "$rc" "$why" "$(( $(now) - ta ))" "${JOB_TIER:-}" >> "$Q/logs/gaps.tsv"
  # 模型標了工單瑕疵卻沒自己收手（多半又卡回去硬做），被 watchdog 殺掉：認那行走
  # 工單契約錯 rc=2，不 bump_fail、不換模型。gaps.tsv 照記 stall —— 停滯真的發生了，
  # 而且正是收緊 STALL_S 的校準依據，不該被這裡改寫掉。
  if [ "$why" = stall ] && grep '^DC_TASK_DEFECT:' "$out" 2>/dev/null | grep -qviE '^DC_TASK_DEFECT:[[:space:]]*(N/?A|none|無)([^[:alnum:]]|$)'; then rc=2; why=exit; fi
  # 跑完遮罩 .out（issue #5）。遮罩器會 console.log，stdout 必須丟掉——watch_oc 的
  # stdout 被 $(...) 收成 "<rc> <why>"，漏出來會打壞 run_job 的解析。
  # 遮罩不在或失敗只警告不中斷：fail loud，不 fail closed。
  local mwhy; mwhy="$(mask_file "$out")" || echo "dcq[$id] 警告：遮罩失敗（${mwhy}），${out} 保留原文" >&2
  echo "$rc $why"
}

# --- best-of-N（2026-10-25，/wheel 卡「弱模型降級改 best-of-N＋既有驗收」，Large Language Monkeys arXiv 2407.21787）---
# hard 工單在主免費層、強模型全冷卻（pick=COOL）時：不乾等、不先升付費，改同派 BON_N 隻 fit=easy 的免費模型，
# 各在自己的 git worktree（detached，從 cwd 的 HEAD 開）跑完整 dc（自己的前置檢查、K 次驗收），
# 第一隻 PASS 的改動套回 cwd、用本張的 pin 再驗一次才算過；其餘殺掉。全敗就照原階梯往下。
# 只在 cwd 是 git repo 根目錄、且乾淨（或是 dcq 自己的 worktree，可以 reset）時跑；每張工單只跑一次。
# ponytail: 候選同時佔 BON_N 個 dc 程序，不算進全域 JOBS（只受 per-model／per-provider 槽限）；
# 套回用 git apply，cwd 在候選跑的期間不會動（本 worker 持鎖），衝突＝本機錯，當全敗處理。
BON_N="${DCQ_BON_N:-3}"
bon_pick() {  # $1=本單試過的；印「model slot [pslot]」每行一隻，最多 BON_N 隻
  local m n=0 slot
  for m in $MODELS_hard; do
    case " $EASY_ONLY " in *" $m "*) ;; *) continue ;; esac
    case " $EASY_STRICT $1 " in *" $m "*) continue ;; esac
    [ "$(cool_left "$m")" = 0 ] && [ ! -e "$Q/.health/$(fk "$m").gone" ] || continue
    slot=$(take_slot "$m") || continue
    echo "$m $slot"; n=$((n + 1)); [ "$n" -ge "$BON_N" ] && break
  done
}
bon_run() {  # $1=id $2=task $3=cwd $4=t0 $5=tried $6=jobfile；PASS 印勝出模型、回 0
  local id="$1" task="$2" cwd="$3" t0="$4" picks k=0 m slot ps wt tc res win="" alive line
  local -a ms=() wts=() sls=() bps=()
  [ "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$cwd" && pwd -P)" ] || return 1
  git -C "$cwd" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 1
  if [ -n "$(git -C "$cwd" status --porcelain 2>/dev/null)" ]; then
    # 前面嘗試留下的半套：只有 dcq 自己的 worktree 可以清，使用者的 checkout 不碰
    [ "$(sed -n 's/^WT=//p' "$6")" = "$cwd" ] || { echo "dcq[$id] best-of-N 跳過：cwd 有未 commit 的改動" >&2; return 1; }
    git -C "$cwd" reset -q --hard && git -C "$cwd" clean -qfd || return 1
  fi
  picks="$(bon_pick "$5")"
  [ "$(printf '%s\n' "$picks" | grep -c .)" -ge 2 ] || {
    printf '%s\n' "$picks" | while read -r m slot ps; do [ -n "$m" ] && rmdir "$slot" ${ps:+"$ps"} 2>/dev/null; done
    echo "dcq[$id] best-of-N 跳過：沒冷卻的 fit=easy 候選不足 2 隻" >&2; return 1; }
  mkdir -p "$Q/.bon"
  while read -r m slot ps; do
    k=$((k + 1)); wt="$Q/.bon/$id.$k"; tc="$Q/.bon/$id.$k.task.md"
    git -C "$cwd" worktree add -q --detach "$wt" HEAD >/dev/null 2>&1 || { rmdir "$slot" ${ps:+"$ps"} 2>/dev/null; continue; }
    wt="$(cd "$wt" && pwd -P)"
    sed "s#$(re_esc "$cwd")#$(rp_esc "$wt")#g" "$task" > "$tc"
    ( DC_PREFLIGHT_DIR="$Q/.preflight/$id.bon$k" watch_oc "$id.bon$k" "$m" "$tc" "$wt" "$t0" 0 > "$wt.res" ) < /dev/null &
    ms+=("$m"); wts+=("$wt"); sls+=("$slot ${ps:-}"); bps+=($!)
  done <<<"$picks"
  [ "${#ms[@]}" -gt 0 ] || { echo "dcq[$id] best-of-N 跳過：git worktree add 失敗" >&2; return 1; }
  echo "dcq[$id] best-of-N：強模型全冷卻，同派 ${#ms[@]} 隻：${ms[*]}" >&2
  while :; do
    alive=0
    for k in "${!ms[@]}"; do
      res="$(cat "${wts[$k]}.res" 2>/dev/null)"
      [ -z "$res" ] && { kill -0 "${bps[$k]}" 2>/dev/null && alive=1; continue; }
      [ "$res" = "0 exit" ] && { win=$k; break 2; }
    done
    [ -e "$Q/.cancel/$id" ] && break
    [ "$alive" = 1 ] || break
    sleep 2
  done
  for k in "${!ms[@]}"; do
    [ "$k" = "$win" ] && continue
    [ -s "$Q/running/$id.bon$((k + 1)).pid" ] && killtree "$(cat "$Q/running/$id.bon$((k + 1)).pid")"
    kill "${bps[$k]}" 2>/dev/null
  done
  wait "${bps[@]}" 2>/dev/null
  # 被殺的 watch_oc 來不及刪自己的 pid 檔；留著的話 claim_one 看 running/ 非空，永遠不收工
  for k in "${!ms[@]}"; do rm -f "$Q/running/$id.bon$((k + 1)).pid"; done
  # 自己跑完的落選者照一般規則記帳；被殺的不算模型的錯
  for k in "${!ms[@]}"; do
    [ "$k" = "$win" ] && continue
    case "$(cat "${wts[$k]}.res" 2>/dev/null)" in
      *" upstream") cool_upstream "${ms[$k]}" ;;
      *" quota") cool_quota "${ms[$k]}" "$Q/logs/$id.bon$((k + 1)).$(fk "${ms[$k]}").out" ;;
      *" stall"|*" slow"|*" spin"|1" exit") bump_fail "${ms[$k]}" ;;
    esac
  done
  local ok=1
  if [ -n "$win" ]; then
    wt="${wts[$win]}"
    git -C "$wt" add -A >/dev/null 2>&1
    if git -C "$wt" diff --cached --binary HEAD | git -C "$cwd" apply --binary - 2>/dev/null \
       && jobmax_verify "$task" "$cwd" "$DC_PREFLIGHT_DIR"; then
      ok=0; reset_fail "${ms[$win]}"; echo "BON=${ms[$win]}" >> "$6"; echo "${ms[$win]}"
    else
      echo "dcq[$id] best-of-N：${ms[$win]} 在 worktree 過了，套回 cwd 後驗收不過，當全敗" >&2
      git -C "$cwd" reset -q --hard; git -C "$cwd" clean -qfd
    fi
  fi
  for k in "${!ms[@]}"; do
    git -C "$cwd" worktree remove --force "${wts[$k]}" >/dev/null 2>&1 || rm -rf "${wts[$k]}"
    rm -rf "${wts[$k]}.res" "$Q/.bon/$id.$((k + 1)).task.md" "$Q/.preflight/$id.bon$((k + 1))"
    rmdir ${sls[$k]} 2>/dev/null
  done
  git -C "$cwd" worktree prune >/dev/null 2>&1
  return "$ok"
}

run_job() {
  local jobfile="$1" id task cwd rc=0 why model slot tried="" n=0 t0 pick sig prevsig prevmodel
  local pool paid=0 pen=0 tail=0 zero=0 sub=0 cl=0 api=0 round=1 left vr=0 pslot pen_pool tail_pool zero_pool paid_pool cl_pool api_pool noretry="" bon=0 bm ran=0
  id="$(basename "$jobfile" .job)"
  task="$(sed -n 's/^TASK=//p' "$jobfile")"
  cwd="$(sed -n 's/^CWD=//p' "$jobfile")"
  # 2026-10-21 前置檢查憑證：同一張工單的每次嘗試共用一個目錄。
  # 為什麼：dc 每派一次工就重跑整套前置檢查（deep-lint ＋ do-nothing 對照，上限 120s），
  # 而且評分器是「當下」從工單重抽的 —— 前一隻模型若改過工單的驗收區塊，
  # 下一次重抽會把改過的版本釘成新基準（自己改自己過）。也不能用「第幾次嘗試」判斷
  # 有沒有驗過：lint 失敗是 exit 1（會被重試），watchdog 也可能在對照跑完前就殺掉 dc。
  # 第一次前置檢查全過的那次會把評分器快照（pin）留在這個目錄裡，後面換模型時
  # dc 直接沿用同一份：不重跑整套驗收，也不重抽評分器。工單結束（PASS／FAIL／取消）
  # 就刪掉 —— 憑證只對這一張工單有效。
  export DC_PREFLIGHT_DIR="$Q/.preflight/$id"
  mkdir -p "$DC_PREFLIGHT_DIR" 2>/dev/null
  # 難度（入列時判一次，中途不換）。JOB_TIER 是全域：watch_oc 寫 gaps.tsv 第 7 欄要用；每個 worker 是獨立 subshell
  JOB_TIER="$(sed -n 's/^TIER=//p' "$jobfile")"
  JOB_SPIN_S="$(sed -n 's/^SPIN=//p' "$jobfile")"
  # watch_oc 讀的是 JOB_MAX：這裡 local 覆寫，動態作用域讓它看到逐張值
  local JOB_MAX sat_n nonew=0 lastsig
  JOB_MAX="$(sed -n 's/^JOBMAX=//p' "$jobfile")"; JOB_MAX="${JOB_MAX:-$JOB_MAX_G}"
  sat_n="$(sed -n 's/^SAT=//p' "$jobfile")"; sat_n="${sat_n:-0}"
  lastsig="$(tree_sig "$cwd")"
  case "$JOB_TIER" in easy) pool="$MODELS_easy" pen_pool="$PEN_easy" zero_pool="$ZERO_easy" ;; hard) pool="$MODELS_hard" pen_pool="$PEN_hard" zero_pool="$ZERO_hard" ;;
    *) JOB_TIER=mid pool="$MODELS_mid" pen_pool="$PEN_mid" zero_pool="$ZERO_mid" ;; esac
  pool="$(fit_pool "$pool")"; pen_pool="$(fit_pool "$pen_pool")"; zero_pool="$(fit_pool "$zero_pool")"
  tail_pool="$(fit_pool "$POOL_TAIL")"; paid_pool="$(fit_pool "$POOL_PAID")"; api_pool="$(fit_pool "$POOL_API")"; cl_pool=""
  # ORDER：default＝免費→懲罰→兜底→訂閱→API；free＝只用免費的層；sub＝訂閱先，用盡才回免費的層，再 Claude 層，API 墊底
  local order free_main=""
  order="$(sed -n 's/^ORDER=//p' "$jobfile")"
  case "$order" in
    free|"") paid_pool="" api_pool="" ;;
    sub) cl_pool="$(fit_pool "$POOL_CLAUDE")"
      [ -n "$paid_pool" ] && { free_main="$pool"; pool="$paid_pool"; sub=1; paid=1; echo 'PAID=1' >> "$jobfile"; } ;;
  esac
  t0=$(now)

  while true; do
    # 人工中止不是模型失敗：沒有這個檢查，kill 掉 dc 只會讓階梯換下一個模型重跑
    # 同一張工單，工單永遠停不下來（issue #2）。
    [ -e "$Q/.cancel/$id" ] && { rc=130; break; }
    if [ $(( $(now) - t0 )) -ge "$JOB_MAX" ]; then
      if jobmax_verify "$task" "$cwd" "$DC_PREFLIGHT_DIR"; then
        mv "$jobfile" "$Q/done/$id.job"; rm -rf "$DC_PREFLIGHT_DIR"
        echo "dcq[$id] PASS（總時限 ${JOB_MAX}s 到，但驗收通過）model=$model" >&2; return 0
      fi
      rc=124; echo "dcq[$id] 超過總時限 ${JOB_MAX}s" >&2; break
    fi
    pick=$(pick_model "$tried" "$pool")
    case "$pick" in
      BUSY) sleep 2; continue ;;
      NONE|COOL*)
        # 免費層整輪試完：還有輪次就清空 tried 再來一輪（冷卻中的那幾隻會自動跳過）。
        # 本單已經真的跑過卻沒交件的（stall／slow／spin／驗收未過）不再試：第 2 輪只給上游失敗的。
        # 2026-10-22：免費層只剩 minimax 一隻時，wo-r1 同一隻連跑 245s＋1021s 才離開免費層。
        if [ "$paid" = 0 ] && [ "$pick" = NONE ] && [ "$round" -lt "$FREE_ROUNDS" ] && [ -n "$(not_in "$noretry" "$pool")" ]; then
          round=$((round + 1)); tried="$noretry"
          echo "dcq[$id] 免費層第 ${round} 輪重試" >&2; continue
        fi
        # hard 單、主免費層強模型全冷卻 → best-of-N 同派便宜模型（每張一次），全敗才照下面的階梯
        if [ "$bon" = 0 ] && [ "$paid" = 0 ] && [ "$JOB_TIER" = hard ] && [ "${pick%% *}" = COOL ] && [ "$BON_N" -ge 2 ]; then
          bon=1
          if bm="$(bon_run "$id" "$task" "$cwd" "$t0" "$tried" "$jobfile")"; then
            mv "$jobfile" "$Q/done/$id.job"; rm -rf "$DC_PREFLIGHT_DIR"
            echo "dcq[$id] PASS（best-of-N）model=$bm" >&2; return 0
          fi
          [ -e "$Q/.cancel/$id" ] && { rc=130; break; }
          echo "dcq[$id] best-of-N 沒有交件，照原階梯" >&2; continue
        fi
        # 免費輪次用完，或免費模型全在冷卻 → 先把免費的層用完：懲罰層（免費累犯）→ 兜底層，
        # 訂閱層（opencode-go，2026-10-07 起付費）墊底（2026-10-13 使用者定）。paid＝已離開主免費層。
        if [ -n "$free_main" ]; then
          pool="$free_main"; free_main=""; tried=""
          echo "dcq[$id] 訂閱層用盡（${pick%% *}），回免費層：${pool}" >&2; continue
        fi
        if [ "$pen" = 0 ] && [ -n "$pen_pool" ]; then
          pen=1; paid=1; pool="$pen_pool"; tried=""
          echo "dcq[$id] 免費層用盡（${pick%% *}），fallback 懲罰層（免費累犯）：${pen_pool}" >&2; continue
        fi
        if [ "$tail" = 0 ] && [ -n "$tail_pool" ]; then
          tail=1; paid=1; pool="$tail_pool"; tried=""
          echo "dcq[$id] 免費層用盡（${pick%% *}），fallback 兜底層：${tail_pool}" >&2; continue
        fi
        if [ "$zero" = 0 ] && [ -n "$zero_pool" ]; then
          zero=1; paid=1; pool="$zero_pool"; tried=""
          echo "dcq[$id] 兜底層用盡（${pick%% *}），fallback 冷宮（0 PASS 的免費模型）：${zero_pool}" >&2; continue
        fi
        if [ "$sub" = 0 ] && [ -n "$paid_pool" ]; then
          sub=1; paid=1; pool="$paid_pool"; tried=""; echo 'PAID=1' >> "$jobfile"
          echo "dcq[$id] 免費的層全用盡（${pick%% *}），fallback 訂閱層（付費）：${paid_pool}" >&2; continue
        fi
        if [ "$cl" = 0 ] && [ -n "$cl_pool" ]; then
          cl=1; paid=1; pool="$cl_pool"; tried=""; grep -q '^PAID=1' "$jobfile" || echo 'PAID=1' >> "$jobfile"
          echo "dcq[$id] 訂閱與免費的層全用盡（${pick%% *}），fallback Claude 層（訂閱額度）：${cl_pool}" >&2; continue
        fi
        if [ "$api" = 0 ] && [ -n "$api_pool" ]; then
          api=1; paid=1; pool="$api_pool"; tried=""; echo 'PAID=1' >> "$jobfile"
          echo "dcq[$id] 訂閱層也用盡（${pick%% *}），fallback API 層（按量扣錢）：${api_pool}" >&2; continue
        fi
        [ "$pick" = NONE ] && break
        left=${pick#COOL }; sleep $(( left < 30 ? left : 30 )); continue ;;
    esac
    set -- $pick; model=$2; slot=$3; pslot="${4:-}"
    tried="$tried $model"; n=$((n + 1))
    echo "dcq[$id] model=$model tier=$JOB_TIER" >&2
    set -- $(watch_oc "$id" "$model" "$task" "$cwd" "$t0" "$paid"); rc=${1:-}; why=${2:-}
    # watch_oc 中途死掉（dcq 自身腳本錯，10-24 Linux GNU stat 實例）會零輸出：判 FATAL 不換模型（換誰都一樣崩），
    # 收掉它留下的 dc 程序與 running 標記，免得工單永遠卡 running、拿不到結束碼
    if [ -z "$rc" ]; then
      [ -s "$Q/running/$id.pid" ] && killtree "$(cat "$Q/running/$id.pid")"; rm -f "$Q/running/$id.pid"
      rc=2; why=exit
      echo "dcq[$id] FATAL rc=2（watch_oc 沒交出結果：dcq 自身腳本錯，看上面的 bash 錯誤）" >&2
    fi
    rmdir "$slot" ${pslot:+"$pslot"} 2>/dev/null
    # 有跑到驗收的嘗試數：0＝全池都死在上游／卡住，沒有模型真的交件（呼叫端據此分基礎設施失敗與驗收失敗）
    ran=0; grep -q '^dc: 驗收 → ' "$Q/logs/$id.$(fk "$model").out" 2>/dev/null && { vr=$((vr + 1)); ran=1; }
    # I3：dc 在 log 印了 `dc: SCOPE=over` → 記進 job 檔（只標記不影響成敗），一張工單記一次
    if grep -q '^dc: SCOPE=over' "$Q/logs/$id.$(fk "$model").out" 2>/dev/null && ! grep -q '^SCOPE=over' "$jobfile" 2>/dev/null; then
      echo 'SCOPE=over' >> "$jobfile"; echo "dcq[$id] SCOPE=over：$model 改動了工單 writes 以外的檔（見 log）" >&2
    fi
    [ -e "$Q/.cancel/$id" ] && { rc=130; break; }
    # 模型下架（ProviderModelNotFound／deprecated）：加掃一次上游清單，下架的長冷卻，本單照常換下一隻
    if [ "$why:$rc" != exit:0 ] && grep -q -E "$GONE_RE" "$Q/logs/$id.$(fk "$model").out" 2>/dev/null; then
      gone_mark "$model"; rc=1
      echo "dcq[$id] $model 上游回下架，換下一個模型" >&2; continue
    fi
    case "$why:$rc" in
      exit:0) reset_fail "$model"
         mv "$jobfile" "$Q/done/$id.job"
         echo "dcq[$id] PASS model=$model" >&2
         rm -rf "$DC_PREFLIGHT_DIR"   # 前置檢查憑證只對這張工單有效，結案就收掉
         return 0 ;;
      # 總時限是工單的問題不是模型的：不罰模型、不再換
      jobmax:*) if jobmax_verify "$task" "$cwd" "$DC_PREFLIGHT_DIR"; then
           mv "$jobfile" "$Q/done/$id.job"; rm -rf "$DC_PREFLIGHT_DIR"
           echo "dcq[$id] PASS（總時限 ${JOB_MAX}s 到，但驗收通過）model=$model" >&2; return 0
         fi
         rc=124; break ;;
      upstream:*) rc=124; cool_upstream "$model"
         echo "dcq[$id] $model upstream，換下一個模型" >&2 ;;
      quota:*) rc=124; cool_quota "$model" "$Q/logs/$id.$(fk "$model").out"
         echo "dcq[$id] $model 額度用完，換下一個模型" >&2 ;;
      stall:*|slow:*|spin:*) rc=124; bump_fail "$model"; noretry="$noretry $model"
         echo "dcq[$id] $model ${why}，冷卻計數＋1，換下一個模型" >&2 ;;
      exit:2) echo "dcq[$id] FATAL rc=2（工單契約錯，不重試）" >&2
         break ;;
      exit:1|exit:124)
          # 本機確定性錯誤：不同模型連續兩次上游失敗且簽章相同 → 換誰都一樣，
          # 停階梯、不罰模型（issue #6）。空簽章永不相等——既有測試的假 dc 在
          # up* 不印上游錯，空簽章若算相同，免費全敗才升付費的案例會被誤判。
          sig="$(err_sig "$Q/logs/$id.$(fk "$model").out")"
          if [ -n "$sig" ] && [ "$sig" = "$prevsig" ] && [ "$model" != "$prevmodel" ]; then
            reset_fail "$prevmodel"
            rc=2
            echo "dcq[$id] FATAL rc=2（本機確定性錯誤：$prevmodel 與 $model 同錯）" >&2
            break
          fi
          bump_fail "$model"
          # dc 驗收未過也回 rc=1：有跑到驗收＝模型真的交過件，第 2 輪不再給它
          if [ "$ran" = 1 ]; then noretry="$noretry $model"; echo "dcq[$id] 驗收未過 rc=${rc}，換下一個模型" >&2
          else echo "dcq[$id] 上游失敗 rc=${rc}，換下一個模型" >&2; fi
          prevsig=$sig prevmodel=$model ;;
      *) noretry="$noretry $model"; echo "dcq[$id] 驗收未過 rc=${rc}，換下一個模型" >&2 ;;
    esac
    # 飽和停損（借鏡 /research「兩次無新證據即關閉缺口」）：模型真的跑了（slow／spin／驗收未過）
    # 但 cwd 跟上一次嘗試結束時一模一樣，連續 SAT 次就停，不再換模型燒時間。上游失敗不算。
    if [ "$sat_n" -gt 0 ]; then
      case "$why:$rc" in slow:*|spin:*|exit:[0-9]*) case "$why:$rc" in exit:1|exit:124) ;; *)
        s="$(tree_sig "$cwd")"
        if [ "$s" = "$lastsig" ]; then nonew=$((nonew + 1)); else nonew=0; lastsig=$s; fi
        [ "$nonew" -ge "$sat_n" ] && { rc=124; echo "dcq[$id] 飽和：連續 ${nonew} 次嘗試沒有新產出，停止" >&2; break; } ;;
      esac ;; esac
    fi
  done

  printf 'LAST_RC=%s\nTRIED=%s\nVERIFY_RUNS=%s\n' "$rc" "$n" "$vr" >> "$jobfile"
  if [ -e "$Q/.cancel/$id" ]; then
    echo 'CANCELLED=1' >> "$jobfile"
    rm -f "$Q/.cancel/$id"
    echo "dcq[$id] CANCELLED（不重試）" >&2
  else
    echo "dcq[$id] FAIL rc=${rc}（試過 $n 個模型：${tried# }）" >&2
  fi
  mv "$jobfile" "$Q/failed/$id.job"
  rm -rf "$DC_PREFLIGHT_DIR"   # 前置檢查憑證只對這張工單有效，結案就收掉（FAIL／取消都走這裡）
  return 1
}

# --- worktree 模式（2026-10-22，使用者定「同 repo 要併發」）--------------------------
# 同一個 cwd 的工單以前只能靠 .cwdlock 序列（頂端註解 #2：相對路徑驗收互汙）。乾淨的 git cwd
# 改成每張工單一個 git worktree：工單裡的 cwd 絕對路徑改寫成 worktree 路徑（10-08 教訓：模型照
# 絕對路徑寫回主 checkout，dc 的越界偵測會判 FATAL），鎖改鎖 worktree 路徑（必唯一，不再排隊），
# PASS 後在 worktree commit 再 merge 回主 checkout；衝突就 abort、留分支 dcq/<id> 給主 session。
# cwd 髒／非 repo 根目錄／還沒 commit → 照舊序列，log 說原因。DCQ_WORKTREE=0 整個關掉。
WORKTREE="${DCQ_WORKTREE:-1}"
re_esc() { printf '%s' "$1" | sed 's/[][\.*^$#\\]/\\&/g'; }   # s#..#..# 的 pattern 側：路徑裡的 . [ # 不當 regex
rp_esc() { printf '%s' "$1" | sed 's/[&#\\]/\\&/g'; }          # replacement 側只有 & # \ 要逃
# 不走 worktree 的原因印到 stdout；印空＝可以走
wt_reason() {
  local cwd="$1" top
  [ "$WORKTREE" = 1 ] || { echo "DCQ_WORKTREE=0"; return 0; }
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || { echo "cwd 不是 git repo"; return 0; }
  [ "$top" = "$(cd "$cwd" && pwd -P)" ] || { echo "cwd 不是 repo 根目錄"; return 0; }
  git -C "$cwd" rev-parse --verify -q HEAD >/dev/null 2>&1 || { echo "repo 還沒有 commit"; return 0; }
  [ -z "$(git -C "$cwd" status --porcelain 2>/dev/null)" ] || { echo "cwd 有未 commit 的改動"; return 0; }
}
# 收掉一個 worktree；$4=keep 保留分支（衝突時給人看），否則連分支一起刪
wt_drop() {
  local main="$1" wt="$2" id="$3"
  git -C "$main" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  git -C "$main" worktree prune >/dev/null 2>&1
  [ "${4:-}" = keep ] || git -C "$main" branch -D "dcq/$id" >/dev/null 2>&1
  rm -f "$Q/.wt/$id.task.md"
}
# 把 job 切到 worktree：TASK=／CWD= 改成 worktree 版，原值留在 TASK0=／CWD0=，WT= 標記。失敗回 1（呼叫端走序列）
wt_setup() {
  local job="$1" id="$2" cwd="$3" wt="$Q/.wt/$2" task tcopy
  task="$(sed -n 's/^TASK=//p' "$job")"; tcopy="$Q/.wt/$id.task.md"
  git -C "$cwd" worktree add -q "$wt" -b "dcq/$id" >/dev/null 2>&1 || return 1
  wt="$(cd "$wt" && pwd -P)"
  sed "s#$(re_esc "$cwd")#$(rp_esc "$wt")#g" "$task" > "$tcopy" || { wt_drop "$cwd" "$wt" "$id"; return 1; }
  { grep -v '^TASK=\|^CWD=' "$job"; printf 'TASK=%s\nCWD=%s\nTASK0=%s\nCWD0=%s\nWT=%s\n' "$tcopy" "$wt" "$task" "$cwd" "$wt"; } > "$job.tmp" \
    && mv "$job.tmp" "$job"
}
# 被殺的 runner 留下的 worktree job 搬回 pending 前還原成原工單（worktree 本身由 wt_gc 收掉，從頭重跑）
wt_restore_job() {
  local job="$1" t0 c0
  t0="$(sed -n 's/^TASK0=//p' "$job")"; c0="$(sed -n 's/^CWD0=//p' "$job")"
  [ -n "$t0" ] || return 0
  { grep -v '^TASK=\|^CWD=\|^TASK0=\|^CWD0=\|^WT=' "$job"; printf 'TASK=%s\nCWD=%s\n' "$t0" "$c0"; } > "$job.tmp" && mv "$job.tmp" "$job"
}
# 孤兒 worktree：沒有 running job 指到它的一律收掉（分支一起刪）
wt_gc() {
  local d id common main t
  for d in "$Q"/.wt/*/; do
    [ -d "$d" ] || continue; d="${d%/}"; id="$(basename "$d")"
    grep -qs "^WT=$d\$" "$Q"/running/*.job 2>/dev/null && continue
    common="$(cd "$d" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null)" || common=""
    [ -n "$common" ] && main="$(cd "$d" && cd "$common" && pwd -P)" && main="${main%/.git}" || main=""
    if [ -n "$main" ] && [ -d "$main/.git" ]; then wt_drop "$main" "$d" "$id"; else rm -rf "$d"; fi
  done
  for t in "$Q"/.wt/*.task.md; do [ -e "$t" ] && [ ! -d "${t%.task.md}" ] && rm -f "$t"; done
  # best-of-N 候選（.bon/<id>.<k>）：本張已不在 running 就收掉
  for d in "$Q"/.bon/*/; do
    [ -d "$d" ] || continue; d="${d%/}"; id="$(basename "$d")"; id="${id%.*}"
    [ -e "$Q/running/$id.job" ] && continue
    git -C "$d" worktree remove --force "$d" >/dev/null 2>&1 || rm -rf "$d"
    rm -f "$d.res" "$d.task.md"
  done
  return 0
}
# run_job 結束後：PASS → worktree 內 commit → 拿主 checkout 的 cwdlock → merge；衝突 abort、留分支。
# FAIL／取消 → worktree 與分支全丟（.out 還在 logs/）。非 worktree job 直接返回。
wt_finish() {
  local id="$1" rc="$2" job wt cwd0 h waited=0
  job="$Q/done/$id.job"; [ -e "$job" ] || job="$Q/failed/$id.job"; [ -e "$job" ] || return 0
  wt="$(sed -n 's/^WT=//p' "$job")"; [ -n "$wt" ] || return 0
  cwd0="$(sed -n 's/^CWD0=//p' "$job")"
  if [ "$rc" != 0 ]; then wt_drop "$cwd0" "$wt" "$id"; return 0; fi
  git -C "$wt" add -A >/dev/null 2>&1
  # 沒有改動也算 PASS（唯讀／報告類工單）：commit 失敗不是錯
  git -C "$wt" -c user.name=dcq -c user.email=dcq@localhost commit -qm "dcq $id" >/dev/null 2>&1 || true
  h="$(hash12 "$cwd0")"
  # 主 checkout 可能正被序列路徑的工單或直呼的 dc 佔著：等鎖，逾時就當衝突留分支
  while ! mkdir "$Q/.cwdlock/$h" 2>/dev/null; do
    if [ "$waited" -ge "${DCQ_WT_MERGE_WAIT:-600}" ]; then
      echo "dcq[$id] merge 等主 checkout 鎖逾時：主 checkout 不動，分支 dcq/$id 保留（衝突處理同）" >&2
      echo 'MERGE=conflict' >> "$job"; wt_drop "$cwd0" "$wt" "$id" keep; return 0
    fi
    sleep 1; waited=$((waited + 1))
  done
  echo $$ > "$Q/.cwdlock/$h/pid"
  if git -C "$cwd0" -c user.name=dcq -c user.email=dcq@localhost merge -q --no-edit "dcq/$id" >/dev/null 2>&1; then
    echo 'MERGED=1' >> "$job"; wt_drop "$cwd0" "$wt" "$id"
    echo "dcq[$id] 已 merge 回 $cwd0" >&2
  else
    git -C "$cwd0" merge --abort >/dev/null 2>&1
    echo 'MERGE=conflict' >> "$job"; wt_drop "$cwd0" "$wt" "$id" keep
    echo "dcq[$id] merge 衝突：主 checkout 不動，分支 dcq/$id 保留，請主 session 處理" >&2
  fi
  rm -rf "$Q/.cwdlock/$h"
}

# --- 搶單 ---------------------------------------------------------------------
# 同檔系統的 mv 是 atomic rename，兩個 worker 搶同一張只有一個 mv 成功 —— 這本身
# 就是鎖，不用另外再加一層。cwd 被別人佔就放回 pending 換下一張，不阻塞本 worker。
# 印 "JOB|<檔>|<hash>"、"WAIT"（還有事在跑但現在搶不到）或 "DRAIN"（真的沒事了）。
claim_one() {
  local f id cwd h why
  # 免費終止是全域事實，不是單張工單的問題：一有警報就全隊停止收單，
  # 已在跑的那張讓它跑完（殺掉會留半套產物，比跑完更難收拾）。
  [ -e "$Q/.ALARM" ] && { echo DRAIN; return 0; }
  for f in "$Q"/pending/*.job; do
    [ -e "$f" ] || break
    id="$(basename "$f" .job)"
    mv "$f" "$Q/running/$id.job" 2>/dev/null || continue
    cwd="$(sed -n 's/^CWD=//p' "$Q/running/$id.job")"
    # 乾淨的 git cwd → 切到自己的 worktree，鎖的是 worktree 路徑（必唯一）；否則照舊鎖 cwd 序列
    why="$(wt_reason "$cwd")"
    if [ -z "$why" ]; then
      if wt_setup "$Q/running/$id.job" "$id" "$cwd"; then
        cwd="$(sed -n 's/^CWD=//p' "$Q/running/$id.job")"
        echo "dcq[$id] worktree 模式：${cwd}（分支 dcq/${id}）" >&2
      else why="git worktree add 失敗"; fi
    fi
    h="$(hash12 "$cwd")"
    if mkdir "$Q/.cwdlock/$h" 2>/dev/null; then
      # pid 要寫：dc 也搶同一把鎖，看不到 pid 會把這把當孤兒清掉
      echo $$ > "$Q/.cwdlock/$h/pid"
      [ -n "$why" ] && echo "dcq[$id] 同目錄序列（${why}）：${cwd}" >&2
      echo "JOB|$Q/running/$id.job|$h"; return 0
    fi
    mv "$Q/running/$id.job" "$Q/pending/$id.job" 2>/dev/null
  done
  # 收工條件要同時看 running/：只看 pending 的話，所有 job 都在跑的那一瞬間
  # pending 是空的，worker 會誤判收工提早退場，把還在跑的 job 留成孤兒。
  if [ -z "$(ls -A "$Q/pending" 2>/dev/null)" ] && [ -z "$(ls -A "$Q/running" 2>/dev/null)" ]; then
    echo DRAIN
  else
    echo WAIT
  fi
}

worker() {
  local claim jobfile h rc cur
  while true; do
    # claim 前才檢查，job 進行中絕不打斷。新檔語法壞掉就不換（exec 進去 runner 會直接死），警告後以新 mtime 當基準。
    cur="$(mtime "$SELF_REAL")"
    if [ "$cur" != "$SELF_M0" ]; then
      if bash -n "$SELF_REAL" 2>/dev/null; then return 75; fi
      echo "dcq: 警告——bin/dcq 已更新但語法檢查失敗，繼續以舊碼執行" >&2; SELF_M0="$cur"
    fi
    claim="$(claim_one)"
    case "$claim" in
      DRAIN) return 0 ;;
      WAIT)  sleep 1; continue ;;
    esac
    jobfile="$(echo "$claim" | cut -d'|' -f2)"; h="$(echo "$claim" | cut -d'|' -f3)"
    run_job "$jobfile"; rc=$?
    wt_finish "$(basename "$jobfile" .job)" "$rc"
    rm -rf "$Q/.cwdlock/$h"
  done
}

cmd_run() {
  # .out 保留期限與權限（issue #5）：過期刪、剩下的收成 600。聚合檔（gaps.tsv 等）不動。
  find "$Q/logs" -name '*.out' -mtime +"$LOG_DAYS" -delete 2>/dev/null
  chmod 600 "$Q"/logs/*.out 2>/dev/null
  [ "$JOBS" -ge 1 ] 2>/dev/null || die "DCQ_JOBS 必須是正整數"
  # 上限硬夾 8：社群實測 1–5 並發穩定、10–32 崩，且官方只說 "traffic is monitored
  # for abuse" 沒給數字。衝高並發的期望值是被 ban 不是更快。
  [ "$JOBS" -le "$JOBS_MAX" ] || die "DCQ_JOBS=$JOBS 超過硬上限 $JOBS_MAX"
  # 同時只准一個 runner：下面的孤兒回收會把「活著的 runner 正在跑的 job」也搬回 pending，
  # 兩個 runner 就會同一張工單跑兩次。ponytail: 檢查與寫入非原子，兩個 run 同一毫秒啟動才會漏。
  local rp; rp="$(cat "$Q/.runner.pid" 2>/dev/null || true)"
  [ -n "$rp" ] && [ "$rp" != $$ ] && kill -0 "$rp" 2>/dev/null && die "dcq: 已有 runner 在跑（pid ${rp}）"
  echo $$ > "$Q/.runner.pid"; trap 'rm -f "$Q/.runner.pid"' EXIT
  # 上一輪被 kill 會留下孤兒：running/ 裡的 job 與沒人持有的 cwdlock。
  # ponytail: 無人重跑 run 就沒人清，開機時無腦全收；同時只准一個 dcq run 在跑。
  for f in "$Q"/running/*.job; do [ -e "$f" ] && { wt_restore_job "$f"; mv "$f" "$Q/pending/"; }; done
  rm -f "$Q"/running/*.pid 2>/dev/null
  wt_gc   # 上一輪的 worktree 現在都沒人指到：收掉，工單從頭重跑
  rm -rf "$Q"/.inuse/* 2>/dev/null   # 併發槽只屬於 dcq run，上一輪被殺留下的全是孤兒
  # 鎖現在是 dc 和 dcq 共用的：只清沒人持有的，別把別人正在跑的 dc 的鎖掃掉
  for l in "$Q"/.cwdlock/*; do
    [ -d "$l" ] || continue
    p="$(cat "$l/pid" 2>/dev/null || true)"
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && continue
    rm -rf "$l"
  done
  [ -n "$(ls -A "$Q/pending" 2>/dev/null)" ] || { echo "dcq: pending 是空的"; return 0; }
  [ -e "$Q/.ALARM" ] && die "dcq: 上一輪留下警報（$(cat "$Q/.ALARM")）。確認後刪掉 $Q/.ALARM 再跑"
  local FCK; FCK="$(dirname "$(readlink -f "$0")")/freecheck"
  # exit 5＝Go 額度窗受限：只有 opencode-go/* 不能派（dc 逐張回額度用完），其他免費模型照跑（10-25）
  if [ -x "$FCK" ]; then DCQ_HOME="$Q" "$FCK" $MODELS; case $? in 0) ;; 5) echo "dcq: Go 額度窗受限，opencode-go/* 這輪會被 dc 擋下，其他照跑" >&2 ;; *) die "dcq: 中止——freecheck 警報" ;; esac; fi
  echo "dcq: 起 $JOBS 個 slot，模型池：${MODELS}（每隻上限 ${MODEL_MAX}、停滯 ${STALL_S}s、總時限 ${JOB_MAX}s）" >&2
  local i
  local pids=() reload=0 p
  for i in $(seq 1 "$JOBS"); do worker & pids+=($!); done
  for p in "${pids[@]}"; do wait "$p"; [ $? -eq 75 ] && reload=1; done
  if [ "$reload" = 1 ]; then
    echo "dcq: 偵測到 bin/dcq 已更新，runner 以新版重啟" >&2
    exec "$0" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
  fi
  cmd_status
}

# --- cancel ------------------------------------------------------------------
# 先立標記再殺，順序不能反：反過來的話 run_job 會在看到標記前就把 rc 當模型失敗，
# 直接換下一個模型重跑。dc 是 bash 殼，殺它不會帶走 opencode，所以殺整棵樹。
killtree() {
  local p="$1" c
  for c in $(pgrep -P "$p" 2>/dev/null); do killtree "$c"; done
  kill -TERM "$p" 2>/dev/null || true
}
cmd_cancel() {
  local id="${1:-}" pidf pid
  [ -n "$id" ] || die "用法：dcq cancel <job-id>（id 見 dcq status）"
  [ -e "$Q/pending/$id.job" ] || [ -e "$Q/running/$id.job" ] || die "沒有這張在跑或待跑的工單：$id"
  : > "$Q/.cancel/$id"
  pidf="$Q/running/$id.pid"
  if [ -f "$pidf" ]; then
    pid="$(cat "$pidf")"
    killtree "$pid"
    echo "dcq: 已標記取消並殺掉 ${id}（pid=$pid 及子程序）"
  elif [ -e "$Q/pending/$id.job" ]; then
    # 還在 pending 且沒人在跑它：直接結案，不留一張永遠不會被收走的標記
    printf 'LAST_RC=130\nTRIED=0\nCANCELLED=1\n' >> "$Q/pending/$id.job"
    if mv "$Q/pending/$id.job" "$Q/failed/$id.job" 2>/dev/null; then
      rm -f "$Q/.cancel/$id"
      echo "dcq: 已取消 ${id}（還沒開跑，移到 failed）"
    else
      echo "dcq: 已標記取消 ${id}（剛好被 worker 搶走，worker 收到標記就會停）"
    fi
  else
    echo "dcq: 已標記取消 ${id}（running 但沒 pid，等 worker 收到標記就停）"
  fi
}

cmd_status() {
  local s
  for s in pending running done failed; do
    # 只算 .job：running/ 還放 .pid，全算的話 1 張在跑會顯示 running 2
    printf '%-8s %s\n' "$s" "$(ls -1 "$Q/$s" 2>/dev/null | grep -c '\.job$')"
  done
  [ -n "$(ls -A "$Q/failed" 2>/dev/null)" ] && {
    echo "--- failed ---"
    for f in "$Q"/failed/*.job; do
      echo "  $(basename "$f" .job)  $(sed -n 's/^LAST_RC=/rc=/p' "$f" | tr '\n' ' ')$(grep -q '^CANCELLED=1' "$f" && echo cancelled)"
    done
  }
  # worktree 模式 PASS 但沒合回主 checkout 的：分支還在，要人處理
  [ -n "$(grep -ls '^MERGE=conflict' "$Q"/done/*.job 2>/dev/null)" ] && {
    echo "--- merge 衝突（PASS 但未合回，分支保留）---"
    for f in $(grep -ls '^MERGE=conflict' "$Q"/done/*.job); do
      echo "  $(basename "$f" .job)  分支 dcq/$(basename "$f" .job) → $(sed -n 's/^CWD0=//p' "$f")"
    done
  }
  echo "--- models ---"
  local m left busy
  for m in $MODELS $POOL_PAID ${POOL_PEN:-} $POOL_TAIL ${POOL_ZERO:-} $POOL_API; do
    left=$(cool_left "$m"); busy=$(ls -1d "$Q/.inuse/$(fk "$m")".* 2>/dev/null | wc -l | tr -d ' ')
    printf '  %-32s busy=%s/%s %s\n' "$m" "$busy" "$MODEL_MAX" "$([ "$left" -gt 0 ] && echo "cooling ${left}s" || echo ok)"
  done
  return 0
}

# --- start -------------------------------------------------------------------
# dcq run 是呼叫端的子行程：Claude Code 主 session 收工會連 runner 一起 SIGTERM
# （2026-10-03 一晚連死兩次，工單卡在 running/）。start 把 runner 放進獨立 tmux server，
# 跟 deep-run 的 tmux -L deep 同一招。看進度用 status 或 logs/runner.log。
cmd_start() {
  command -v tmux >/dev/null || die "dcq start 需要 tmux"
  local sock="${DCQ_TMUX:-dcq}" self
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  tmux -L "$sock" has-session -t run 2>/dev/null && die "dcq: 已有 runner 在跑（tmux -L $sock attach -t run）"
  tmux -L "$sock" new-session -d -s run \
    "DCQ_HOME=$(printf %q "$Q") $(printf %q "$self") run -j $JOBS >> $(printf %q "$Q/logs/runner.log") 2>&1"
  echo "dcq: runner 已脫離 session（tmux -L ${sock}；log：$Q/logs/runner.log）"
}
# --- wait --------------------------------------------------------------------
# start 脫離後呼叫端拿不到完成訊號，agent 只能等人問才去看 status（2026-10-05）。
# wait 純 shell 睡眠迴圈、零 token：agent 用 run_in_background 跑它，結束時 harness 會叫回來。
# 不給 id 就等 pending+running 全空。rc：0 全過、1 有 failed、124 逾時。
cmd_wait() {
  local tmo="${DCQ_WAIT_MAX:-3600}" ids=() t0 id left rc=0
  while [ $# -gt 0 ]; do
    case "$1" in --timeout) tmo="$2"; shift 2 ;; *) ids+=("$1"); shift ;; esac
  done
  t0=$(date +%s)
  while :; do
    left=0
    if [ ${#ids[@]} -eq 0 ]; then
      [ -n "$(ls "$Q"/pending/*.job "$Q"/running/*.job 2>/dev/null)" ] && left=1
    else
      for id in ${ids[@]+"${ids[@]}"}; do
        [ -e "$Q/pending/$id.job" ] || [ -e "$Q/running/$id.job" ] && left=1
      done
    fi
    [ "$left" = 0 ] && break
    [ $(( $(date +%s) - t0 )) -ge "$tmo" ] && { echo "dcq wait: 逾時 ${tmo}s"; return 124; }
    sleep "${DCQ_POLL_S:-15}"
  done
  for id in ${ids[@]+"${ids[@]}"}; do
    if [ -e "$Q/done/$id.job" ]; then echo "PASS $id"
    elif [ -e "$Q/failed/$id.job" ]; then echo "FAIL $id $(sed -n 's/^LAST_RC=/rc=/p' "$Q/failed/$id.job" | tail -1)"; rc=1
    else echo "MISSING $id"; rc=1; fi
  done
  [ ${#ids[@]} -eq 0 ] && { cmd_status | sed -n 1,4p; [ -n "$(ls "$Q"/failed/*.job 2>/dev/null)" ] && rc=1; }
  return $rc
}
cmd_clear() { rm -f "$Q"/{pending,running,done,failed}/*.job "$Q"/logs/*.out "$Q"/running/*.pid 2>/dev/null; wt_gc; rm -rf "$Q"/.cwdlock/* 2>/dev/null; rm -rf "$Q"/.health/* "$Q"/.inuse/* "$Q"/.cancel/* "$Q"/.preflight/* 2>/dev/null; echo "dcq: 已清空"; }

# dcq help：觀念總覽，給每次從零開始的 agent 與人看，接著印 usage。只寫機制不寫模型名——名單看 dcq plan／rank。
cmd_help() {
  cat <<'EOF'
O（Orchestrator，repo dispatch-router）＝派工智慧路由。
一張工單 task.md → dc 用 `opencode run` 叫一隻模型去做 → 工單的驗收區塊（wo-verify）exit code 判成敗；
失敗就換下一隻，照「層」往下走。dcq＝多張工單的並發佇列；dc＝跑單張。

■ 派法（DCQ_ORDER，入列時寫進工單）
  派o    default（預設）  免費層 → 懲罰層 → 兜底層 → 冷宮 → 訂閱層（opencode-go，扣 Go 額度）
                          → API 層（只有 DCQ_ALLOW_API=1 才接，按量扣錢）
  派of   free             只走免費的層（免費／懲罰／兜底／冷宮），全敗就失敗，不升訂閱
  派os   sub              訂閱層先，用盡回免費的層，再 Claude 層（claude -p），API 墊底
  派deep （不經 dcq）      deep-run：OpenCode Go 訂閱的多步自主 agent，要沙箱外寫入／GH_TOKEN 時用

■ 免費層＝一層混排，全部走 opencode run
  成員：Zen（dc_id 無斜線，如 big-pickle）、opencode-go/*-free、google/、nvidia/、groq/、kilo/、openrouter/*:free。
  不按 provider 分先後：autorank 依 logs/gaps.tsv 的「每 PASS 秒數＋貝氏平滑」整層重排（dcq rank 看）。
  整層輪 DCQ_FREE_ROUNDS（預設 2）輪都敗、或全在冷卻，才往下一層。
  懲罰層＝停滯率高的累犯；冷宮＝0 PASS；7 天沒新樣本假釋回免費層。兜底層＝omniroute/*（本機已空）。

■ freepool 不是一層，是 kilo／openrouter 的免費保證閘
  兩家的零價名單每天會變。dc 派 kilo/*、openrouter/* 前讀上游價格目錄快取（24h，不打模型），
  現價非零或缺 :free 後綴就拒派；判不了也不派（fail-closed）。
  實打 kilo 只准 `freepool probe`（經 OmniRoute test-all 逐個、≤5 隻）：kilo 免 key 額度全帳號共用，
  併發探測會整批回 Free usage limit reached。

■ 難度與 fit
  dcq plan 由本機 Laya 判 easy／mid／hard。清冊 fit 欄：any 全派；easy＝hard 不派；easy-only＝只派 easy。

■ 正規流程
  1. 寫工單：單步、冪等、輸入給絕對路徑、含驗收區塊
  2. DCQ_ORDER=<序> dcq plan <task.md>                       預覽難度與會走的層（不入列）
  3. DCQ_ORDER=<序> dcq add <task.md> <cwd> <plan 判的難度>   記下 job id
  4. dcq start -j N                                           tmux 背景跑
  5. dcq wait <ids>                                           rc 0 全過／1 有失敗／124 逾時
  失敗看 dcq status 與 ~/.dcq/logs/。

■ 名單與每日維護
  模型清冊（唯一來源）catalog/models.tsv；provider 併發上限 catalog/providers.tsv。
  每天 06:00 oc-probe daily（只 M4，launchd local.opencode-probe）：Zen 上下架、Go 免費同步、
  freepool daily（刷價格目錄＋清冊漲價告警＋實打新零價 kilo 模型，記在 ~/.dcq/freepool-probed.json）。
  新模型只提議「可加入清冊」，人核准才加；M2 加 kilo 模型要同步補 ~/.config/opencode/opencode.json。
  健檢 dcq doctor [--fix]。

EOF
}
usage() {
  cat <<'EOF'
用法：
  dcq add <task.md 絕對路徑> [cwd] [easy|mid|hard]
                                     入列（跑 deep-lint + wo-verify --dry 准入閘）；沒給難度就由本機 Laya 判（bin/triage）
  dcq run [-j N]                     起 N 個 slot 併發跑到 pending 清空（預設 4，上限 8）
  dcq start [-j N]                   同 run，但放進獨立 tmux 脫離呼叫端（從 agent session 派工用這個）
  dcq status                         各狀態計數與失敗清單
  dcq plan <task.md>...              派工前預覽每張的難度與會走的層（不入列）
  dcq rescan                         抓 Zen 上游 /models 清單（零 token），上下架回灌名單與清冊
  dcq doctor [--fix]                 免費池健檢：各 provider 數、被剔出的模型（壞＝exit 1，刻意關閉＝略過）；--fix 印 opencode.json 補丁
  dcq rank [easy|mid|hard]           免費層排名統計（給難度＝只算該難度＋舊紀錄）
  dcq cancel <job-id>                取消一張工單（殺掉整棵程序樹，階梯不重試，移到 failed）
  dcq wait [id...] [--timeout S]     睡到這些工單結案（不給 id＝等佇列清空）；rc 0 全過／1 有失敗／124 逾時
  dcq clear                          清空佇列與日誌

環境變數：
  DCQ_HOME    佇列根目錄（預設 ~/.dcq）
  DCQ_JOBS    並發數（預設 4，硬上限 8）
  DCQ_CATALOG        清冊目錄（預設 repo 的 catalog/）：models.tsv 組各層預設名單，providers.tsv 給 provider 併發上限
  DCQ_POOL_GO        舊介面，有設才串在 ZEN 後（預設空，longcat 已併進清冊免費層）
  DCQ_POOL_ZEN       主池手排（預設＝清冊 billing=free、dc_id 無斜線的列，依列序；
                     實際順序由 autorank 依 gaps.tsv 重算，看 dcq rank）
  DCQ_MODELS         有設就整條覆寫兩個免費池（舊介面）
  DCQ_POOL_PAID      訂閱層（付費），免費／懲罰／兜底全用盡才用（預設＝清冊 billing=sub 有 dc_id 的列；
                     只准 opencode-go/ 前綴；設空字串＝永不動用）
  DCQ_POOL_TAIL      兜底層，免費與懲罰層用盡才用、排在訂閱層之前（預設＝清冊 billing=free、dc_id 有斜線的列；
                     設空字串＝不用）
  DCQ_ALLOW_API      1＝訂閱層後再接 API 層（清冊 billing=api 有 dc_id 的列，或 DCQ_POOL_API）；預設 0
  DCQ_TIER           dcq add 沒給難度時用這個（沒設＝mid）
  DCQ_TRIAGE         1＝沒給難度時問本機 Laya（bin/triage）判；預設 0 不問
  DCQ_ORDER          層級順序，入列時記進工單：free＝只用免費（派of）、default＝免費優先、全敗升訂閱（派o，未設時的預設）、sub＝訂閱優先（派os）
  DCQ_EASY_ONLY      hard 工單不派的模型（預設＝清冊 fit=easy）
  DCQ_EASY_STRICT    mid／hard 都不派的模型（預設＝清冊 fit=easy-only）
  DCQ_PROV_MAX       per-provider 併發上限，如 "zen=2 omniroute=3"（預設讀 providers.tsv）
  DCQ_FREE_ROUNDS    免費層整輪重試幾輪才升級訂閱層（預設 2）
  DCQ_MODEL_MAX      單一模型同時最多幾張（預設 3），滿了分給下一隻
  DCQ_ALLOWED_FAILS  單一模型連續幾次上游失敗／停滯就冷卻（預設 2；舊名 DCQ_BREAK_N）
  DCQ_COOLDOWN_S     冷卻秒數（預設 120；舊名 DCQ_BREAK_S）
  DCQ_AUTORANK       1＝每次啟動依 logs/gaps.tsv 自動重排免費層（預設）；0＝照手排。`dcq rank` 看統計
  DCQ_RANK_MIN       每隻至少幾筆樣本才參與重排（預設 10）；DCQ_RANK_WIN 只看最近幾筆（預設 30）
  DCQ_RANK_STALL_PCT 停滯率達幾 % 就降到懲罰層（免費層之後，預設 30）；DCQ_RANK_PAROLE_D 天沒新樣本假釋回免費層（預設 7）
  DCQ_RANK_ZERO_N    樣本達幾筆而 PASS 為 0 就直接降級，不等 DCQ_RANK_MIN（預設 3；0＝停用）
  DCQ_STALL_S        輸出靜默幾秒判定停滯並換模型（預設 200；校準看 logs/gaps.tsv，dcq rank 近邊會警告）
  DCQ_JOB_MAX        單張工單總時限秒數，含所有模型（預設 2700）
  DCQ_ATTEMPT_MAX    單隻模型一次嘗試的上限秒數，撞到就換下一隻（預設 600）
  DCQ_SPIN_S         防空轉：git cwd 的工作樹幾秒沒變就殺這次嘗試換下一隻（預設 420；進驗收後不看；0＝關。
                     入列時有設會記進工單，唯讀工單 dcq add 前帶 DCQ_SPIN_S=0）
  DCQ_MASK           .out 遮罩器（預設 repo 的 bin/mask-transcript.mjs）
  DCQ_LOG_DAYS       .out 保留幾天，過期刪（預設 14）
EOF
}
init
case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  run)    shift; [ "${1:-}" = "-j" ] && { JOBS="$2"; shift 2; }; cmd_run ;;
  start)  shift; [ "${1:-}" = "-j" ] && { JOBS="$2"; shift 2; }; cmd_start ;;
  plan)   shift; cmd_plan "$@" ;;
  status) cmd_status ;;
  doctor) shift; cmd_doctor "$@" ;;
  rank)   shift; rank_free "${MODELS_MANUAL:-$MODELS}" table "${1:-}"; echo "名單同步：${SYNC_NOTE:-無變動}"; echo "兜底層：$POOL_TAIL"; echo "訂閱層：$POOL_PAID"; echo "Claude 層（只派os）：${POOL_CLAUDE:-無}"; echo "API 層：${POOL_API:-（關，DCQ_ALLOW_API=1 才開）}"; echo "hard 不派：${EASY_ONLY:-無}"; echo "mid 不派：${EASY_STRICT:-無}"; echo "provider 上限：${PROV_MAX:-無}" ;;
  rescan) RESYNC_MIN_S=0 zen_resync "每日清單掃" ;;
  sync-catalog) shift; SYNC_ADD_ZEN="$SYNC_ADD_ZEN" SYNC_ADD_SUB="$SYNC_ADD_SUB" SYNC_ADD_GOFREE="$SYNC_ADD_GOFREE" SYNC_RM="$SYNC_RM" \
                python3 "$(dirname "$(readlink -f "$0")")/catalog-sync" "$CAT/models.tsv" "$@" ;;
  cancel) shift; cmd_cancel "$@" ;;
  wait)   shift; cmd_wait "$@" ;;
  clear)  cmd_clear ;;
  help|-h|--help) cmd_help; usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
exit
}
