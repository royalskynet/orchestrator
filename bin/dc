#!/usr/bin/env bash
{ # 整檔包成一個複合指令：bash 先讀完整段才執行，執行中被改寫（git pull、dc 改自己）不會用舊偏移讀到碎片（fix 9499）
# dc <task.md> [cwd] [-- <opencode run 原生旗標>...] — 派工給 opencode，完成定義＝wo-verify 通過。
#
# 就是 opencode run 的薄封裝。不另建工具鏈，不做 deep-run 那套：
# 不需要 tmux detach、不需要 sandbox proxy 偵測、不需要獨立 CLAUDE_CONFIG_DIR ——
# 那些都是 deep-run 為了「沙箱外執行」付的代價，dc 走 opencode 客戶端路徑沒這些問題。
#
# 計費分級（見 tier()）：非免費照派但發 TG。做在這裡而不是 opencode config：config 是共用的，
# 且登入後 opencode models 會連付費模型一起列。
#
# 三個原生旗標是實測必要的，不是包裝癖：
#   --auto   config 的 permission.bash="ask" 在 headless 下會被自動拒絕 —— 沒有 --auto
#           模型一跑 bash 就死（連 ls 都過不了），只能靠 write/edit 硬寫，實際上等於廢。
#           執行人本來就要能跑 bash 與驗收，故預設開；DC_NO_AUTO=1 可關（會嚴重降能）。
#   --pure   同一模型 4.5s vs 16s（agentpet.js 外掛佔 ~11s）；opencode v2 已移除，dc 依版本自動不帶
#   -f       任務檔常在專案外，cd 進工作目錄（1.18.x 另帶 --dir）並以 -f 附加，否則模型讀不到任務內容
set -u

# dc 認可的免費模型。suffix 規則（*-free）自動涵蓋未來新增的免費模型；
# big-pickle 無 -free 後綴故明列。DC_FREE_EXTRA 可補白名單。
DC_FREE_UNLISTED="big-pickle"
# 2026-10-09 依 gaps.tsv（75 筆真實工單）改：longcat 19 跑 9 停滯（40%）、471 s/pass，
# 是池裡最差的一隻；space-bunny 25 跑 21 PASS（84%）、85 s/pass，為當日 dcq autorank 首位。
# dc 單張沒有池也沒有 fallback，預設挑錯等於四成機率白等 STALL_S。
DEFAULT_FREE="minimax-m3.1-flash-free"  # 10-19 由 space-bunny-free 改名（@opencode 推文）。Zen 免費池（Go 版 2026-10-07 改付費，故不帶 opencode-go/ 前綴）
# 預設已不在清冊的 Zen 現役名單（catalog-sync 回寫下架後）→ 改用清冊第一隻 Zen 免費，免得單張派工打到下架模型。
DC_CATALOG="${DC_CATALOG:-$(dirname "$(readlink -f "$0")")/../catalog/models.tsv}"
if [ -r "$DC_CATALOG" ]; then
  _zen="$(awk -F'\t' '!/^#/ && $1=="free" && $7!="" && index($7,"/")==0 { print $7 }' "$DC_CATALOG")"
  [ -z "$_zen" ] || printf '%s\n' "$_zen" | grep -qxF "$DEFAULT_FREE" || DEFAULT_FREE="$(printf '%s\n' "$_zen" | head -1)"
fi
is_free() {
  case "$1" in big-pickle) return 0 ;; esac
  case "$1" in *-free) return 0 ;; esac
  for e in ${DC_FREE_EXTRA:-}; do [ "$e" = "$1" ] && return 0; done
  return 1
}
# 計費分級跟 provider 無關：free / sub（扣訂閱額度）/ metered（按量計費，或沒查過的組合）。
# 只分級不擋：非 free 照派，但先發 TG 警示，讓花錢這件事一定有人看到。
# *-free 只在 opencode 系才算數——別家路由器的組合名帶 -free（omniroute/auto/best-free）不保證成員全免費。
tier() {
  case "$1" in
    # 成員 big-pickle→agnes→openrouter/free 全免費（2026-10-02 查 omniroute combos 表；
    # nim-pool 卡死已移出；建置見 fix 0432）。組合改了要重查。
    omniroute/free-tools) echo free ;;
    # dcq 兜底層：OpenRouter 免費池與 Agnes 免費帳號（2026-10-07 查 omniroute connections）。
    # go-free：Go 免費 longcat／beam／minimax＋nim-pool（2026-10-20 查 combos 表；Zen 閘外的另一條免費路）。
    # nim-pool：NVIDIA NIM 免費 gpt-oss-20b／nemotron-super／glm-5.3-flash／ultra，兩把 key（2026-10-20 查 combos 表；OmniRoute 移除 OC 後的免費主路）。
    # agnes：2026-10-20 上游下架 agnes-2.0-flash／1.5-flash 整代，免費改成 3.0-flash／2.5-flash（pricing 頁現價 $0）。
    omniroute/or-free|omniroute/go-free|omniroute/nim-pool|omniroute/openai-compatible-chat-agnes/agnes-3.0-flash) echo free ;;
    # 無 OmniRoute 機器的直連兜底（2026-10-24）：openrouter/free 只路由 :free 模型；NIM 免費額度（build.nvidia.com）。
    openrouter/openrouter/free|nvidia/z-ai/glm-5.3-flash|nvidia/openai/gpt-oss-20b) echo free ;;
    # 2026-10-24：Kilo Gateway 免 key 只放 :free；AI Studio key 的專案沒開 billing（pro 系列一律 429 quota），flash 走免費層。
    # 那個 Google 專案若開了 billing，google/* 就會按量計費，這行要改回 metered。
    kilo/*:free|google/gemini-*flash*) echo free ;;
    opencode/*|opencode-go/*) if is_free "${1#*/}"; then echo free; elif [ "${1%%/*}" = opencode-go ]; then echo sub; else echo metered; fi ;;
    */*) echo metered ;;
    *) if is_free "$1"; then echo free; else echo metered; fi ;;
  esac
}

f=""; d="$PWD"; agent=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent="${2:?--agent 需要值}"; shift 2 ;;
    --) shift; break ;;
    -*) echo "dc: 未知選項 ${1}（要傳給 opencode run 的用 -- 隔開）" >&2; exit 2 ;;
    *) [ -z "$f" ] && f="$1" || d="$1"; shift ;;
  esac
done
case "$f" in /*) ;; *) echo "dc: task 路徑必須是絕對路徑：${f}" >&2; exit 2 ;; esac
[ -f "$f" ] || { echo "dc: task 檔不存在：${f}" >&2; exit 2; }
[ -d "$d" ] || { echo "dc: cwd 不存在：${d}" >&2; exit 2; }
# 正規化成和 dcq 的 CWD= 同一寫法（cd+pwd），否則 hash 不同＝鎖不到同一把
d="$(cd "$d" && pwd)"
command -v opencode >/dev/null || { echo "dc: opencode 不在 PATH" >&2; exit 2; }
# provider.opencode 覆寫 baseURL → 全模型 405（fixindex 9775）；rc=2 讓 dcq 不空轉整條模型階梯
OCJ="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
if [ -f "$OCJ" ] && command -v jq >/dev/null && jq -e '.provider.opencode.options.baseURL?' "$OCJ" >/dev/null 2>&1; then
  echo "dc: 中止——${OCJ} 有 provider.opencode.options.baseURL 覆寫，會 405（fixindex 9775），刪掉該 provider 區塊" >&2; exit 2
fi

# wo-verify／deep-lint 用 repo 自帶的那份（bin/ 同目錄），不走 PATH：PATH 上的 wo-verify
# 是 deepclaude 的 symlink，dc 與 deepclaude 互不依賴。DC_BIN 只給測試注入假閘用。
OCBIN="${DC_BIN:-$(dirname "$(readlink -f "$0")")}"
WV="$OCBIN/wo-verify"; DL="$OCBIN/deep-lint"
[ -x "$WV" ] || { echo "dc: 找不到 wo-verify：${WV}" >&2; exit 2; }

# --- 前置檢查憑證（DC_PREFLIGHT_DIR）-------------------------------------------
# 2026-10-21：dc 每派一次工就重跑整套前置檢查（deep-lint ＋ do-nothing 負向對照，
# 對照上限 120s），評分器也是「當下」從工單重抽的 —— 前一隻模型若改過工單的驗收區塊，
# 下一次重抽會把改過的版本釘成新基準（自己改自己過）。也不能用「第幾次嘗試」判斷有沒有驗過：
# lint 失敗是 exit 1（會被重試），watchdog 也可能在對照跑完前就殺掉 dc。
# 憑證＝第一次前置檢查全過時留下的評分器快照：同一張工單的後續嘗試沿用同一份評分器，
# 不重跑 lint 與負向對照；工單當下的驗收區塊照舊跟它比對，不一致照樣 exit 3。
# 沒設這個變數時行為完全不變（下面每一段都留著舊路徑）。
pf_dir="${DC_PREFLIGHT_DIR:-}"
pf_pin=""
[ -n "$pf_dir" ] && [ -f "$pf_dir/pin" ] && pf_pin="$pf_dir/pin"

# 沒有可跑的驗收區塊就不派工：模型做完也無法判定成敗，等於燒時間換一個不知道對不對的結果。
# 有憑證就不重跑 lint：第一次已經過了，再跑一次只是讓換模型的嘗試白等。
lint_ok=0
if [ -z "$pf_pin" ] && [ "${DC_SKIP_LINT:-0}" != 1 ] && [ -x "$DL" ]; then
  "$DL" "$f" || { echo "dc: deep-lint 未過（DC_SKIP_LINT=1 可強制派工）" >&2; exit 1; }
  lint_ok=1
fi
"$WV" "$f" --dry >/dev/null 2>&1 || { echo "dc: 驗收區塊語法錯，wo-verify --dry 失敗" >&2; exit 2; }

# --- 評分器釘住（pin）：派工前先把驗收腳本抽出來存一份 ------------------------
# 工單檔在執行人手上，驗收區塊也在裡面：他改得到的評分器，他早晚會改到過關
# （fixindex 0372 §4 偽造 git status、0373 在 fixsnap 植入刪檔後門 + 偽造註解）。
# executor-rules.md 第 8 條「不修改驗收區塊」是提示詞，本機實測 Documentation 層
# 符合率 ≈ 0%。這裡改成機械偵測：驗收跑 pin 這份，並比對工單當下的版本，不一致 exit 3。
# pintmp＝這次自己抽的暫存檔（EXIT 時刪）；pin＝要餵給 wo-verify --pinned 的那份。
# 有前置檢查憑證就沿用憑證（不重新 --dump：重抽等於把前一隻模型改過的驗收區塊
# 釘成新基準）；憑證本身不能被 EXIT trap 刪掉，所以刪的對象是 pintmp 不是 pin。
pintmp="$(mktemp)" || { echo "dc: mktemp 失敗（pin）" >&2; exit 2; }
trap 'rm -f "$pintmp"' EXIT
if [ -n "$pf_pin" ]; then
  pin="$pf_pin"
  echo "dc: 沿用本單前置檢查憑證" >&2
else
  pin="$pintmp"
  "$WV" "$f" --dump > "$pintmp" || { echo "dc: 抽不出驗收區塊（wo-verify --dump 失敗）" >&2; exit 2; }
fi

# --- do-nothing 負向對照：驗收必須在未動工前失敗 -----------------------------
# 一個「什麼都不做也會通過」的驗收不是驗收。派工前在同一個 cwd 跑一次 pin，
# 預期非零；若此刻就通過，代表驗收是空包彈或工單本身是 no-op，派下去只會
# 拿到一個不知道對不對的 PASS。驗收規則本來就要求唯讀，所以提前跑是安全的。
# 逃生門：確認既有狀態型的工單寫一行 `NEG-CONTROL: n/a`，或 DC_NEGCTL=0。
# 有前置檢查憑證就不重跑：這張工單已經對照過一次，再跑只是白等 120s。
negctl_ok=0
if [ -z "$pf_pin" ] && [ "${DC_NEGCTL:-1}" = 1 ] && ! grep -q '^NEG-CONTROL: *n/a' "$f"; then
  if ( cd "$d" && WO_VERIFY_TIMEOUT="${DC_NEGCTL_TIMEOUT:-120}" "$WV" "$f" --pinned "$pin" >/dev/null 2>&1 ); then
    echo "dc: 中止——驗收在未動工前就通過（do-nothing 對照失敗）。" >&2
    echo "    驗收是空包彈、或工單要求的狀態已經存在。確認既有狀態型的工單請加一行 NEG-CONTROL: n/a；" >&2
    echo "    要強制派工用 DC_NEGCTL=0。cwd=${d} task=${f}" >&2
    exit 2
  fi
  negctl_ok=1
fi

# --- 前置檢查憑證：閘都過了才留 ------------------------------------------------
# lint 或負向對照沒過、或中途被殺（watchdog 可能在對照跑完前就殺掉 dc），
# 都不能留下 pin：留下來下一次就會拿「沒驗過」的評分器當基準。
# 用 DC_SKIP_LINT／DC_NEGCTL／NEG-CONTROL: n/a 關掉某一關時不算「通過」，
# 那就不留憑證（維持舊行為：每次都重跑閘）。
if [ -n "$pf_dir" ] && [ -z "$pf_pin" ] && [ "$lint_ok" = 1 ] && [ "$negctl_ok" = 1 ]; then
  pftmp=""
  if mkdir -p "$pf_dir" 2>/dev/null; then
    pftmp="$(mktemp "$pf_dir/.pin.XXXXXX" 2>/dev/null || true)"
    if [ -n "$pftmp" ] && cp "$pintmp" "$pftmp" 2>/dev/null && mv "$pftmp" "$pf_dir/pin" 2>/dev/null; then
      pftmp=""
    fi
  fi
  [ -z "$pftmp" ] || rm -f "$pftmp"
  [ -f "$pf_dir/pin" ] || echo "dc: 寫不了前置檢查憑證（不影響派工）：${pf_dir}" >&2
fi

# 未指定模型就釘死預設免費模型（不讓 opencode config 的 per-agent 付費 model 生效）；
# 有指定則沿用（已驗證是免費）。
# DC_FREE_MODEL 含 "/" 時當完整 provider/model 用（例如 opencode-go/space-bunny-free），
# 否則補預設 provider 前綴。Go lane 的免費模型走前者。
have_m=0; m=""
prev=""
for a in "$@"; do
  case "$prev" in -m|--model) m="$a" ;; esac
  case "$a" in
    -m|--model) have_m=1; prev="$a" ;;
    --model=*)  have_m=1; m="${a#--model=}"; prev="" ;;
    *) prev="" ;;
  esac
done
if [ "$have_m" != 1 ]; then
  m="${DC_FREE_MODEL:-$DEFAULT_FREE}"
  case "$m" in */*) ;; *) m="opencode/$m" ;; esac
  set -- -m "$m" "$@"
fi
# Zen 免費閘道判濫用（2026-10-18：opencode 蒸餾攻擊事件後收緊）：被判一次就整個 Zen 免費池停用
# ZEN_GATE_S，所有佇列共用（同一個出口 IP）。被擋後換模型連打正是濫用特徵，故不換 Zen 模型重試。
# 10-18 起另一種措辭：IP 判濫用（"detected abusive traffic from this IP address"），連官方客戶端也擋。
# 10-18 第三種：FreeTierError（"free tier can only be used from within OpenCode"），官方客戶端整個 IP 一起中（fix 10685）。
# 以前不認，被擋期間 dc 照打：10-18 19 時一小時 74 次請求全 403，正是「被擋後換模型連打」。
# 只認 opencode 自己的錯誤行（level=ERROR log／終端 Error:），模型輸出的原始碼或文件不算；首字母 [] 防本行比中自己。
ABUSE_RE='(level=ERROR|Error: ).*([D]etect Abuse Traffic|[d]etected abusive traffic|[f]ree tier can only be used from within OpenCode)'
ZEN_GATE="${DC_ZEN_GATE:-$HOME/.dcq/.zen-gate}"
ZEN_GATE_S="${DC_ZEN_GATE_S:-21600}"
# 10-19：閘有兩份（本檔與 Jev 的 zen-free-status.json），讀寫一律經 zen-gate 取聯集，見該檔頭
ZG="$(dirname "$(readlink -f "$0")")/zen-gate"
case "$m" in opencode/*)
  gl=$(( $("$ZG" until 2>/dev/null || echo 0) - $(date +%s) ))
  [ "$gl" -gt 0 ] && { echo "dc: Zen 免費閘道判濫用冷卻中（剩 ${gl}s），不送請求；要跑請用 dcq（自動走兜底層）或指定非 Zen 模型" >&2; exit 1; } ;;
esac
t="$(tier "$m")"
if [ "$t" != free ]; then
  msg="⚠️ dc 派工用到非免費模型：${m}（${t}）task=$(basename "$f") cwd=${d}"
  echo "dc: WARN ${msg}" >&2
  # TG 可能送不出去（hpush 失敗只會默默消失），所以一定先落一行本機帳
  BL="${DCQ_HOME:-$HOME/.dcq}/logs"
  mkdir -p "$BL" && printf '%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$t" "$m" "$f" >> "$BL/billing.tsv"
  # TG 限流：DC_TG_EVERY 秒（預設 600）內只發一則，其餘只落帳；下一則附上期間被壓掉的筆數。
  # 戳記檔記上次發送時 billing.tsv 的行數。
  # ponytail: 併發 dc 讀同一戳記有競態，最壞多發一則，不值得上鎖
  ST="$BL/.billing-tg-last"; now=$(date +%s); n=$(wc -l < "$BL/billing.tsv" | tr -d ' ')
  last=$(stat -c %Y "$ST" 2>/dev/null || stat -f %m "$ST" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge "${DC_TG_EVERY:-600}" ]; then
    prev=$(cat "$ST" 2>/dev/null || echo "$((n - 1))"); skipped=$((n - 1 - prev))
    [ "$skipped" -gt 0 ] && msg="${msg}（另有 ${skipped} 筆被限流，見 billing.tsv）"
    echo "$n" > "$ST"
    # 背景送：TG 慢或掛了都不該拖住派工。帳目錄不是正式路徑（測試把 DCQ_HOME 指到暫存）不推，DC_PUSH=1 強制推（同 zen-gate）
    { [ "${DC_PUSH:-}" = 1 ] || [ "$BL" = "$HOME/.dcq/logs" ]; } && command -v hpush >/dev/null && { hpush "$msg" >/dev/null 2>&1 & }
  fi
fi

# opencode-go 要兩樣東西才會出現：本機 opencode.json 的 enabled_providers 有列它、
# 以及 env 的 OPENCODE_API_KEY（它不沿用 auth.json 裡 opencode 的憑證，2026-10-02 實測）。
# 只在這次呼叫臨時注入，不改使用者的 config —— 改了的話所有工具都會看到付費模型。
case "$m" in opencode-go/*)
  ep="$(opencode debug config 2>/dev/null | jq -c '(.enabled_providers // empty) + ["opencode-go"] | unique' 2>/dev/null)"
  [ -n "$ep" ] && export OPENCODE_CONFIG_CONTENT="{\"enabled_providers\":${ep}}"
  [ -n "${OPENCODE_API_KEY:-}" ] || OPENCODE_API_KEY="$(jq -r '.opencode.key // empty' "${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json" 2>/dev/null)"
  export OPENCODE_API_KEY
  [ -n "$OPENCODE_API_KEY" ] || { echo "dc: opencode-go 需要 OPENCODE_API_KEY，auth.json 也沒有 opencode 憑證" >&2; exit 2; }
esac

# 執行人不讀主 session 的 ~/.claude（CLAUDE.md ＋ skills）：每輪多讀約 1.08 萬 token，那套規則又是寫給主 session 的，會誤導執行人。
# 實測同一句 prompt 輸入 21.6k → 7.2k token（關讀 ＋ permission.skill=deny 一起上）。官方文件：https://opencode.ai/docs/rules 、https://opencode.ai/docs/cli
# $0 可能是 symlink（install.sh link 到 ~/.local/bin/dc），readlink -f 跟到 repo 實體路徑。
export OPENCODE_DISABLE_CLAUDE_CODE=1
# opencode bash 工具預設 120s 就砍指令（1.18.35 原始碼 `bashDefaultTimeoutMs ?? 120000`，旗標 10-21 實測生效）。
# 模型自跑慢測試（dcq_test 實測 164s）被砍後會重跑同一條，撞 dcq 的 spin／slow（10-21 WO-1/2 二十個嘗試）。
# 300s ≈ 164s×1.8。dcq watchdog 在工具跑時暫停 stall／spin，暫停時間的上限就是這個值。
export OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS="${OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS:-300000}"
_cc="${OPENCODE_CONFIG_CONTENT:-}"; [ -n "$_cc" ] || _cc='{}'
# 用 jq 深度合併（*）而不是整份覆蓋：opencode-go 分支剛設進來的 enabled_providers 不能被蓋掉。
_cc="$(printf '%s' "$_cc" | jq -c --arg f "$(dirname "$(dirname "$(readlink -f "$0")")")/executor-rules.md" '. * {permission:{skill:"deny"}, instructions:[$f]}' 2>/dev/null)"
[ -n "$_cc" ] || { echo "dc: OPENCODE_CONFIG_CONTENT 不是合法 JSON，無法合併 permission.skill=deny 與 executor-rules.md" >&2; exit 2; }
export OPENCODE_CONFIG_CONTENT="$_cc"

# opencode.json 的 omniroute apiKey 是 {env:OMNIROUTE_API_KEY}，沒設就送空 key → 401（fix 9775 §12）
case "$m" in omniroute/*)
  [ -n "${OMNIROUTE_API_KEY:-}" ] || OMNIROUTE_API_KEY="$(cat "$HOME/.creds/kv/OMNIROUTE_API_KEY.txt" 2>/dev/null)"
  export OMNIROUTE_API_KEY
  [ -n "$OMNIROUTE_API_KEY" ] || { echo "dc: omniroute 需要 OMNIROUTE_API_KEY，~/.creds/kv 也沒有" >&2; exit 2; }
esac

# 名字有 -free 不代表還免費（Go 的免費是限時的）。派工前查一次真實計費狀態，
# 停止免費就終止並跳警報，不讓它默默轉成付費額度。
FCK="$(dirname "$0")/freecheck"
if [ -x "$FCK" ]; then
  "$FCK" "${m#*/}" || { echo "dc: 中止——freecheck 警報（DC_FREECHECK=off 可強制）" >&2; exit 2; }
fi

# 上游停滯時 opencode 預設乾等 chunkTimeout（官方 300000ms）。沒設或設太長＝一次停滯
# 燒 5 分鐘還看不出是卡死還是在想，故派工前先唸一次合併後的 config 並出聲。
# 只 WARN 不擋：這是使用者的 config，dc 無權改。
if [ "${DC_NO_TIMEOUT_WARN:-0}" != 1 ] && command -v jq >/dev/null; then
  case "$m" in */*) prov="${m%%/*}" ;; *) prov="opencode" ;; esac
  ct="$(opencode debug config 2>/dev/null | jq -r --arg p "$prov" '.provider[$p].options.chunkTimeout // empty' 2>/dev/null)"
  case "$ct" in
    ''|*[!0-9]*) echo "dc: WARN provider.${prov} 沒設 chunkTimeout，上游停滯可能乾等很久（5 分鐘預設 v1.18.27 才有）。建議在 opencode.json 設 provider.${prov}.options.chunkTimeout: 120000" >&2 ;;
    *) [ "$ct" -gt 180000 ] && echo "dc: WARN provider.${prov}.options.chunkTimeout=${ct}ms 偏長（>180000），上游停滯會乾等這麼久" >&2 ;;
  esac
fi

# --- cwd 互斥鎖 ---------------------------------------------------------------
# 鎖在 dc 而不只在 dcq：直接呼叫 dc 會完全繞過 dcq 的鎖，兩個 agent 寫同一目錄
# 互相覆蓋（issue #1）。鎖路徑與 hash 算法與 dcq 的 .cwdlock 完全一致，所以
# dc 和 dcq 搶的是同一把——換個目錄名就等於兩把獨立的鎖，等於沒修。
# dcq 已在 claim 時持鎖，會帶 DC_LOCK_HELD=1 進來，這裡不重複拿（否則自己卡自己）。
# 用 inline 不用 function：trap 字串在 EXIT 時才展開，lockdir 若是 local 就已出
# 作用域，變成 rm -rf "" 的 no-op，鎖永遠不釋放。
LOCKROOT="${DCQ_HOME:-$HOME/.dcq}/.cwdlock"
LOCKDIR=""
release_lock() { [ -n "$LOCKDIR" ] && rm -rf "$LOCKDIR"; }
# git-bash 只有 sha1sum，macOS/Linux 只有 shasum；兩者同為 SHA-1，鎖 key 跨平台一致
_sha1() { if command -v shasum >/dev/null 2>&1; then shasum; else sha1sum; fi; }
if [ "${DC_LOCK_HELD:-0}" != 1 ]; then
  h="$(printf '%s' "$d" | _sha1 | cut -c1-12)"
  mkdir -p "$LOCKROOT" || { echo "dc: 無法建立鎖目錄 ${LOCKROOT}" >&2; exit 2; }
  L="$LOCKROOT/$h"
  waited=0; WAIT_MAX="${DC_LOCK_WAIT:-0}"
  while :; do
    if mkdir "$L" 2>/dev/null; then echo $$ > "$L/pid"; LOCKDIR="$L"; break; fi
    holder="$(cat "$L/pid" 2>/dev/null || true)"
    # ponytail: mkdir 與寫 pid 之間有窗，pid 還沒出現時再看一眼才判孤兒；
    # 要完全消掉這個窗得換 flock(1)（macOS 沒有）或 C 小工具，不值得。
    [ -z "$holder" ] && { sleep 1; holder="$(cat "$L/pid" 2>/dev/null || true)"; }
    if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
      echo "dc: 清掉孤兒鎖（持有者 pid=${holder:-?} 已不存在）：$L" >&2
      rm -rf "$L"; continue
    fi
    # 預設不等：併發撞上就讓呼叫端決定要不要排隊，乾等 30 分鐘是最糟的預設
    if [ "$waited" -ge "$WAIT_MAX" ]; then
      echo "dc: 拒絕——cwd 已被 pid ${holder} 佔用：${d}（DC_LOCK_WAIT=<秒> 可改成等待）" >&2
      exit 75
    fi
    sleep 1; waited=$((waited + 1))
  done
  trap 'release_lock; rm -f "$pintmp"' EXIT
fi
# INT/TERM 只負責退出，清理交給 EXIT trap。handler 裡不 exit 的話 bash 跑完清理會「繼續往下」，
# 拿半成品去跑 wo-verify：被殺的工單可能被判 PASS 或算成模型做錯（2026-10-03 實證）。
trap 'exit 130' INT
trap 'exit 143' TERM

[ -n "$agent" ] && set -- --agent "$agent" "$@"
[ "${DC_NO_AUTO:-0}" = 1 ] || set -- --auto "$@"

# message 放最前面：-f 是陣列旗標，會把後續位置參數一起當附件路徑吞掉。
# 輸出多留一份在暫存檔：模型可能回報工單瑕疵，那行字是唯一認得懂的線索。
# mktemp 不可帶空模板（macOS 會 mkstemp failed on : Invalid argument）。
out="$(mktemp)" || { echo "dc: mktemp 失敗" >&2; exit 2; }
# opencode 1.18.x 遇 429 只記一行 ERROR log 就在程序內重試：最多 5 次、每次照上游 retry-after 等，
# Zen 額度用完時會卡好幾分鐘，官方沒有設定可關（experimental.retry PR #44517 未合併）。不攔的話 dcq 要等 STALL_S 才換模型，期間背後還在一直重打同一份免費額度。
# 所以開 --print-logs 讓 ERROR log 進 ${out}，看到主 agent（small=false，排除取標題的小模型）
# 被限流就殺掉，以 rc=1 快速失敗。
# bash 3.2 不能 wait process substitution，所以照舊 | tee，靠 pid 檔／rc 檔拿 opencode 的 pid 與退出碼；
# wait 的是 tee，它結束時 $out 已寫完，後面 grep DC_TASK_DEFECT 不會讀到半截。
# --- 越界偵測：同 repo 其他 worktree 不得被改 ---------------------------------
# --dir 只定 opencode 的起始目錄；模型照工單裡的絕對路徑 Write、bash 帶 workdir，
# 照樣寫進主 checkout（2026-10-08 實證：worktree 派工，3 個 commit 落在 main）。
# 前後各拍一次：其他 worktree 的 HEAD＋status 摘要。正被別的 dc 持鎖的 worktree
# 本來就會變（dcq 併發派同 repo 不同 worktree），跳過不比。
# ponytail: 只看 git 追蹤得到的變化、路徑含空白會誤判；要更嚴就改 fs 快照。
_wt_snap() {
  local top w
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
  git -C "$d" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | while IFS= read -r w; do
    [ "$w" = "$top" ] && continue
    [ -d "$LOCKROOT/$(printf '%s' "$w" | _sha1 | cut -c1-12)" ] && continue
    printf '%s %s %s\n' "$w" "$(git -C "$w" rev-parse HEAD 2>/dev/null)" \
      "$(git -C "$w" status --porcelain 2>/dev/null | _sha1 | cut -c1-12)"
  done
}
# 10-23 I3a：dcq worktree 模式下，同批次的 sibling PASS 後會 merge 回主 checkout（主 checkout 的 HEAD 前進），
# 而主 checkout 是 `worktree list` 的一員、merge 時才持鎖——本張 dc 跑的幾分鐘內被判「改動了其他 worktree」，
# 10-22 批次 R7／R10／R11 因此誤判 FATAL。dcq 的 commit／merge 一律用 committer=dcq：
# HEAD 只是 fast-forward 前進、且新增的 commit 全是 dcq 提交、工作樹 status 摘要沒變 → 視為 sibling 合回，不算越界。
# 模型自己 commit（committer 不是 dcq）或動了工作樹，照舊判越界。
_wt_benign_advance() {
  local w="$1" h0="$2" h1="$3" n
  [ "$h0" != "$h1" ] && [ -n "$h0" ] && [ -n "$h1" ] || return 1
  git -C "$w" merge-base --is-ancestor "$h0" "$h1" 2>/dev/null || return 1
  n="$(git -C "$w" log --format=%cn "$h0..$h1" 2>/dev/null | grep -vc '^dcq$')"
  [ "$n" = 0 ]
}
wt_before="$(_wt_snap)"

# --- 範圍斷言（I3，10-23）：工單可選的 `writes: 路徑1, 路徑2`（行首；路徑相對 cwd 或絕對、目錄用 dir/、可用 glob）---
# 跑完後 git 看得到的改動檔（相對 ${d}）⊆ writes，否則在 log 印 `SCOPE=over`、dcq 把 SCOPE=over 記進 job 檔。
# 只標記不判 FAIL（使用者定）：驗收照跑、exit code 不變。沒寫 writes 的工單不檢查。
# ponytail: 只看 git 追蹤得到／未被 ignore 的檔、跑前就髒的檔不算；路徑含空白會誤判。
_scope_writes() { sed -n -E 's/^[Ww][Rr][Ii][Tt][Ee][Ss][[:space:]]*[:：][[:space:]]*//p' "$f" | head -1 | tr ',，' '  '; }
_scope_changed() {
  { git -C "$d" diff --name-only --relative "$scope_head" -- 2>/dev/null; git -C "$d" ls-files -o --exclude-standard 2>/dev/null; } | sort -u
}
scope_w="$(_scope_writes)"; scope_head=""; scope_pre=""
if [ -n "$scope_w" ] && scope_head="$(git -C "$d" rev-parse HEAD 2>/dev/null)"; then
  scope_pre="$(git -C "$d" status --porcelain 2>/dev/null | sed 's/^...//')"
else scope_w=""; fi

# 偵測字串首字母加 []：模型 cat 本檔時，這幾行原始碼不可比中自己（10-21 改 dc 的工單誤判濫用）。
RL_RE='small=false.*[R]ate limit exceeded'
# 額度用完另成一類（dcq 據此冷卻到重置、不記模型的帳）。opencode 對 Zen／Go 額度是直接 rc=1 結束，
# 印 Error 前綴接 [F]ree usage limit reached…／[G]o usage limit exceeded（M2 實例各 198／151 筆；
# 首字母加 [] 才不會被模型 cat 本檔時自比中）；Google 是 level=ERROR log。
QUOTA_RE='(level=ERROR.*small=false|Error: ).*([F]ree usage limit reached|[F]reeUsageLimitError|[G]o usage limit exceeded|[Y]ou exceeded your current quota|[Q]uota exceeded for metric|RESOURCE_[E]XHAUSTED)'
# 上游不可用（Model/Endpoint is unavailable、已下架）opencode 一樣在程序內重試約 67s 才 rc=1（2026-10-11 實測），提早結束讓 dcq 換模型。
# opencode 型錄沒有這隻（清冊從 Zen /models 自動加、models.dev 還沒收，10-25 jev-1.13-free 兩台 37 筆）：
# v2 印「Error: [M]odel unavailable: <id>」、1.18.x 是 [P]roviderModelNotFoundError，同屬上游不可用，不算模型的帳。
UA_RE='(small=false.*([U]pstream request failed|has been [d]eprecated)|Error: .*[M]odel unavailable: |[P]roviderModelNotFoundError)'
# opencode 開工就印「> <agent> · <model>」，在模型回應之前（上游不可用時也照印）。
# DC_START_S 秒內沒出現＝卡在送出請求前，ERROR log 也是空的（2026-10-11 實證：400s 零輸出）。
# 首輸出之後的停滯歸 dcq 的 STALL_S 管（fix 9775 §23），這裡不重複。
START_RE='> [^ ]+ · '
START_S="${DC_START_S:-60}"
pidf="$out.pid"; rcf="$out.rc"
# --title：沒給標題時 opencode 會另叫 small model（nemotron-3-ultra-free）產標題，每張工單白吃一份免費額度
# 連子程序一起殺：子程序（MCP／LSP 等）還握著 stdout 的話，tee 不會結束，wait 會卡住。
kill_oc() { local p; p=$(cat "$pidf" 2>/dev/null) || return 0; pkill -TERM -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; return 0; }
trap 'release_lock; kill_oc; rm -f "$out" "$pidf" "$rcf" "$pintmp"' EXIT
# opencode v2（2026-10）拿掉 --pure／--dir、log-level 改小寫（公開 repo 692489e）；1.18.x 照舊。
# 看 run --help 有沒有 --pure 決定（0.2s），工作目錄一律再 cd 一次，兩版都對。
# DC_OC_V2=0／1 可跳過偵測（測試的假 opencode 不認 --help）
case "${DC_OC_V2:-}" in 0) oc_v2=0 ;; 1) oc_v2=1 ;; *) if opencode run --help 2>&1 | grep -q -- '--pure'; then oc_v2=0; else oc_v2=1; fi ;; esac
# v2 的 run 預設交給共用背景服務（opencode serve --service）：服務卡死時 run 零輸出乾等（10-25 M2 服務跑 8h 後
# 每張都 60s 判不開工，--standalone 同單 10s 過），--print-logs 也只有 --standalone 才帶服務端 ERROR log（額度／限流偵測靠它）。
# OPENCODE_CONFIG_CONTENT 在 v2.1.2 --standalone 仍生效（10-25 M2 實測 instructions 有讀到）。
if [ "$oc_v2" = 0 ]; then ocflags=(--pure --log-level ERROR --dir "$d"); else ocflags=(--standalone --log-level error); fi
{ cd "$d" && sh -c 'echo $$ > "$0"; exec "$@"' "$pidf" opencode run \
  "你是執行人。任務與驗收都在附加的檔案裡，先完整讀完再動手。
驗收由外部 wo-verify 機械執行，你的自述不影響成敗判定。
驗收區塊在派工前已被複製釘住並逐行比對：改它只會判 exit 3 篡改，不可能讓你過關。
驗收區塊本身有誤（怎麼做都不可能通過）時，保留驗收原樣，輸出一行 DC_TASK_DEFECT: <驗收行號> <理由> 後立即結束。" \
  "${ocflags[@]}" --print-logs -f "$f" --title "dc: $(basename "$f")" "$@"
  echo $? > "$rcf"; } 2>&1 | tee "$out" &
teepid=$!
rl=0; started=0; ts=$(date +%s)
while kill -0 "$teepid" 2>/dev/null; do
  if grep -q -E "$QUOTA_RE" "$out" 2>/dev/null; then
    rl=5; kill_oc; break
  fi
  if grep -q -E "$RL_RE" "$out" 2>/dev/null; then
    rl=1; kill_oc; break
  fi
  if grep -q -E "$UA_RE" "$out" 2>/dev/null; then
    rl=2; kill_oc; break
  fi
  if grep -q -E "$ABUSE_RE" "$out" 2>/dev/null; then
    rl=4; kill_oc; "$ZG" trip "dc 派工 $m" >/dev/null 2>&1 \
      || { mkdir -p "$(dirname "$ZEN_GATE")"; echo $(( $(date +%s) + ZEN_GATE_S )) > "$ZEN_GATE"; }; break
  fi
  if [ "$started" = 0 ]; then
    if grep -q -E "$START_RE" "$out" 2>/dev/null; then started=1
    elif [ $(( $(date +%s) - ts )) -ge "$START_S" ]; then rl=3; kill_oc; break; fi
  fi
  sleep 1
done
wait "$teepid"
rc=$(cat "$rcf" 2>/dev/null || echo 1)
# Zen／Go 額度錯誤 opencode 自己 1 秒內就結束，輪詢迴圈常來不及看到
[ "$rl" = 0 ] && grep -q -E "$QUOTA_RE" "$out" 2>/dev/null && rl=5
# 比在所有其他判定之前：越界與成敗無關，PASS 的工單一樣可能寫壞別的 worktree。
# exit 2 讓 dcq 走 FATAL 不重試——換模型重跑只會再污染一次。
drift="$(_wt_snap | while read -r w h1 s1; do
  b="$(printf '%s\n' "$wt_before" | awk -v w="$w" '$1==w {print $2" "$3}')"
  [ -n "$b" ] || continue
  [ "$b" = "$h1 $s1" ] && continue
  h0="${b% *}"; s0="${b#* }"
  [ "$s0" = "$s1" ] && _wt_benign_advance "$w" "$h0" "$h1" && continue
  echo "$w"
done)"
if [ -n "$drift" ]; then
  echo "dc: 越界——opencode 改動了同 repo 其他 worktree（工單 cwd=${d}）：" >&2
  printf '  %s\n' $drift >&2
  echo "dc: 判 FATAL，不跑驗收；請主 session 檢查並還原上列 worktree" >&2
  exit 2
fi
if [ -n "$scope_w" ]; then
  scope_over=""
  set -f
  while IFS= read -r cf; do
    [ -n "$cf" ] || continue
    printf '%s\n' "$scope_pre" | grep -qxF -- "$cf" && continue
    ok=0
    for e in $scope_w; do
      e="${e#"$d"/}"; e="${e#./}"
      case "$cf" in $e|"${e%/}"/*) ok=1; break ;; esac
    done
    [ "$ok" = 1 ] || scope_over="$scope_over $cf"
  done <<EOF_SCOPE
$(_scope_changed)
EOF_SCOPE
  set +f
  [ -n "$scope_over" ] && echo "dc: SCOPE=over（改動超出工單 writes：${scope_w}）：${scope_over}" >&2
fi
[ "$rl" = 5 ] && { echo "dc: 上游額度用完（$(grep -m1 -oE "$QUOTA_RE" "$out" | grep -oE '(Free usage limit reached|FreeUsageLimitError|Go usage limit exceeded|You exceeded your current quota|Quota exceeded for metric[^"]*|RESOURCE_EXHAUSTED)' | head -1 | cut -c1-160)），已提早結束" >&2; grep -qE 'PerMinute|per minute' "$out" && echo "dc: 額度窗口＝每分鐘" >&2; exit 1; }
[ "$rl" = 1 ] && { echo "dc: 上游限流（429），opencode 會照 retry-after 久等重試，已提早結束" >&2; exit 1; }
[ "$rl" = 2 ] && { echo "dc: 上游不可用（$(grep -m1 -oE '(Upstream request failed[^"]*|Model [^ ]+ has been deprecated|[M]odel unavailable: [^ ]+|[P]roviderModelNotFoundError: [^.]+)' "$out")），已提早結束" >&2; exit 1; }
[ "$rl" = 4 ] && { echo "dc: Zen 免費閘道判濫用（Detect Abuse Traffic），整個 Zen 免費池停用 ${ZEN_GATE_S}s（${ZEN_GATE}），已提早結束" >&2; exit 1; }
[ "$rl" = 3 ] && { echo "dc: opencode ${START_S}s 內沒開工（無「> agent · model」行），判定卡住，已結束" >&2; exit 1; }
[ "$rc" -eq 0 ] || { echo "dc: opencode run rc=${rc}（常見：上游掛=1、逾時=124、權限拒絕）" >&2; exit "$rc"; }
# 10-21：Zen 閘的延遲倍增要靠「上游有正常回應」解封（借鏡 circuitBreaker 的半開探測）。
# 恢復判準是「請求被上游正常回應」，不是「工單通過」——驗收過不過跟 IP 有沒有被解封無關，
# 所以這裡在跑驗收之前就清掉失敗計數，驗收失敗也不影響退避歸零。
# 只認 opencode/*（Zen 池；opencode-go 是自己的額度，不共用這個閘）。
case "$m" in opencode/*)
  if ! grep -q -E "$ABUSE_RE" "$out" 2>/dev/null && [ -s "$out" ]; then
    "$ZG" ok >/dev/null 2>&1
  fi ;;
esac
# 模型回報工單瑕疵（issue #4）：不跑驗收，直接 exit 2 走既有的契約錯分支 ——
# dcq 的 exit:2 是 FATAL、不重試、不罰模型，工單的錯不會算到模型頭上。
# 錨行首：模型引用工單原文或印出程式碼時不能誤判。
# 排除「DC_TASK_DEFECT: N/A／none／無」：模型照格式回報「沒有瑕疵」不算（2026-10-18 or-free 完成後印 N/A 被判 rc=2）。
if grep '^DC_TASK_DEFECT:' "$out" | grep -qviE '^DC_TASK_DEFECT:[[:space:]]*(N/?A|none|無)([^[:alnum:]]|$)'; then
  echo "dc: 模型回報工單瑕疵（DC_TASK_DEFECT），不跑驗收" >&2
  exit 2
fi

# 完成定義在這裡，不在模型的自述。務必在 $d 底下跑 —— 驗收斷言用的是相對路徑，
# 在呼叫端的 cwd 跑會全部找不到檔案而誤判 FAIL。
# 跑 pin 那份而不是工單當下那份（篡改即 exit 3），並重跑 K 次全過才算 PASS：
# 單次通過只告訴你「至少成功過一次」，重跑才抓得到時好時壞的驗收與副作用。
K="${DC_VERIFY_K:-2}"
echo "dc: 驗收 → ${WV} --pinned (cwd=$d, K=$K)" >&2
i=1
while [ "$i" -le "$K" ]; do
  [ "$K" -gt 1 ] && echo "dc: 驗收第 ${i}/${K} 次" >&2
  ( cd "$d" && "$WV" "$f" --pinned "$pin" ) || {
    vrc=$?
    [ "$vrc" = 3 ] && echo "dc: 驗收區塊被改動（exit 3）—— 這是紅旗，不是工單瑕疵，請主 session 看 diff" >&2
    [ "$i" -gt 1 ] && echo "dc: 驗收第 ${i} 次才失敗 —— 驗收或改動不穩定（flaky），不要只憑第一次通過結案" >&2
    exit "$vrc"
  }
  i=$((i + 1))
done
exit 0
}
