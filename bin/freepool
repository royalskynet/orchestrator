#!/usr/bin/env python3
"""freepool — 免費模型雷達：直接讀各家 provider 目錄的 pricing，判定「此刻真的零價」。

取代 OmniRoute 的 or-free／free-tools 組合（本機不再依賴 OmniRoute）：免費名單不再靠
手維護的 glob 或別家路由器的組合名，而是每天讀上游目錄，用 pricing==0 現場判定。
借鏡 limin112/min-skill 的 FreeToken-Bots：免費是動態的，過期名單不得授權呼叫；
少了 `:free` 後綴會靜默打到同名付費版，所以解析一律 fail-closed。

只處理「有 pricing 目錄」的 provider（kilo、openrouter）。nvidia／groq／google／zen
沒有價格端點，計費規則留在 dc 的 tier()，這裡回 unknown 不表態。

指令：
  freepool scan [--dry-run]     讀上游目錄、寫快取、印與上次的差異（零 token，不實打模型）
  freepool status               印快取
  freepool pool                 印此刻驗證為零價＋支援 tools 的 dc_id（一行一個）
  freepool verify <dc_id>...    判定單一 dc_id：rc 0 全部零價、2 有付費（拒派）、3 有查不到
  freepool guard <models.tsv>   清冊 billing=free 的 kilo／openrouter 列是否還零價；rc=1 有漲價或下架
  freepool propose <models.tsv> 對清冊提增刪建議（只印，不改檔）
  freepool daily <models.tsv>   每日一支（oc-probe 06:00 呼叫）：scan → guard → 對清冊還沒有、也還沒探過的
                                新零價 kilo 模型 probe（每天最多 PROBE_MAX 個，結果記 FREEPOOL_PROBED 不重探）
  freepool probe <kilo/...>...  實打可用性：交給本機 OmniRoute 的 /api/models/test-all（逐個送、
                                429 連 3 次或 403 連 2 次自動停）。一次最多 PROBE_MAX 個、只收零價 id。
                                kilo 免費額度全帳號共用，禁止自己併發打（10-26 打 22 個燒光額度）。

環境：FREEPOOL_CACHE 快取路徑（預設 ~/.dcq/freepool.json）、FREEPOOL_TTL_H 新鮮度（預設 24）、
      FREEPOOL_OFFLINE=1 只用快取不連網、OMNIROUTE_URL（預設 http://127.0.0.1:20128）。
"""
import argparse
import datetime as dt
import json
import os
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

# 無 key 可讀的公開目錄。kilo 是 OpenRouter 相容格式（含 pricing／supported_parameters）。
CATALOGS = {
    "kilo": "https://api.kilo.ai/api/gateway/v1/models",
    "openrouter": "https://openrouter.ai/api/v1/models",
}
CACHE = Path(os.environ.get("FREEPOOL_CACHE") or Path.home() / ".dcq" / "freepool.json")
TTL_H = float(os.environ.get("FREEPOOL_TTL_H") or 24)
UA = {"User-Agent": "freepool/1.0 (dispatch-router)", "Accept": "application/json"}


def now():
    return dt.datetime.now(dt.timezone.utc)


def zero(v):
    """只有能解析成 0 的數字才算零價。缺欄位、'-1'（kilo auto 路由）、字串都不算。"""
    try:
        return float(v) == 0
    except (TypeError, ValueError):
        return False


def priced_free(m):
    p = m.get("pricing") or {}
    if not (zero(p.get("prompt")) and zero(p.get("completion"))):
        return False
    # request／快取價非零也會扣錢，有這些欄位就一起要求零。
    return all(zero(p[k]) for k in ("request", "input_cache_read", "input_cache_write") if k in p)


def fetch(url):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=25) as r:
        return json.load(r)


def discover():
    """回傳 {provider: {free: {id: {...}}, paid: [id], error: str|None}}。單家失敗不影響其他家。"""
    out = {}
    for prov, url in CATALOGS.items():
        try:
            data = fetch(url)
        except (urllib.error.URLError, OSError, ValueError) as e:
            out[prov] = {"free": {}, "paid": [], "error": str(e)[:200]}
            continue
        entries = data.get("data") if isinstance(data, dict) else data
        free, paid = {}, []
        for m in entries or []:
            mid = m.get("id")
            if not mid:
                continue
            if priced_free(m):
                free[mid] = {
                    "tools": "tools" in (m.get("supported_parameters") or []),
                    "context_length": m.get("context_length"),
                }
            else:
                paid.append(mid)
        out[prov] = {"free": free, "paid": sorted(paid), "error": None}
    return out


def report():
    r = discover()
    return {"checked_at": now().isoformat(), "providers": r,
            "free_count": sum(len(v["free"]) for v in r.values())}


def atomic_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix="." + path.name, dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def load(refresh=True):
    """讀快取；過期（或沒有）且允許連網才重掃。回傳 (report, state)。

    state：fresh＝這次掃的或還新鮮；stale＝連不上上游只能用舊的；none＝完全沒資料。
    連不上就用舊快取、但標 stale——判定免費時由呼叫端決定要不要信，不默默當新的用。
    """
    rep = None
    if CACHE.exists():
        try:
            rep = json.loads(CACHE.read_text())
            age = now() - dt.datetime.fromisoformat(rep["checked_at"])
            fresh = age <= dt.timedelta(hours=TTL_H) and "providers" in rep
        except (ValueError, KeyError, OSError):
            rep, fresh = None, False
    else:
        fresh = False
    if fresh:
        return rep, "fresh"
    if refresh and os.environ.get("FREEPOOL_OFFLINE") != "1":
        fresh_rep = report()
        if any(v["error"] is None for v in fresh_rep["providers"].values()):
            atomic_json(CACHE, fresh_rep)
            return fresh_rep, "fresh"
    return (rep, "stale") if rep else (None, "none")


def split_id(dc_id):
    """dc_id → (provider, 上游 model id)。kilo/cohere/x:free → ('kilo', 'cohere/x:free')。"""
    prov, _, rest = dc_id.partition("/")
    return prov, rest


def judge(dc_id, rep):
    """fail-closed 判定。回傳 (verdict, resolved_id, note)。

    verdict：free＝目錄現價零；paid＝目錄裡有、但不是零價（拒派）；unknown＝這家沒有價格目錄或查不到。
    少 `:free` 後綴而加上後綴就是零價 → 回 free 但換成後綴版並大聲警告：
    照原名打會打到同名付費版（FreeToken-Bots 實測踩過一次）。
    """
    prov, mid = split_id(dc_id)
    if prov not in CATALOGS or not rep:
        return "unknown", dc_id, "無價格目錄" if prov not in CATALOGS else "無快取"
    p = rep["providers"].get(prov) or {}
    free, paid = p.get("free") or {}, set(p.get("paid") or [])
    if mid in free:
        return "free", dc_id, ""
    suffixed = mid if mid.endswith(":free") else mid + ":free"
    if suffixed in free:
        return "free", f"{prov}/{suffixed}", f"缺 :free 後綴；照原名打會走付費版"
    if mid in paid:
        return "paid", dc_id, "上游目錄現價非零"
    return "unknown", dc_id, "上游目錄查無此 id"


def catalog_free_rows(path):
    """清冊裡 billing=free 且 dc_id 屬於有價格目錄的列：[(dc_id, model, fit)]。"""
    rows = []
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        f = (line.split("\t") + [""] * 8)[:8]
        if f[0] == "free" and f[6] and split_id(f[6])[0] in CATALOGS:
            rows.append((f[6], f[2], f[7]))
    return rows


def cmd_scan(a):
    old = None
    if CACHE.exists():
        try:
            old = json.loads(CACHE.read_text())
        except (ValueError, OSError):
            old = None
    rep = report()
    errs = {p: v["error"] for p, v in rep["providers"].items() if v["error"]}
    if len(errs) == len(CATALOGS):
        for p, e in errs.items():
            print(f"freepool: {p} 目錄讀不到：{e}", file=sys.stderr)
        return 1
    if not a.dry_run:
        atomic_json(CACHE, rep)
    for p, v in rep["providers"].items():
        if v["error"]:
            print(f"freepool: WARN {p} 讀不到（保留上次結果判定）：{v['error']}", file=sys.stderr)
            if old and not a.dry_run:  # 單家失敗不要把舊名單洗掉
                rep["providers"][p] = old.get("providers", {}).get(p, v)
        tools = sum(1 for m in v["free"].values() if m["tools"])
        print(f"{p}: 零價 {len(v['free'])}（支援 tools {tools}）")
    if old:
        for p in rep["providers"]:
            o = set((old.get("providers", {}).get(p) or {}).get("free") or {})
            n = set(rep["providers"][p]["free"])
            paid_now = set(rep["providers"][p]["paid"] or [])
            for mid in sorted(n - o):
                print(f"新增零價 {p}/{mid}")
            for mid in sorted(o - n):
                print(f"{'漲價' if mid in paid_now else '下架'} {p}/{mid}")
    if not a.dry_run:
        atomic_json(CACHE, rep)
    return 0


def cmd_status(a):
    print(CACHE.read_text() if CACHE.exists() else '{"message":"先跑 freepool scan"}', end="")
    return 0


def cmd_pool(a):
    rep, state = load()
    if not rep:
        print("freepool: 沒有快取也連不上上游，不列任何模型", file=sys.stderr)
        return 1
    if state == "stale":
        print(f"freepool: WARN 快取 {rep['checked_at']} 已過 {TTL_H}h 且連不上上游", file=sys.stderr)
    for prov, v in rep["providers"].items():
        for mid, m in sorted(v["free"].items()):
            if m["tools"] or not a.tools:
                print(f"{prov}/{mid}\t{m['context_length'] or ''}")
    return 0


def cmd_verify(a):
    rep, state = load()
    rc = 0
    for dc_id in a.dc_id:
        verdict, resolved, note = judge(dc_id, rep)
        if verdict == "free" and state == "stale":
            note = (note + "；" if note else "") + "快取已過期，零價判定僅供參考"
        print(f"{dc_id}\t{verdict}\t{resolved}\t{note}")
        if verdict == "paid":
            print(f"freepool: 拒派 {dc_id}——上游目錄現價非零，照派會扣錢", file=sys.stderr)
            rc = 2
        elif verdict == "free" and resolved != dc_id:
            print(f"freepool: WARN {dc_id} 不是零價 id，零價的是 {resolved}；照原名打會走付費版", file=sys.stderr)
        elif verdict == "unknown" and rc == 0:
            rc = 3
    return rc


def cmd_guard(a):
    rep, state = load()
    if not rep:
        print("freepool: 沒有快取也連不上上游，無法驗證清冊", file=sys.stderr)
        return 2
    bad = []
    for dc_id, _model, _fit in catalog_free_rows(a.tsv):
        verdict, resolved, note = judge(dc_id, rep)
        if verdict != "free" or resolved != dc_id:
            bad.append((dc_id, verdict, resolved, note))
    for dc_id, verdict, resolved, note in bad:
        print(f"{dc_id}\t{verdict}\t{resolved}\t{note}")
    if bad:
        print(f"freepool: 清冊有 {len(bad)} 列 billing=free 已不是零價或 id 不對，先改清冊", file=sys.stderr)
        return 1
    print(f"freepool: 清冊 kilo／openrouter 免費列全部仍零價（{state}，{rep['checked_at']}）")
    return 0


def cmd_propose(a):
    rep, state = load()
    if not rep:
        print("freepool: 沒有快取也連不上上游", file=sys.stderr)
        return 2
    have = {dc_id for dc_id, _m, _f in catalog_free_rows(a.tsv)}
    verified = {f"{prov}/{mid}": m for prov, v in rep["providers"].items()
                for mid, m in v["free"].items() if m["tools"]}
    for dc_id in sorted(set(verified) - have):
        print(f"ADD\t{dc_id}\tctx={verified[dc_id]['context_length'] or '?'}")
    for dc_id in sorted(have):
        verdict, resolved, note = judge(dc_id, rep)
        if verdict != "free":
            print(f"RM\t{dc_id}\t{verdict}：{note}")
        elif resolved != dc_id:
            print(f"FIX\t{dc_id}\t→ {resolved}（{note}）")
    print("freepool: 以上只是建議，沒有改清冊（改了要先實打驗證可用性）", file=sys.stderr)
    return 0


OMNIROUTE = os.environ.get("OMNIROUTE_URL") or "http://127.0.0.1:20128"
# ponytail: 每次最多 5 個是拍的保守值；要更多就分批跑、隔天再測，別調大。
PROBE_MAX = 5
# OmniRoute 的 kilo 匿名連線（apiKey=anonymous）。OmniRoute 同 provider＋同 key 只留一條，
# 所以跟 Coco 用的 kilo-free combo 共用；名稱是新建時才用。probe 結束只把「原本停用」的關回去，
# 原本啟用（combo 在用）就不動，免得把 Coco 的免費鏈路關掉。
PROBE_CONN = "Kilo anonymous (combo)"
# 探過的記錄（dc_id → {at, status}）：daily 不重探。要重探某隻就把它從檔裡刪掉。
PROBED = Path(os.environ.get("FREEPOOL_PROBED") or Path.home() / ".dcq" / "freepool-probed.json")


def om_call(method, path, body=None, token=None, timeout=30):
    h = {"Content-Type": "application/json"}
    if token:
        h["Authorization"] = "Bearer " + token
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(OMNIROUTE + path, data, h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        return e.code, {"error": e.read().decode(errors="replace")[:200]}


def om_password():
    v = os.environ.get("OMNIROUTE_ADMIN_PASSWORD")
    if v:
        return v
    f = Path.home() / ".creds" / "omniroute" / ".env"
    if f.exists():
        for line in f.read_text().splitlines():
            if line.startswith("OMNIROUTE_ADMIN_PASSWORD="):
                return line.split("=", 1)[1].strip()
    return None


def cmd_probe(a):
    if len(a.dc_id) > PROBE_MAX:
        print(f"freepool: 一次最多探 {PROBE_MAX} 個（給了 {len(a.dc_id)}）；kilo 額度全帳號共用，分批隔天再測", file=sys.stderr)
        return 2
    rep, _state = load()
    ids = []
    for dc_id in a.dc_id:
        prov, mid = split_id(dc_id)
        verdict, resolved, note = judge(dc_id, rep)
        if prov != "kilo":
            print(f"freepool: 拒探 {dc_id}——只探 kilo（openrouter 免費模型被帳號 guardrail 擋，其他家用 dcq 真實派工驗）", file=sys.stderr)
            return 2
        if verdict != "free" or resolved != dc_id:
            print(f"freepool: 拒探 {dc_id}——{verdict}{'：' + note if note else ''}（只探目錄現價零的 id）", file=sys.stderr)
            return 2
        ids.append(mid)
    # 上游 id 本身帶 nvidia/、openrouter/ 等前綴，OmniRoute 會當成自己的 provider 解析；一律加 kilo-gateway 別名 kg/。
    sent = {f"kg/{mid}": mid for mid in ids}
    pw = om_password()
    if not pw:
        print("freepool: 取不到 OMNIROUTE_ADMIN_PASSWORD（~/.creds/omniroute/.env）", file=sys.stderr)
        return 3
    try:
        s, j = om_call("POST", "/api/cli/connect",
                       {"password": pw, "name": "freepool-probe", "scope": "admin", "expiresInDays": 1})
        if s != 200:
            print(f"freepool: OmniRoute 登入失敗（HTTP {s}）", file=sys.stderr)
            return 3
        tok = j["token"]
        s, j = om_call("GET", "/api/providers", token=tok)
        c = next((c for c in (j.get("connections") or []) if c.get("provider") == "kilo-gateway"), None)
        conn, was_active = (c["id"], bool(c.get("isActive"))) if c else (None, False)
        if not conn:  # 新建的連線預設停用
            s, j = om_call("POST", "/api/providers", {"provider": "kilo-gateway", "apiKey": "anonymous",
                                                      "name": PROBE_CONN, "providerSpecificData": {}}, tok)
            if s not in (200, 201):
                print(f"freepool: 建 OmniRoute kilo 探測連線失敗（HTTP {s}）：{j}", file=sys.stderr)
                return 3
            conn = j["connection"]["id"]
        if not was_active:
            om_call("PATCH", "/api/providers", {"ids": [conn], "isActive": True}, tok)
        try:
            s, j = om_call("POST", "/api/models/test-all",
                           {"providerId": "kilo-gateway", "modelIds": list(sent), "connectionId": conn}, tok,
                           timeout=120 * len(ids) + 30)
        finally:
            s_off = om_call("PATCH", "/api/providers", {"ids": [conn], "isActive": False}, tok)[0] if not was_active else 200
            if s_off != 200:
                print(f"freepool: WARN 探測連線沒關成（HTTP {s_off}），OmniRoute 健檢會定時打它，手動停用 {conn}", file=sys.stderr)
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        print(f"freepool: OmniRoute 不可用（{OMNIROUTE}）：{e}", file=sys.stderr)
        return 3
    if s != 200:
        print(f"freepool: test-all 失敗（HTTP {s}）：{j}", file=sys.stderr)
        return 3
    rc = 0
    res = j.get("results") or {}
    for key, mid in sent.items():
        r = res.get(key) or res.get(mid) or {"status": "error", "error": "未測（OmniRoute 提前停止）"}
        ok = r.get("status") in ("ok", "slow")
        rc = rc if ok else 1
        if res.get(key) or res.get(mid):
            getattr(a, "results", {})[f"kilo/{mid}"] = r.get("status")
        print(f"kilo/{mid}\t{r.get('status')}\t{r.get('latencyMs', '')}\t{r.get('statusCode') or ''} {r.get('error') or ''}".rstrip())
    if j.get("stoppedEarly"):
        print(f"freepool: OmniRoute 提前停止（{j.get('stopReason')}）——上游在限流或擋人，別重試，隔天再測", file=sys.stderr)
    return rc


def cmd_daily(a):
    if os.environ.get("FREEPOOL_OFFLINE") != "1" and cmd_scan(argparse.Namespace(dry_run=False)) != 0:
        return 2
    grc = cmd_guard(a)
    rep, _state = load(refresh=False)
    have = {dc_id for dc_id, _m, _f in catalog_free_rows(a.tsv)}
    try:
        probed = json.loads(PROBED.read_text()) if PROBED.exists() else {}
    except (ValueError, OSError):
        probed = {}
    kilo = (rep or {}).get("providers", {}).get("kilo") or {}
    todo = sorted(f"kilo/{mid}" for mid, m in (kilo.get("free") or {}).items() if m["tools"]
                  and f"kilo/{mid}" not in have and f"kilo/{mid}" not in probed)[:PROBE_MAX]
    if not todo:
        print("freepool: 沒有新的零價 kilo 模型要探")
        return grc
    pa = argparse.Namespace(dc_id=todo, results={})
    prc = cmd_probe(pa)
    if prc == 3:
        print("freepool: OmniRoute 不可用，新模型明天再探", file=sys.stderr)
        return grc
    at = now().isoformat()
    probed.update({k: {"at": at, "status": v} for k, v in pa.results.items()})
    atomic_json(PROBED, probed)
    for k, v in pa.results.items():
        if v in ("ok", "slow"):
            print(f"可加入清冊\t{k}")
    return grc


def main(argv=None):
    p = argparse.ArgumentParser(prog="freepool", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan"); s.add_argument("--dry-run", action="store_true"); s.set_defaults(fn=cmd_scan)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    s = sub.add_parser("pool"); s.add_argument("--all", dest="tools", action="store_false",
                                               help="連不支援 tools 的也列"); s.set_defaults(fn=cmd_pool, tools=True)
    s = sub.add_parser("verify"); s.add_argument("dc_id", nargs="+"); s.set_defaults(fn=cmd_verify)
    s = sub.add_parser("guard"); s.add_argument("tsv"); s.set_defaults(fn=cmd_guard)
    s = sub.add_parser("propose"); s.add_argument("tsv"); s.set_defaults(fn=cmd_propose)
    s = sub.add_parser("probe"); s.add_argument("dc_id", nargs="+"); s.set_defaults(fn=cmd_probe)
    s = sub.add_parser("daily"); s.add_argument("tsv"); s.set_defaults(fn=cmd_daily)
    a = p.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
