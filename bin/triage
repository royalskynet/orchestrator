#!/usr/bin/env bash
# triage — 判工單難度，印 easy／mid／hard。dcq add 入列時呼叫一次，同一張工單中途不換。
# 不自造：直接用 jev-gate 的 triage()，JEV_PROVIDER=laya 只走本機 ONNX，零 token、約 2～3 秒。
# fail-open：jev-gate 不在、node 失敗、逾時、Laya 沒把握（tier=null）一律印 mid，不擋入列。
set -u
task="${1:-}"
[ -n "$task" ] || { echo "用法：triage <task.md>" >&2; exit 2; }
case "$task" in /*) ;; *) task="$PWD/$task" ;; esac  # 下面會 cd 進 jev-gate 目錄，相對路徑會讀不到（11-07）
J="${JEV_GATE_DIR:-$HOME/dev/jev-gate-mcp}"
if [ ! -f "$J/agent-glue/src/triage.js" ] || [ ! -r "$task" ]; then echo mid; exit 0; fi
to=""; command -v timeout >/dev/null && to="timeout ${TRIAGE_TIMEOUT_S:-20}"
t=$(cd "$J" && JEV_PROVIDER=laya $to node --input-type=module -e '
import { readFileSync } from "node:fs";
const { liveTransport } = await import("./agent-glue/src/live.js");
const { triage } = await import("./agent-glue/src/triage.js");
const d = await triage({ text: readFileSync(process.argv[1], "utf8"), contextChars: 0, skills: [] },
  { transport: await liveTransport({ triage: true }) });
process.stdout.write(String(d.tier ?? ""));' "$task" 2>/dev/null)
case "$t" in cheap) echo easy ;; hard) echo hard ;; *) echo mid ;; esac
